# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Anexa local artifacts
/storage
/test-results
/playwright-report
# EVERY alternate NEXT_DIST_DIR, not just the e2e one. Tailwind v4's automatic
# content detection skips gitignored paths — so a build directory that is NOT
# ignored gets scanned as source, class names are extracted from compiled JS,
# and the resulting garbage utility (`.bg-[var(-<binary>)]`) fails to parse.
# The symptom is a 500 on every page with "Parsing CSS source code failed",
# including in an unrelated dev server that happens to be running. Building
# into a scratch dist dir must never be able to do that again.
/.next-*

# Database dumps pulled from live. These are a complete copy of production —
# every customer record and every uploaded document — so they must never be
# committed, however convenient it looks.
/.backups

.superpowers/

# The env TEMPLATE is placeholders only and must be committed: cron.ts refers
# operators to it, and `.env*` above had been quietly making that impossible.
!.env.example
