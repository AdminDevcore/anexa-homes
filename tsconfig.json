{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-verify-e2e/types/**/*.ts",
    ".next-verify-e2e/dev/types/**/*.ts",
    ".next/verify-e2e/types/**/*.ts",
    ".next/verify-e2e/dev/types/**/*.ts",
    ".next/verify-wc/types/**/*.ts",
    ".next/verify-wc/dev/types/**/*.ts",
    ".next-e2e-stage/types/**/*.ts",
    ".next-e2e-stage/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-e2e-3017/types/**/*.ts",
    ".next-e2e-3017/dev/types/**/*.ts",
    ".next-e2e-3007/types/**/*.ts",
    ".next-e2e-3007/dev/types/**/*.ts",
    ".next-e2e-3011/types/**/*.ts",
    ".next-e2e-3011/dev/types/**/*.ts",
    ".next-e2e-3021/types/**/*.ts",
    ".next-e2e-3021/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
