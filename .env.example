# Anexa Homes — environment template
#
# Copy to `.env` and fill in. PLACEHOLDERS ONLY: never commit a real secret to
# this file. Anything marked REQUIRED has no safe default and the feature that
# needs it refuses to run without it, rather than running in a degraded state
# nobody notices.
#
# This file was missing until the bookkeeping build; `src/server/auth/cron.ts`
# already referred operators to it.

# ── Core ────────────────────────────────────────────────────────────────────
# REQUIRED. Postgres connection string.
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/anexa?schema=public"

# REQUIRED in production. Signs sessions.
AUTH_SECRET=""
# Set to "true" behind a proxy that terminates TLS (Vercel does).
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local convenience only. MUST be unset in production — it bypasses login.
DEV_AUTH_BYPASS=""
NEXT_PUBLIC_DEMO_MODE=""

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# REQUIRED for any cron to run. Unset means every scheduled endpoint returns
# 503 — a misconfigured server refuses rather than opens. Vercel Cron sends this
# as `Authorization: Bearer <CRON_SECRET>` for every entry in vercel.json.
CRON_SECRET=""

# ── Encryption ──────────────────────────────────────────────────────────────
# Field-level encryption keys, 32 bytes, base64 or hex.
#
# FINANCE_ENC_KEY is preferred for all NEW writes and is what bank credentials
# are sealed with. Keys are versioned (`v1.<keyId>:iv:tag:ct`) and legacy blobs
# are tried against every configured key, so adding one never orphans data
# sealed under another. Rotate by adding a new key, not by replacing this one.
FINANCE_ENC_KEY=""
ONBOARDING_ENC_KEY=""

# ── Bank feeds ──────────────────────────────────────────────────────────────
# "fixture" (default) or "plaid". The fixture is a real implementation backed by
# seeded data: it pages with a cursor, reports modifications, and carries money
# in both directions. Every test runs against it and no test reaches the network.
BANK_FEED_PROVIDER="fixture"

# REQUIRED when BANK_FEED_PROVIDER=plaid. The provider throws on construction
# without them rather than falling back to a provider nobody chose.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# "sandbox" or "production". Anything else falls back to sandbox.
PLAID_ENV="sandbox"
# Public HTTPS URL Plaid posts to. Must be reachable from the internet, so a
# tunnel is needed for local testing. Leave blank to disable webhooks entirely
# (the cron sweep still syncs).
PLAID_WEBHOOK_URL=""

# ── Lender callbacks ────────────────────────────────────────────────────────
# See docs/runbooks/amos-inbound-callbacks.md. Note the receiver is due to move
# from a bearer token to an HMAC signature over the raw body.
LENDER_WEBHOOK_SECRET=""

# ── Third-party services ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_MAPS_API_KEY=""

# Provider selectors. Unset means the feature is off, not that it silently
# guesses.
PROPERTY_VALUE_PROVIDER=""
SKIP_TRACE_PROVIDER=""

# ── Storage ─────────────────────────────────────────────────────────────────
# "db" or "local".
STORAGE_DRIVER="db"
STORAGE_LOCAL_DIR=".storage"

# ── Feature flags ───────────────────────────────────────────────────────────
SOLAR_VERTICAL_ENABLED="1"
