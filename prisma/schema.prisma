model CompanySettings {
  id                         String   @id @default(uuid())
  companyId                  String   @unique
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logoUrl                    String?
  primaryColor               String   @default("#0B0B0C")
  accentColor                String   @default("#BFA15F")
  faviconUrl                 String?
  fontFamily                 String?
  recordPrefix               String   @default("")
  supportPhone               String?
  supportEmail               String?
  currencyCode               String   @default("USD")
  locale                     String   @default("en-US")
  businessHours              Json     @default("{}")
  emailFromName              String?
  customDomain               String?  @unique
  removePoweredBy            Boolean  @default(false)
  requiredDocuments          Json     @default("[]")
  emailTemplates             Json     @default("{}")
  smsTemplates               Json     @default("{}")
  rolePermissions            Json     @default("{}") // per-role overrides on top of code matrix
  // Customizable appointment outcomes ("dispositions") — JSON array of labels.
  // Empty/unset falls back to DEFAULT_APPOINTMENT_DISPOSITIONS in code.
  appointmentDispositions    Json     @default("[]")
  // Customizable inspection outcomes — JSON array of labels. Empty falls back to
  // DEFAULT_INSPECTION_OUTCOMES in code.
  inspectionOutcomes         Json     @default("[]")
  // Default production QC checklist applied to new jobs — JSON array of labels.
  // Empty falls back to DEFAULT_QC in code.
  qcChecklistTemplate        Json     @default("[]")
  // Customizable insurance claim statuses — JSON array of { key, label }. Empty
  // falls back to DEFAULT_CLAIM_STATUSES in code. The key is frozen on create so
  // renaming a status never breaks the code that keys off it (scope gating).
  claimStatuses              Json     @default("[]")
  // Bookkeeping integration (bank / QuickBooks). Key stored for the connector.
  bookkeepingProvider        String? // "quickbooks" | "plaid" | "manual"
  bookkeepingApiKey          String?
  // Weekly open-task reminder digest (cron). On by default; toggled in Settings.
  weeklyTaskRemindersEnabled Boolean  @default(true)
  // Weekly "overdue jobs" digest to managers/admins (cron). On by default; toggled in Settings.
  overdueDigestEnabled       Boolean  @default(true)
  // Email each signer a copy of the executed PDF when a document is fully signed.
  // On by default; toggled in Settings → Notification Rules.
  emailSignedCopyToSigners   Boolean  @default(true)
  // Storm Intelligence search area. Null = default (Dallas @ 100mi in code). The
  // daily SPC import + storm map/checker all key off this center + radius.
  stormCenterLat             Float?
  stormCenterLng             Float?
  stormRadiusMiles           Int?
  // ── Isolation boundary levers (stubs; both default to shared) ─────────────
  // Anexa is one legal entity: one employee roster, one general ledger. Books
  // and team are therefore SHARED but SEGMENTED — every transaction, commission
  // and job carries its vertical so the P&L breaks out by department and still
  // reconciles to the company total.
  //
  // These two switches are the documented extension point for splitting them
  // fully later (separate ledgers / separate rosters per vertical). Turning
  // either on means promoting the TAGGED models in src/server/vertical/models.ts
  // to SCOPED; nothing reads them yet, by design.
  isolateBooks               Boolean  @default(false)
  isolateTeam                Boolean  @default(false)
  // Per-vertical overrides for the SCALAR settings above, keyed by vertical:
  //   { "solar": { "logoUrl": "...", "primaryColor": "#...", "recordPrefix": "PS-" } }
  //
  // The columns above stay the company/Roofing values. A vertical with no entry
  // here inherits them, which is what lets Solar branding start empty and fall
  // back rather than render blank — and is why Roofing is untouched: with no
  // "roofing" key, every read returns the same column it always did.
  //
  // JSON settings (emailTemplates, requiredDocuments, …) are NOT here; they
  // carry their own per-vertical keys via lib/vertical-config.
  verticalOverrides          Json     @default("{}")
  updatedAt                  DateTime @updatedAt

  @@map("company_settings")
}

model User {
  id                          String               @id @default(uuid())
  companyId                   String
  company                     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email                       String
  passwordHash                String?
  firstName                   String
  lastName                    String
  phone                       String?
  role                        Role                 @default(sales_rep)
  status                      UserStatus           @default(active)
  avatarUrl                   String?
  title                       String?
  /// The name a sales manager's team goes by ("Team Alpha", "Team Kings").
  ///
  /// Only a MANAGER carries one, and `setTeamNameAction` enforces it. A team is
  /// already a manager plus the reps who report to them (User.managerId) and the
  /// canvassers under those reps, so the name lives on the person the team hangs
  /// off rather than in a table of its own — there is nothing a Team row would
  /// hold that this column doesn't. Cleared when somebody is moved out of the
  /// manager role, so a stale name can never label a team with nobody in it.
  ///
  /// Nullable and unconstrained: every existing manager starts without one, and
  /// a team with no name still reads as "<Manager>'s team" everywhere it is
  /// shown — see `teamNameOf`.
  teamName                    String?
  // Sequential employee number per company (join order). Formatted on display as
  // <recordPrefix><5-digit>, e.g. AH-00001. Lower = earlier hire = higher rank.
  employeeNo                  Int?
  // Rep's share (%) of the profit pool on a SELF-GENERATED lead (standard split).
  commissionSplitPct          Float?
  // Company-provided-lead comp is EITHER a percentage of the pool OR a flat lead
  // fee deducted from the rep's self-gen commission. providedLeadType picks which.
  providedLeadType            String               @default("percentage") // "percentage" | "flat"
  // Rep's share (%) when the COMPANY provided the lead (percentage mode).
  providedLeadSplitPct        Float?
  // Flat lead/marketing fee (cents) subtracted from the rep's self-gen commission (flat mode).
  providedLeadFlatCents       Int?
  // Rep's share (%) of the customer-paid deductible on their deals (separate from
  // the profit-pool split). null/0 = this rep doesn't get the deductible.
  deductiblePct               Float?
  // -- Solar pay -----------------------------------------------------------
  // Solar does not pay out of a profit pool, so none of the columns above apply
  // to it. A solar deal pays one of two ways -- see SolarRepPayMode and
  // src/lib/solar-pay.ts -- and these are this rep's terms for each.
  //
  // The rep's redline: what the company must keep per installed watt, NET of
  // the lender's dealer fee, in cents (200 = $2.00/W). Everything the deal nets
  // above this is the rep's, in full.
  //
  // Net rather than gross on purpose: moving a deal onto expensive money has to
  // come out of the rep, not the company. Null = this rep has no redline, and
  // redline deals pay them nothing -- the team page says so out loud rather than
  // quietly generating a $0 line nobody looks at until payroll.
  solarRedlineCentsPerWatt    Int?
  // The same idea on a deal with no watts: cents of BASE price per battery the
  // rep keeps above, on a storage-only job.
  //
  // A REP figure, deliberately distinct from SolarLender.minBasePricePerBattery
  // -- that is the company's margin floor and guards PRICING. Paying a rep
  // everything above the company's own floor would leave the company holding
  // exactly its minimum on every storage deal. Null = no line is written at
  // all, exactly as a null redline above means.
  solarRedlinePerBatteryCents Int?
  // The flat amount, in cents, this rep earns per installed battery on a
  // storage-only job through a lender set to flat battery pay. The per-battery
  // twin of solarPerWattMills below, and in CENTS rather than mills because a
  // battery is a $1,500 unit, not a $0.405 one -- nobody needs a tenth of a
  // cent of it. Null = no line is written at all, as everywhere else here.
  solarPerBatteryFlatCents    Int?
  // Fixed rate per installed watt on a lender set to per_watt pay, and on every
  // lease/PPA (which have no system price to redline against). In MILLS --
  // tenths of a cent, 400 = $0.40/W -- because $0.405/W is a real rate and cents
  // cannot express it. Matches SolarDealAdder.millsPerWatt.
  solarPerWattMills           Int?
  /// The COMPANY's percentage of this rep's solar commission when the COMPANY
  /// provided the lead. THE OPPOSITE CONVENTION to `providedLeadSplitPct` above,
  /// which names the rep's share of a roofing pool — this one names what the
  /// company keeps. 25 here means the rep is paid 75% of what their basis earned.
  ///
  /// Null = no take, which is what every solar deal did before this column
  /// existed, so an unconfigured company keeps paying exactly what it paid.
  /// Whether a given deal counts as company-provided is finalised at M1 and
  /// recorded on SolarDealComp, not here.
  solarCompanyLeadTakePct     Float?
  /// WHICH company-provided-lead adjustment this rep is on. Explicit rather
  /// than inferred from which amount happens to be non-null: "nothing
  /// configured" and "a take of zero" are different answers and a nullable pair
  /// cannot tell them apart. Exactly one method — never both.
  solarLeadAdjustMode         SolarLeadAdjustMode  @default(none)
  /// The COMPANY's flat deduction from this rep's solar commission on a
  /// company-provided lead, cents. Read only when solarLeadAdjustMode = flat.
  solarCompanyLeadFlatCents   Int?
  /// How this rep is paid on a BATTERY-ONLY job. Null = not configured, which
  /// writes no line rather than a misleading zero. The lender's own
  /// `batteryPayMode` prices the deal; it does not decide anybody's pay.
  solarBatteryPayPlan         SolarBatteryPayPlan?
  // Verticals this user may open and switch between. New users start in Roofing
  // only; the super admin grants Solar explicitly. Retired values on existing
  // rows are filtered out by allowedVerticals() and can never surface.
  verticals                   Vertical[]           @default([roofing]) @map("industries")
  // For canvassers: the sales rep they're assigned to. Their knocks, leads, and
  // appointments auto-assign to (and are visible by) this rep.
  salesRepId                  String?
  salesRep                    User?                @relation("RepCanvassers", fields: [salesRepId], references: [id], onDelete: SetNull)
  canvassers                  User[]               @relation("RepCanvassers")
  // For sales reps: the sales manager they report to. The manager sees this rep's
  // deals, canvassing, tasks, and commissions — and nothing outside their team.
  managerId                   String?
  manager                     User?                @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports                     User[]               @relation("ManagerReports")
  permissions                 Json                 @default("{}") // per-user permission overrides
  sessionVersion              Int                  @default(1)
  lastLoginAt                 DateTime?
  // Soft delete: set (with status=disabled) to remove from the roster while
  // keeping the row so historical deals keep showing the rep's name.
  deletedAt                   DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  leadsAssigned   Lead[]               @relation("LeadAssignedRep")
  leadsSet        Lead[]               @relation("LeadSetter")
  leadsCreated    Lead[]               @relation("LeadCreatedBy")
  customerLeads   Lead[]               @relation("LeadCustomerUser")
  projectsManaged Project[]            @relation("ProjectManager")
  tasksAssigned   Task[]               @relation("TaskAssignee")
  tasksCreated    Task[]               @relation("TaskCreatedBy")
  notes           Note[]
  filesUploaded   FileAsset[]
  dailyReports    DailyReport[]
  commissions     Commission[]         @relation("CommissionUser")
  contractorPays  ContractorPay[]      @relation("ContractorPayContractor")
  overridesEarned CommissionOverride[] @relation("OverrideBeneficiary")
  overridesOnMe   CommissionOverride[] @relation("OverrideSource")
  payrollItems    PayrollItem[]
  activityLogs    ActivityLog[]
  stageMoves      LeadStageEvent[]     @relation("LeadStageEventMovedBy")
  appointmentMoves LeadAppointmentReschedule[] @relation("LeadAppointmentRescheduleMovedBy")
  crewMemberships CrewMember[]
  invitationsSent Invitation[]         @relation("InviteInviter")
  passwordResets  PasswordResetToken[]
  notifications   Notification[]

  conversationsCreated    Conversation[]       @relation("ConversationCreator")
  conversationMembers     ConversationMember[] @relation("ConvMemberUser")
  messagesSent            Message[]            @relation("MessageSender")
  knocks                  Knock[]              @relation("KnockRep")
  territoriesAssigned     Territory[]          @relation("TerritoryRep")
  territoriesCreated      Territory[]          @relation("TerritoryCreator")
  onboarding              UserOnboarding?
  proposalsCreated        Proposal[]           @relation("ProposalCreatedBy")
  feedPosts               DealFeedPost[]       @relation("FeedAuthor")
  projectAssignments      ProjectAssignee[]    @relation("ProjectAssignee")
  solarDealComps          SolarDealComp[]      @relation("SolarDealCompRep")
  solarDealCompsTakenFrom SolarDealComp[]      @relation("SolarDealCompReassignedFrom")
  chargebacks             Chargeback[]         @relation("ChargebackUser")
  payrollAdjustments      PayrollAdjustment[]  @relation("PayrollAdjustmentUser")
  pipelineFilterViews     PipelineFilterView[] @relation("PipelineFilterViewCreator")

  @@unique([companyId, email])
  @@unique([companyId, employeeNo])
  @@index([companyId, role, status])
  @@index([companyId, salesRepId])
  @@index([companyId, managerId])
  @@map("users")
}

model Invitation {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String?
  invitedBy   User?     @relation("InviteInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// CRM: leads, pipeline, projects
// ---------------------------------------------------------------------------

enum SolarProviderKind {
  utility
  retail
}

/// The utilities and retail electric providers a company sells against.
///
/// Same shape as LeadSource: a per-company ordered list, deactivated rather
/// than deleted, because a design stores the provider's NAME and has to keep
/// rendering after that provider stops being offered.
model SolarProvider {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical          @default(solar)
  kind      SolarProviderKind
  name      String
  position  Int               @default(0)
  active    Boolean           @default(true)

  // ── What this provider does for a solar customer ─────────────────────────
  //
  // Recorded per provider because it is a fact about the PROVIDER, not about
  // any one deal, and because it is the question a rep gets asked at the
  // kitchen table and cannot answer from the CRM: "do they pay me for what I
  // send back, and is there anything for the battery?"
  //
  // Every field is optional and nothing here reaches the customer's proposal
  // or its arithmetic. It is what the office knows, shown to the rep beside
  // the provider they just picked.

  /// Does this provider buy back exported power at all?
  buyback          Boolean @default(false)
  /// What they pay for an exported kWh, in mills. 95 = $0.095/kWh. Null when
  /// they buy back but the rate varies, or nobody has recorded it — which is
  /// why the flag is separate from the figure rather than derived from it.
  buybackRateMills Int?

  /// Time-of-use rates, mills per kWh, and the window in words for the
  /// document ("4pm – 8pm"). The window is NOT parsed — it is a sentence on a
  /// customer's proposal, not a schedule anything computes against.
  ///
  /// Null means this provider has no TOU plan on file, and the storage proposal
  /// OMITS the savings line rather than deriving one from the blended rate.
  /// Both or neither.
  touPeakRateMills    Int?
  touOffPeakRateMills Int?
  touPeakWindow       String?

  /// Does this provider run a battery / virtual-power-plant programme?
  vpp             Boolean @default(false)
  /// Its name, where the programme is branded separately from the provider —
  /// a customer signs up to "Renew Home", not to their retailer.
  vppProgramme    String?
  /// One-off enrolment money, cents. PER BATTERY — see `vppMaxBatteries`.
  vppUpfrontCents Int?
  /// Recurring money, cents a year. PER BATTERY — see `vppMaxBatteries`.
  vppAnnualCents  Int?
  /// The most batteries this programme will pay for on one house.
  ///
  /// The two figures above are rates per battery and were multiplied by the
  /// design's raw count with no ceiling at all, so a ten-battery design quoted
  /// $2,000 a year against a programme that pays at most $1,200 — on a document
  /// the customer signs, under a twenty-five-year projection built on it.
  ///
  /// Null means the standard six (`VPP_DEFAULT_MAX_BATTERIES`), which with the
  /// $200 rate is the $1,200 ceiling the business runs. A column rather than a
  /// constant because the RATE beside it is already the provider's own: a
  /// programme paying something else has a different ceiling, and one hardcoded
  /// number would contradict the other the first time a second provider signs.
  vppMaxBatteries Int?

  // ── Who the programme is actually open to ────────────────────────────────
  //
  // A VPP is not offered to everyone who buys a battery. It runs on SOME ways
  // of paying and SOME hardware, and a rep who reads "$500/yr" without reading
  // the conditions has promised a homeowner money they will not receive.
  //
  // Three axes, each empty by default and each meaning "no restriction" when
  // empty, so a list nobody has edited behaves exactly as it did before this
  // existed. They are ANDed: the deal has to clear all three.

  /// Which ways of paying qualify. Empty is ANY.
  ///
  /// Separate from the product list below because CASH HAS NO LENDER ROW — a
  /// list of named products can never say "a cash deal qualifies", and most of
  /// these programmes turn on who ends up owning the battery rather than on
  /// which line of a rate sheet got signed. `cash` is a legitimate member here
  /// even though it is never a member of SolarLenderProduct.
  vppFinanceProducts FinanceProduct[] @default([])

  /// Which batteries the programme enrols, and which named finance products it
  /// accepts. Both empty is ANY, for the reason above.
  vppEquipment SolarProviderVppEquipment[]
  vppProducts  SolarProviderVppProduct[]

  /// Everything the fields above cannot hold: term lengths, enrolment windows,
  /// whichever condition this programme has that no other one does. Free text
  /// on purpose — a schema that tried to model every utility's small print
  /// would be wrong by the next quarter.
  notes String?

  createdAt DateTime @default(now())

  @@unique([companyId, kind, name])
  @@index([companyId, kind, active])
  @@map("solar_providers")
}

/// Which batteries a provider's VPP programme will actually enrol.
///
/// Modelled exactly like SolarEquipmentLender — an explicit join rather than an
/// implicit relation — for the same two reasons: the membership is genuinely
/// many-to-many (one battery is on several programmes, one programme lists
/// several batteries), and an explicit row can carry its own facts later (the
/// date the programme added it, the enrolment cap it comes with) without a
/// migration that rewrites the relation.
///
/// NO ROWS MEANS ANY BATTERY, not none. An office that has never opened this
/// screen has recorded no restriction, and reading that as "nothing qualifies"
/// would turn every existing programme ineligible on every deal overnight.
model SolarProviderVppEquipment {
  providerId  String
  provider    SolarProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   SolarEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@id([providerId, equipmentId])
  @@index([equipmentId])
  @@map("solar_provider_vpp_equipment")
}

/// Which named finance products a provider's VPP programme will accept.
///
/// This NARROWS `vppFinanceProducts`, it does not replace it: the type list
/// says "loans qualify", this says "and only these loans". A deal quoting a
/// product that is not on a non-empty list fails the finance axis even when its
/// type is allowed — which is the whole case this exists for, a lender whose
/// 25-year paper is in the programme and whose lease is not.
///
/// A cash offer names no product at all, so it is judged on the type list alone
/// and a non-empty product list never rules it out.
model SolarProviderVppProduct {
  providerId String
  provider   SolarProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productId  String
  product    SolarLenderProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@id([providerId, productId])
  @@index([productId])
  @@map("solar_provider_vpp_products")
}

model LeadSource {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(roofing)
  name      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  leads Lead[]

  // Roofing and Solar each keep their own sources ("Door Knock", "Referral"…).
  @@unique([companyId, vertical, name])
  @@map("lead_sources")
}

model Pipeline {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  vertical  Vertical @default(roofing) @map("industry") // each vertical has its own pipeline + stages
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  stages PipelineStage[]
  leads  Lead[]

  // Roofing and Solar may each have a pipeline of the same name.
  @@unique([companyId, vertical, name])
  @@index([companyId, vertical], map: "pipelines_companyId_industry_idx")
  @@map("pipelines")
}

model PipelineStage {
  id                    String        @id @default(uuid())
  pipelineId            String
  pipeline              Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name                  String
  key                   String
  position              Int           @default(0)
  color                 String        @default("#A1A1AA")
  isWon                 Boolean       @default(false)
  isLost                Boolean       @default(false)
  /// Where the SALE is booked: deals at or past this stage count as won on the
  /// team leaderboard. Separate from `isWon`, which marks the end of the job
  /// (Paid / System Activated) and is read by the backlog and cycle-time
  /// reports — a company sells in month one and gets paid in month four, and
  /// one flag cannot honestly mark both. Unset on every stage falls back to the
  /// stage NAMED for the signature, then to `isWon`. See lib/sold-stage.ts.
  countsAsSold          Boolean       @default(false)
  /// Whether we control completion (hard SLA) or are waiting on someone else
  /// (follow-up cadence). See StageType.
  stageType             StageType     @default(internally_owned)
  /// The DEPARTMENT ROLE that owns this stage's work — a key from
  /// STAGE_OWNERS in src/lib/solar-pipeline.ts, never a named person, so work
  /// keeps routing correctly as staff change.
  ownerRole             String?
  /// externally_blocked only: chase every N days. 0 = no cadence.
  followUpDays          Int           @default(0)
  /// True for "action required" sub-states (redlines, corrections) — the ball is
  /// in someone's court and the deal cannot advance until it is cleared.
  isActionRequired      Boolean       @default(false)
  /// Who a deal landing here is waiting on by default. Copied onto the deal on
  /// entry; a coordinator can override per deal.
  defaultBlocker        BlockerParty?
  // SLA / stage-duration tracking. targetDays 0 = no tracking on this stage.
  // internally_owned only — an externally_blocked stage must never carry a
  // completion deadline.
  targetDays            Int           @default(0)
  escalationDays        Int           @default(0)
  notificationRecipient String        @default("none") // none | assigned_user | team_manager | project_owner | department_manager | everyone
  sendInApp             Boolean       @default(true)
  sendEmail             Boolean       @default(false)
  markOverdue           Boolean       @default(false)
  createdAt             DateTime      @default(now())

  leads       Lead[]
  stageEvents LeadStageEvent[]

  @@unique([pipelineId, key])
  @@map("pipeline_stages")
}

/// One span of a deal's life in one pipeline stage: when it arrived, when it
/// left, and — by subtraction — how long that step actually took.
///
/// This is a CHILD of Lead (no companyId, no vertical): it is only ever reached
/// through a lead that vertical isolation has already scoped, exactly like Note
/// and FileAsset. See server/vertical/models.ts.
///
/// The stage NAME is snapshotted alongside the id because a stage can be
/// renamed or deleted years after a deal passed through it, and a cycle-time
/// history that silently rewrites itself is worse than none.
model LeadStageEvent {
  id        String         @id @default(uuid())
  leadId    String
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Null once the stage row is deleted — the name below survives it.
  stageId   String?
  stage     PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stageName String
  /// Where this stage sat in the pipeline when the deal passed through it.
  position  Int            @default(0)
  enteredAt DateTime       @default(now())
  /// Null on exactly one row per lead: the stage it is sitting in right now.
  exitedAt  DateTime?
  /// The person who put the deal INTO this stage. Null when no person did (see
  /// `via`), and on moves made before anyone was recorded.
  movedById String?
  movedBy   User?          @relation("LeadStageEventMovedBy", fields: [movedById], references: [id], onDelete: SetNull)
  /// Why no person is named: "automation" (a rule moved it) or "signature" (the
  /// homeowner's signature did). Null on a person's move.
  via       String?

  @@index([leadId, enteredAt])
  @@map("lead_stage_events")
}

/// One row per time a solar deal's appointment moved from one time to another.
///
/// Written by server/modules/leads/appointment-moves.ts from every path that
/// moves a time. A child of Lead with no vertical column, like LeadStageEvent:
/// only ever reached through a deal the caller has already scoped.
model LeadAppointmentReschedule {
  id             String   @id @default(uuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromAt         DateTime
  toAt           DateTime
  /// The outcome the old visit carried, cleared off the deal by this move.
  clearedOutcome String?
  /// SetNull: removing a user must not erase that the appointment moved.
  movedById      String?
  movedBy        User?    @relation("LeadAppointmentRescheduleMovedBy", fields: [movedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_appointment_reschedules")
}

model Lead {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Contact
  firstName         String
  lastName          String
  // Optional co-owner / co-signer on the deal (e.g. spouse). Maps to the
  // "Co-owner" autofill token + co-homeowner slots on document templates.
  //
  // The email is what makes them a SIGNER rather than a name on a page: a
  // document is sent to an address, so a co-owner without one could be printed
  // but never asked to sign. That absence is why "Send final docs" and the
  // send_for_signature automation both used to hard-code the customer as the
  // only signer.
  coOwnerName       String?
  coOwnerEmail      String?
  coOwnerPhone      String?
  /// Preferred spoken language for calls, visits and door-knocks. Free text,
  /// deliberately not an enum: which languages a company serves is business
  /// config, and an enum would need a migration every time someone adds
  /// Vietnamese. Applies to any vertical — a roofing customer has a preferred
  /// language too.
  preferredLanguage String?
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  // Geocoded coordinates for the canvassing map (filled from the address by the
  // geocode-leads cron). geocodedAt marks the attempt so it isn't retried forever.
  lat               Float?
  lng               Float?
  geocodedAt        DateTime?

  // Pipeline
  pipelineId String?
  pipeline   Pipeline?      @relation(fields: [pipelineId], references: [id])
  stageId    String?
  stage      PipelineStage? @relation(fields: [stageId], references: [id])
  position   Int            @default(0) // order within stage column

  // Which isolated vertical workspace this deal belongs to (Roofing / Solar).
  vertical    Vertical    @default(roofing) @map("industry")
  status      LeadStatus  @default(open)
  serviceType ServiceType @default(roofing)
  // Cash (out-of-pocket / financing) vs insurance (filed claim). Drives whether the
  // claim section, scope of work, and the insurance proposal financials apply.
  dealType    DealType    @default(insurance)
  priority    Priority    @default(medium)
  value       Int         @default(0) // estimated job value (rep's estimate), cents
  // The CONTRACT price from the insurance scope, set after the Scope Received
  // inspection. When set, this (not `value`) is the deal's contract value and
  // drives the profit pool / commissions. Cents.
  claimPrice  Int?

  // Estimated property (home) value, carried from a canvassing knock. Cents.
  propertyValue       Int?
  propertyValueSource String?
  // Full estimate snapshot: range, confidence, last sale, assessed, beds/baths/sqft/year.
  propertyData        Json?

  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  assignedRepId String?
  assignedRep   User?   @relation("LeadAssignedRep", fields: [assignedRepId], references: [id])
  /// Who SET the appointment, where that is a different person from the rep who
  /// runs it. Solar sells door-to-door: a setter knocks and books, a closer
  /// sits the table, and both are paid off the same deal — so a single
  /// `assignedRepId` could name one of them and lost the other.
  ///
  /// Nullable and unused by roofing, where the canvasser who knocks is already
  /// funnelled into the owning rep (see resolveOwningRepId).
  setterId      String?
  setter        User?   @relation("LeadSetter", fields: [setterId], references: [id])
  createdById   String?
  createdBy     User?   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  // Linked customer portal user (role=customer)
  customerUserId String?
  customerUser   User?   @relation("LeadCustomerUser", fields: [customerUserId], references: [id])

  appointmentAt          DateTime?
  // Outcome of running the appointment (e.g. sold, follow-up, no-show) + a note.
  appointmentDisposition String?
  appointmentNote        String?
  // Inspection result recorded after the appointment / when opening the claim + a note.
  inspectionOutcome      String?
  inspectionNote         String?
  /// A key from the company's customizable claim-status list (Settings → Claim
  /// Statuses). The nine built-in keys are the old enum values, so `isScopeReady`
  /// and every historical row keep working.
  claimStatus            String    @default("not_filed")
  notes                  String?
  customFields           Json      @default("{}")

  // When the deal last entered its current pipeline stage — drives the
  // "days in this status" age badge on pipeline cards. Null = use createdAt.
  stageChangedAt  DateTime?
  // SLA tracking: which alerts have fired this stage (0 none, 1 target, 2 escalation),
  // reset to 0 on every stage move. stageOverdue is set by the alert job when a stage
  // with markOverdue is exceeded. Both apply to internally_owned stages only.
  stageAlertLevel Int       @default(0)
  stageOverdue    Boolean   @default(false)

  // ── Externally-blocked tracking ─────────────────────────────────────────
  /// Who this deal is waiting on right now. Seeded from the stage's
  /// defaultBlocker on entry; a coordinator can correct it per deal.
  blockedBy        BlockerParty?
  /// What exactly we are waiting for ("plan review round 2", "meter spot").
  blockerNote      String?
  /// When WE last chased the blocker. This — not time-in-stage — is what the
  /// follow-up cadence measures, so a utility's queue never reads as our delay.
  lastTouchAt      DateTime?
  /// When the chase reminder last fired, so the cadence repeats instead of
  /// firing once and going quiet.
  lastChaseAlertAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project                Project?
  claims                 Claim[]
  roofMeasurements       RoofMeasurement[]
  tasks                  Task[]
  noteEntries            Note[]
  files                  FileAsset[]
  documentPackages       DocumentPackage[]
  activityLogs           ActivityLog[]
  stageEvents            LeadStageEvent[]
  appointmentReschedules LeadAppointmentReschedule[]
  knocks                 Knock[]                 @relation("KnockLead")
  scope                  ScopeOfWork?
  estimate               Estimate?
  proposals              Proposal[]
  solarDesign            SolarDesign?
  solarFinance           SolarFinance?
  creditApplications     CreditApplication[]
  solarProposals         SolarProposal[]
  solarLenderSubmissions SolarLenderSubmission[]
  solarMilestones        SolarMilestone[]
  solarDealComp          SolarDealComp?
  solarDealAdders        SolarDealAdder[]
  feedPosts              DealFeedPost[]
  automationRuns         AutomationRun[]

  @@index([companyId, stageId])
  @@index([companyId, assignedRepId])
  @@index([setterId])
  @@index([companyId, status])
  @@index([companyId, vertical], map: "leads_companyId_industry_idx")
  @@map("leads")
  solarContractUnlocks SolarContractUnlock[]

}

model Project {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(roofing)
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectNumber String
  status        ProjectStatus @default(not_started)
  serviceType   ServiceType   @default(roofing)
  priority      Priority      @default(medium)

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  // Property / scope
  address             String?
  city                String?
  state               String?
  zip                 String?
  roofingType         String?
  materialSelection   String?
  squares             Float?
  pitch               String?
  tearOffLayers       Int?
  contractValue       Int     @default(0) // cents (base scope)
  // Approved supplement + customer-paid deductible. Both add to the effective
  // contract value used for the profit-pool / rep-commission math.
  supplementCents     Int     @default(0)
  deductibleCents     Int     @default(0)
  depreciationCents   Int     @default(0)
  // Per-deal: is the supplement / depreciation included in the rep+manager split
  // pool? Off when the rep is paid upfront and the company waits on that money.
  // The deductible is never in the split pool — the rep is paid its own % of it.
  repGetsSupplement   Boolean @default(true)
  repGetsDepreciation Boolean @default(true)
  // True when the COMPANY provided the lead/appointment (vs. rep self-gen). Picks
  // which rep split applies: providedLeadSplitPct vs the standard commissionSplitPct.
  companyProvidedLead Boolean @default(false)

  // Scheduling / production
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  // Insurance adjuster meeting date (set once the deal reaches adjuster-scheduled).
  adjusterMeetingAt DateTime?
  // Scheduled installation date.
  installDate       DateTime?
  // Scheduled inspection (solar: AHJ / utility inspection after install).
  // Nullable and unused by roofing, whose calendar keeps its existing set.
  inspectionAt      DateTime?
  completedAt       DateTime?
  notes             String?
  customFields      Json      @default("{}")

  // Closeout
  qcChecklist   Json @default("[]") // [{ label, done }]
  closeoutSheet Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims           Claim[]
  roofMeasurements RoofMeasurement[]
  crewAssignments  ProjectCrew[]
  assignees        ProjectAssignee[]
  tasks            Task[]
  noteEntries      Note[]
  files            FileAsset[]
  dailyReports     DailyReport[]
  documentPackages DocumentPackage[]
  invoices         Invoice[]
  commissions      Commission[]
  contractorPays   ContractorPay[]
  activityLogs     ActivityLog[]
  costs            ProjectCost[]

  @@unique([companyId, projectNumber])
  @@index([companyId, status])
  @@index([companyId, managerId])
  @@index([companyId, vertical])
  @@map("projects")
}

enum ProjectCostType {
  labor
  material
  other
}

// A per-deal cost line (labor/material invoice). Sum of these is the job cost
// subtracted (with company overhead) before the rep/company profit split.
model ProjectCost {
  id          String          @id @default(uuid())
  companyId   String // scalar tenancy key
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical    Vertical?
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        ProjectCostType @default(material)
  label       String // invoice name / description
  vendor      String? // who it's from (installer / supplier)
  amount      Int             @default(0) // cents
  fileAssetId String? // optional attached invoice
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([companyId, projectId])
  @@map("project_costs")
}

// ---------------------------------------------------------------------------
// Insurance claims (roofing / storm)
// ---------------------------------------------------------------------------

model Claim {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(roofing)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  carrier                 String?
  claimNumber             String?
  policyNumber            String?
  adjusterName            String?
  adjusterPhone           String?
  adjusterEmail           String?
  lossDate                DateTime?
  adjusterMeetingAt       DateTime?
  /// Same customizable key space as `Lead.claimStatus` — see claim-status.ts.
  status                  String    @default("filed")
  rcv                     Int       @default(0) // replacement cost value, cents
  acv                     Int       @default(0) // actual cash value, cents
  deductible              Int       @default(0)
  depreciation            Int       @default(0)
  // Roof information for the claim worksheet.
  roofSquares             Float?
  wasteFactorPct          Float?
  pitch                   String?
  storyCount              Int?
  // Flagged supplement opportunities (array of keys, e.g. ["drip_edge","ice_water"]).
  supplementOpportunities Json      @default("[]")
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  lineItems   ClaimLineItem[]
  supplements ClaimSupplement[]

  @@index([companyId, leadId])
  @@map("claims")
}

model ClaimLineItem {
  id            String   @id @default(uuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  code          String?
  description   String
  quantity      Float    @default(1)
  unit          String?
  unitPrice     Int      @default(0) // cents
  rcv           Int      @default(0)
  depreciation  Int      @default(0)
  isRecoverable Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([claimId])
  @@map("claim_line_items")
}

model ClaimSupplement {
  id               String   @id @default(uuid())
  claimId          String
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  supplementNumber String
  status           String   @default("requested")
  requestedAmount  Int      @default(0)
  approvedAmount   Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([claimId])
  @@map("claim_supplements")
}

model RoofMeasurement {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  source       String   @default("manual") // eagleview | hover | gaf | manual
  totalSquares Float    @default(0)
  wastePct     Float    @default(10)
  pitch        String?
  ridgeLf      Float    @default(0)
  hipLf        Float    @default(0)
  valleyLf     Float    @default(0)
  eaveLf       Float    @default(0)
  rakeLf       Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([companyId, leadId])
  @@map("roof_measurements")
}

// ---------------------------------------------------------------------------
// Crews & production
// ---------------------------------------------------------------------------

model Crew {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  leadName  String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  members     CrewMember[]
  assignments ProjectCrew[]

  @@unique([companyId, name])
  @@map("crews")
}

model CrewMember {
  id        String   @id @default(uuid())
  crewId    String
  crew      Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  role      String   @default("installer")
  payRate   Int      @default(0) // cents per square or hour, interpreted by rule
  createdAt DateTime @default(now())

  @@index([crewId])
  @@map("crew_members")
}

/// One person on one install.
///
/// Deliberately a person and not a Crew: `Crew`/`CrewMember` model a standing
/// team, and nothing in the app has ever created one — production ran to five
/// jobs with zero crews and zero way to make one, so the assigner below them
/// was a dropdown that hid itself. Installs here are staffed by naming the
/// people going out, which is what the office actually knows on the day.
///
/// `role` is free text on purpose. "Lead installer", "electrician", "helper"
/// and whatever a crew calls the person who does the roof penetrations are not
/// a fixed set worth migrating for, and payroll does not read this.
model ProjectAssignee {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("ProjectAssignee", fields: [userId], references: [id], onDelete: Cascade)
  /// WHICH scheduled visit this person is on. A job has two dates that send
  /// different people to the site — the install and the inspection that
  /// follows it — so an assignment that does not say which one is not an
  /// answer to "who is going out, and when".
  kind      AssignmentKind @default(install)
  role      String?
  createdAt DateTime       @default(now())

  /// One row per person per VISIT. The same installer can be on both the
  /// install and the inspection; assigning them twice to the same visit is a
  /// mis-click, not a second shift.
  @@unique([projectId, userId, kind])
  @@index([companyId, projectId])
  @@index([userId, kind])
  @@map("project_assignees")
}

/// The scheduled visits a person can be assigned to. Mirrors the two date
/// columns on Project (installDate, inspectionAt) and the two calendar event
/// types they produce — adding a third visit means adding it in all three
/// places at once, which is the point of naming them.
enum AssignmentKind {
  install
  inspection
}

model ProjectCrew {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crewId        String
  crew          Crew      @relation(fields: [crewId], references: [id], onDelete: Cascade)
  role          String?
  scheduledDate DateTime?
  createdAt     DateTime  @default(now())

  @@unique([projectId, crewId])
  @@map("project_crews")
}

model DailyReport {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedById     String?
  reportedBy       User?    @relation(fields: [reportedById], references: [id])
  date             DateTime @default(now())
  squaresCompleted Float    @default(0)
  crewSize         Int      @default(0)
  weather          String?
  summary          String?
  createdAt        DateTime @default(now())

  @@index([companyId, projectId])
  @@map("daily_reports")
}

// ---------------------------------------------------------------------------
// Tasks, notes, files, custom fields, activity
// ---------------------------------------------------------------------------

model Task {
  id              String     @id @default(uuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          TaskStatus @default(todo)
  priority        Priority   @default(medium)
  // Which workspace this task belongs to, or NULL for a COMPANY-scoped task.
  //
  // Company tasks ("submit your timesheet", "all-hands Friday") are visible from
  // every workspace; a workspace task only appears in its own. That is why this
  // is nullable and why Task is registered SCOPED_OPTIONAL rather than SCOPED —
  // a plain SCOPED read would filter company tasks out of existence.
  vertical        Vertical?  @map("industry")
  dueAt           DateTime?
  leadId          String?
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById     String?
  createdBy       User?      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  // Completion stamp (who/when) for "took X days" duration tracking.
  completedAt     DateTime?
  completedById   String?
  completedByName String? // denormalized so it survives user changes
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([companyId, assigneeId, status])
  @@index([companyId, createdById])
  @@index([companyId, vertical], map: "tasks_companyId_industry_idx")
  @@map("tasks")
}

model Note {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  body      String
  // Optional placement tag: null = general note; "appointment_outcome" /
  // "inspection_outcome" = an immutable note shown under that outcome.
  context   String?
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId, leadId])
  @@index([companyId, projectId])
  @@map("notes")
}

/**
 * Where a file is allowed to be seen.
 * The table already isolated deal files through their PARENT lead/project, which
 * works and is what the file-serve route enforces. What it could not express was
 * a file with no parent: the branding logo, a GL receipt and a Solar training PDF
 * were indistinguishable rows. This column makes the intent explicit and adds the
 * one case that had no representation at all — `private`.
 */
enum FileScope {
  company // visible from every workspace (branding, GL receipts, chat attachments)
  workspace // isolated — via the parent deal, or via `vertical` when parentless
  private // uploader + admins only, regardless of workspace
}

model FileAsset {
  id                  String             @id @default(uuid())
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind                FileKind           @default(document)
  scope               FileScope          @default(workspace)
  // Set only for a parentless `workspace` file. A file hanging off a lead or
  // project leaves this NULL and inherits isolation from that parent, which is
  // the mechanism the file-serve route already proves out.
  vertical            Vertical?          @map("industry")
  name                String
  storageKey          String
  mimeType            String?
  size                Int                @default(0)
  category            String? // e.g. "before", "after", "contract", or a photo slot label
  leadId              String?
  lead                Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // CompanyCam-style: links a photo to a checklist slot.
  photoTemplateItemId String?
  photoTemplateItem   PhotoTemplateItem? @relation(fields: [photoTemplateItemId], references: [id], onDelete: SetNull)
  // Team-chat attachments: a file shared in a conversation (linked to its message).
  conversationId      String?
  conversation        Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId           String?
  message             Message?           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Bookkeeping: a receipt / invoice attached to a transaction.
  transactionId       String?
  transaction         Transaction?       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploadedById        String?
  uploadedBy          User?              @relation(fields: [uploadedById], references: [id])
  createdAt           DateTime           @default(now())

  signedPackages DocumentPackage[] @relation("PackageSignedFile")
  // A contractor invoice grows a pay line once the funding desk generates one.
  contractorPay  ContractorPay?

  @@index([companyId, projectId])
  @@index([companyId, leadId])
  @@index([photoTemplateItemId])
  @@index([conversationId])
  @@index([messageId])
  @@index([transactionId])
  @@index([companyId, scope, vertical], map: "files_companyId_scope_industry_idx")
  @@map("files")
}

enum PhotoTemplateKind {
  site // site / inspection photos
  install
}

model PhotoTemplate {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical          @default(roofing)
  name      String
  kind      PhotoTemplateKind
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  items PhotoTemplateItem[]

  @@index([companyId, kind])
  @@map("photo_templates")
}

model PhotoTemplateItem {
  id         String        @id @default(uuid())
  templateId String
  template   PhotoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  required   Boolean       @default(false)
  position   Int           @default(0)

  /// A reference shot for this slot — what a good version of it looks like —
  /// uploaded once by an admin and shown beside the slot on every job.
  ///
  /// Held as bytes of its own rather than as a FileAsset, deliberately: an
  /// example belongs to the checklist, not to any one deal, and a `files` row
  /// would need a lead or a project to hang off. It would then show up in that
  /// deal's photo folder, in its counts and in the compiled PDF report as if
  /// the crew had taken it. Same reasoning as a lender's logo. Normalised to
  /// JPEG on the way in, so no mime column is needed.
  exampleKey       String?
  /// When the example last changed — the cache-buster in the serving URL. A
  /// column rather than a request-time clock so the image can be cached hard.
  exampleUpdatedAt DateTime?

  files FileAsset[]

  @@index([templateId])
  @@map("photo_template_items")
}

model CustomFieldDef {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical          @default(roofing)
  entity    CustomFieldEntity
  key       String
  label     String
  type      CustomFieldType   @default(text)
  options   Json              @default("[]")
  required  Boolean           @default(false)
  position  Int               @default(0)
  createdAt DateTime          @default(now())

  @@unique([companyId, vertical, entity, key])
  @@map("custom_field_defs")
}

model ActivityLog {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      ActivityType @default(system)
  message   String
  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id])
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metadata  Json         @default("{}")
  ip        String?
  // Originating workspace. NULL = a company-level action (a payroll run, a
  // branding change) that belongs to no workspace and is visible in all of them.
  // Like Notification this is permission-filtered rather than SCOPED: an auditor
  // granted both workspaces must see both without switching.
  vertical  Vertical?    @map("industry")
  createdAt DateTime     @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, projectId])
  @@index([companyId, vertical, createdAt], map: "activity_logs_companyId_industry_createdAt_idx")
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Document signer (DocuSign-style)
// ---------------------------------------------------------------------------

/// Somebody authorised to sign on the company's behalf.
///
/// The owner signs every contract in principle and is available for none of
/// them in practice. Before this, "our side" of a document was two boxes typed
/// by hand at send time and a signing link posted to a colleague — so the CRM
/// never knew who had signed, under what title, or against which licence.
/// Storing the person means the signature block fills itself and the audit
/// trail can name them.
///
/// Company-wide, not per vertical: the same person signs a roof contract and a
/// solar install agreement. Which signer a DOCUMENT uses is settled on the
/// template, and templates are already per vertical, so that difference is
/// expressed where it belongs.
model CompanySigner {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  title         String?
  email         String?
  phone         String?
  licenseNumber String?
  /// Extra labelled credential lines: [{ key, label, value }]. `key` is the
  /// slugified label FROZEN at creation — renaming a label must not orphan a
  /// template already mapping {{signer.cred.<key>}}.
  credentials   Json     @default("[]")
  /// The saved signature as a PNG data URL — the same shape
  /// `DocumentSigner.signatureData` already holds, so the PDF stamper draws it
  /// through its existing embedPng path with no new branch.
  signatureData String?
  /// A separate mark for Initials fields. Falls back to `signatureData`, so a
  /// signer who never drew one still initials rather than leaving a blank.
  initialsData  String?
  /// Signs anything whose template names nobody. Exactly one per company; the
  /// action clears the others rather than a partial index doing it, because
  /// "make this one the default" is one intent and should be one transaction.
  isDefault     Boolean  @default(false)
  /// Retiring a signer deactivates rather than deletes: templates may still
  /// point at them, and sent documents quote them.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  templates DocumentTemplate[]

  @@index([companyId, active])
  @@map("company_signers")
}

model DocumentTemplate {
  id              String               @id @default(uuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  type            DocumentTemplateType @default(custom)
  // Vertical workspace this contract template belongs to (each has its own set).
  vertical        Vertical             @default(roofing) @map("industry")
  description     String?
  // Page model: array of { width, height } in PDF points. Default = US Letter pages.
  pages           Json                 @default("[]")
  // Body content blocks rendered to PDF: [{ page, type:'heading'|'text', text, x, y }]
  body            Json                 @default("[]")
  // Storage key of an uploaded source PDF. When set, fields are stamped onto it.
  sourcePdfKey    String?
  // Which deal folder this document files into once signed, as a DealFolder key
  // (src/lib/deal-folders.ts). NULL means Contract — the folder every package
  // landed in before routing existed, so existing templates keep their behaviour
  // without a backfill.
  folderKey       String?
  // Belongs to the closeout packet sent at install completion — the deal's
  // "Send final docs to customer" button sends every template carrying this
  // flag as ONE envelope, in `createdAt` order. Creation order is the packet
  // order deliberately: it is stable, it needs no second column, and it needs
  // no reordering UI for a set that is three documents long.
  finalPacket     Boolean              @default(false)
  // Who signs this one for us. NULL means the company's default signer, which
  // is what every template gets until somebody says otherwise. A live pointer
  // rather than a frozen copy: what must not move once a document is sent is
  // the RESOLVED signer, and that is frozen into the package's signer row,
  // field values and events instead.
  companySignerId String?
  companySigner   CompanySigner?       @relation(fields: [companySignerId], references: [id], onDelete: SetNull)
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  fields    DocumentTemplateField[]
  documents DocumentTemplateDocument[]
  packages  DocumentPackage[]

  @@index([companyId, type])
  @@index([companyId, vertical], map: "document_templates_companyId_industry_idx")
  @@map("document_templates")
}

/// One PDF inside a contract template. A template is a LIST of these, so a
/// single send can carry an install agreement and its warranty as one envelope
/// with one signing link — rather than two envelopes the customer has to sign
/// twice.
///
/// Templates created before this table existed have no rows here and keep using
/// the parent's `sourcePdfKey`/`pages`. Adding a second document materialises
/// that legacy PDF as document 1 first (see addTemplateDocumentAction), which is
/// why every read path still tolerates an empty list.
model DocumentTemplateDocument {
  id           String           @id @default(uuid())
  templateId   String
  template     DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// 1-based position in the bundle. The merged, signed PDF follows this order.
  order        Int              @default(1)
  name         String
  sourcePdfKey String?
  /// Page model of THIS document: [{ width, height }] in PDF points.
  pages        Json             @default("[]")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  fields DocumentTemplateField[]

  @@index([templateId, order])
  @@map("document_template_documents")
}

model DocumentTemplateField {
  id           String                    @id @default(uuid())
  templateId   String
  template     DocumentTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Which document in the bundle this field sits on. NULL means the template's
  /// own PDF — the only possibility before multi-document templates, and still
  /// the case for every single-PDF template, so `page` is read against that
  /// document's pages either way.
  documentId   String?
  document     DocumentTemplateDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page         Int                       @default(1)
  x            Float
  y            Float
  width        Float                     @default(160)
  height       Float                     @default(40)
  type         DocumentFieldType
  signerRole   DocumentSignerRole        @default(customer)
  label        String?
  required     Boolean                   @default(true)
  // Auto-fill token, e.g. {{customer.fullName}}, {{project.address}}
  valueToken   String?
  // Fallback value used when the bound CRM field is empty for a given record.
  defaultValue String?
  createdAt    DateTime                  @default(now())

  @@index([templateId])
  @@index([documentId])
  @@map("document_template_fields")
}

model DocumentPackage {
  id           String                @id @default(uuid())
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical     Vertical              @default(roofing)
  templateId   String?
  template     DocumentTemplate?     @relation(fields: [templateId], references: [id])
  leadId       String?
  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  status       DocumentPackageStatus @default(draft)
  // Snapshot of template body + fields at send time so edits don't mutate sent docs
  snapshot     Json                  @default("{}")
  // Destination folder, copied from the template when the package is sent.
  // Copied rather than read live for the same reason `snapshot` exists: editing
  // a template must not relocate documents already signed.
  folderKey    String?
  signedFileId String?
  signedFile   FileAsset?            @relation("PackageSignedFile", fields: [signedFileId], references: [id])
  sentAt       DateTime?
  completedAt  DateTime?
  voidedAt     DateTime?
  expiresAt    DateTime?
  createdById  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  signers DocumentSigner[]
  values  DocumentFieldValue[]
  events  DocumentEvent[]

  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, vertical])
  @@map("document_packages")
}

model DocumentSigner {
  id            String             @id @default(uuid())
  companyId     String
  packageId     String
  package       DocumentPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  role          DocumentSignerRole
  order         Int                @default(1)
  name          String
  email         String?
  status        SignerStatus       @default(pending)
  tokenHash     String             @unique
  signatureType SignatureType?
  signatureData String? // data URL of drawn/typed signature image
  consentAt     DateTime?
  viewedAt      DateTime?
  signedAt      DateTime?
  ip            String?
  userAgent     String?
  // Geolocation captured at signing (only if the signer grants browser permission).
  latitude      Float?
  longitude     Float?
  geoAccuracy   Float? // meters
  createdAt     DateTime           @default(now())

  values DocumentFieldValue[]

  @@index([companyId, packageId, order])
  @@map("document_signers")
}

// Filled value for a field (per package), captured at signing time.
model DocumentFieldValue {
  id        String            @id @default(uuid())
  packageId String
  package   DocumentPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  signerId  String?
  signer    DocumentSigner?   @relation(fields: [signerId], references: [id], onDelete: Cascade)
  fieldKey  String // template field id reference within snapshot
  type      DocumentFieldType
  page      Int               @default(1)
  x         Float             @default(0)
  y         Float             @default(0)
  width     Float             @default(160)
  height    Float             @default(40)
  value     String? // text/date/checkbox value or signature data URL
  filledAt  DateTime?

  @@index([packageId])
  @@map("document_field_values")
}

model DocumentEvent {
  id        String            @id @default(uuid())
  companyId String
  packageId String
  package   DocumentPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  signerId  String?
  type      DocumentEventType
  actor     String? // name/email/system
  ip        String?
  userAgent String?
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now())

  @@index([companyId, packageId, createdAt])
  @@map("document_events")
}

// ---------------------------------------------------------------------------
// Payroll & commissions
// ---------------------------------------------------------------------------

model CommissionRule {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical    Vertical       @default(roofing)
  name        String
  // Commission category this rule pays out to. Not a user Role — it includes
  // "project_manager" (the project's assigned manager via Project.managerId).
  // One of: "sales_rep" | "manager" | "project_manager" | "installer".
  role        String
  type        CommissionType @default(percentage)
  // For percentage: percent (e.g. 10 = 10% of base). For flat: amount cents. For job_cost: percent of margin.
  percent     Float          @default(0)
  flatAmount  Int            @default(0)
  projectType String? // optional filter, matches Project.roofingType
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  commissions Commission[]

  @@index([companyId, role])
  @@map("commission_rules")
}

model Commission {
  id                          String              @id @default(uuid())
  companyId                   String
  company                     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical                    Vertical?
  projectId                   String
  project                     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                      String
  user                        User                @relation("CommissionUser", fields: [userId], references: [id])
  ruleId                      String?
  rule                        CommissionRule?     @relation(fields: [ruleId], references: [id])
  // Set when this line is an override (X earns off Y's deal); distinguishes it
  // from the recipient's own split line so both can coexist + recompute cleanly.
  overrideId                  String?
  override                    CommissionOverride? @relation(fields: [overrideId], references: [id], onDelete: SetNull)
  label                       String?
  baseAmount                  Int                 @default(0) // cents the commission was computed from
  amount                      Int                 @default(0) // computed commission, cents
  // Snapshot of the split terms at generation time. Locked once created so editing
  // a rep's split never changes existing deals; re-generating only refreshes the
  // amount from current costs using THESE terms. amount = max(0, pool*splitPct% − splitFlatCents).
  splitPct                    Float?
  splitFlatCents              Int                 @default(0)
  // Snapshot of the SOLAR terms, for the same reason and with the same rule:
  // raising a rep's redline must never re-price a deal they already sold. Null
  // on every roofing line. Watts and price are deliberately NOT snapshotted -- a
  // design that grows between contract and install should move the number,
  // exactly as job costs move a roofing pool.
  // "redline" | "per_watt" | "battery_redline" | "battery_flat" -- which basis
  // produced this line. The two battery bases only ever appear on a job selling
  // storage on its own; a battery riding along on an array is paid by the watt
  // bases, exactly as it always was.
  solarBasis                  String?
  // The rep's redline at generation, cents per watt.
  solarRedlineCentsPerWatt    Int?
  // The rep's redline at generation on a storage deal, cents per battery. Held
  // for the same reason as the two beside it: raising a rep's redline must
  // never re-price a deal they already sold.
  solarRedlinePerBatteryCents Int?
  // The rep's flat per-battery rate at generation, cents. Snapshotted for the
  // same reason as the three beside it.
  solarPerBatteryFlatCents    Int?
  // The rep's fixed rate at generation, mills per watt.
  solarMillsPerWatt           Int?
  // What the basis produced BEFORE the company's lead take, cents. `amount` is
  // what the rep is actually owed. Equal on a self-generated deal; on a
  // company-provided one the difference is what the company kept, and a pay stub
  // that could not show both would be a number a rep cannot check.
  // Null on every roofing line and on solar lines written before this existed.
  solarGrossAmount            Int?
  // The company take applied to THIS line, snapshotted at generation for the
  // same reason the rates beside it are: changing the rate tomorrow must never
  // reprice a deal that has already funded.
  solarCompanyLeadTakePct     Float?
  // The flat lead deduction applied to THIS line, cents. Exactly one of this
  // and the percentage above is ever set.
  solarCompanyLeadFlatCents   Int?
  status                      CommissionStatus    @default(pending)
  notes                       String?
  approvedAt                  DateTime?
  paidAt                      DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  payrollItems PayrollItem[]
  chargebacks  Chargeback[]

  // One commission per (project, recipient, rule) — guards against duplicate generation.
  @@unique([projectId, userId, ruleId])
  @@index([companyId, userId, status])
  @@index([companyId, projectId])
  @@map("commissions")
}

/// What a subcontractor billed for a job, and what we are actually paying him.
///
/// The commission table's opposite number, and deliberately NOT a row in it. A
/// Commission is money owed to someone who SOLD the job; this is money owed to
/// whoever BUILT it, and the two differ in every way that matters downstream:
///
///   - who may see it. Commissions are read through `Commission:read`, which
///     reps and managers hold. A subcontractor's price is read through
///     `ContractorInvoice` — super_admin and accounting only — because it is a
///     cost of goods, not an earning. Filing these as commissions would have
///     published it on the Commissions tab.
///   - what it does to a job's books. A paid commission posts to a
///     job-cost-EXCLUDED category on purpose, so paying the rep does not make
///     the job look unprofitable. A subcontractor's labour bill is the textbook
///     job cost and posts INCLUDED. Same table would have meant same treatment,
///     and the Job Profitability report would have been wrong in both directions.
///   - where the number comes from. A commission is COMPUTED from a rule and a
///     pool. This is TYPED, off a PDF a human is reading, because nothing in the
///     product can read an invoice. `amount` therefore starts at zero and cannot
///     be approved there — see approveContractorPayAction.
///
/// One line per invoice (`invoiceId` is unique), so "generate" is idempotent and
/// a contractor who bills twice on one job gets paid twice.
model ContractorPay {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Tagged, never filtered on read — same treatment as Commission, so the
  /// books stay consolidated while the P&L can still break out by department.
  vertical  Vertical?

  /// The invoice being paid. Cascade: the bill IS the record, so deleting it
  /// takes the pay line with it rather than leaving a payable for a document
  /// nobody can produce.
  invoiceId String    @unique
  invoice   FileAsset @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// The job, where there is one. Resolved from the invoice at generation and
  /// stored so the ledger can tag the expense to the deal.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// The contractor: whoever uploaded the invoice. Not a field anyone types —
  /// it is his login, which is what makes it un-fakeable.
  userId String
  user   User   @relation("ContractorPayContractor", fields: [userId], references: [id])

  /// Cents. Zero until someone reads the PDF and types what it says.
  amount Int     @default(0)
  label  String?

  status     CommissionStatus @default(pending)
  notes      String?
  approvedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  payrollItems PayrollItem[]

  @@index([companyId, status])
  @@index([companyId, userId, status])
  @@index([projectId])
  @@map("contractor_pays")
}

// Person-to-person override: `beneficiary` earns a % of contract (or a flat
// amount) on every deal whose assigned rep is `source`. E.g. a manager earning
// 3% on a rep's deals, or a senior rep earning $500/deal off a junior rep.
//
// Deliberately NOT registered in src/server/vertical/models.ts. Roofing and
// Solar pay differently, so the rate is per vertical (see `vertical` below) —
// but the Team page is a shared roster screen that must show a person's whole
// override sheet, both sides at once. Scoping the model would hide half of it
// from whichever workspace the admin happened to be standing in. The vertical
// is carried as data and matched against the deal's own vertical at payout.
model CommissionOverride {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  beneficiaryId String // who earns the override
  beneficiary   User           @relation("OverrideBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Cascade)
  sourceId      String // whose deals trigger it (the assigned rep)
  source        User           @relation("OverrideSource", fields: [sourceId], references: [id], onDelete: Cascade)
  /// Which side of the business this rate applies to. A rep working both
  /// verticals gets one row per vertical, each with its own type and amount —
  /// an override never pays across the workspace it was written for.
  vertical      Vertical       @default(roofing)
  /// percentage (of the rep's FINAL commission) | flat (per deal) | ppw ($/W of
  /// system DC size). `job_cost` and `margin` are roofing-era values that no
  /// solar override uses.
  type          CommissionType @default(percentage)
  percent       Float          @default(0)
  flatAmount    Int            @default(0) // cents per deal
  /// Mills (tenths of a cent) per watt of system DC size. Read only when
  /// type = ppw — mills rather than cents for the same reason
  /// `User.solarPerWattMills` is: a $/W rate is quoted to the cent.
  perWattMills  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  commissions Commission[]

  @@unique([companyId, beneficiaryId, sourceId, vertical])
  @@index([companyId, sourceId, vertical])
  @@map("commission_overrides")
}

model PayrollRun {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label         String
  periodStart   DateTime
  periodEnd     DateTime
  status        PayrollStatus @default(draft)
  notes         String?
  approvedAt    DateTime?
  paidAt        DateTime?
  /// When this run was FINALISED. Once set the run is historically immutable:
  /// no commission may enter it, no amount may change, no adjustment may be
  /// added or edited. Anything found afterwards goes to the next run or through
  /// an explicit reversal — a closed payroll is a record of what was paid, and
  /// rewriting it makes every earlier statement unverifiable.
  finalizedAt   DateTime?
  finalizedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items                PayrollItem[]
  adjustments          PayrollAdjustment[]
  chargebackRecoveries ChargebackRecovery[]

  @@index([companyId, status])
  @@map("payroll_runs")
}

model PayrollItem {
  id              String         @id @default(uuid())
  payrollRunId    String
  payrollRun      PayrollRun     @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  commissionId    String?
  // Cascade: deleting a commission removes its payroll line so run totals can never
  // count a commission that no longer exists (no stale snapshot, no dangling ref).
  commission      Commission?    @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  // The OTHER thing a run pays out. Exactly one of these two is set on any line:
  // a payroll run is "everyone we owe money to this period", and the crews who
  // did the work are owed as surely as the reps who sold it. Same cascade rule,
  // for the same reason — a deleted pay line must not survive as a run total.
  contractorPayId String?
  contractorPay   ContractorPay? @relation(fields: [contractorPayId], references: [id], onDelete: Cascade)
  label           String
  amount          Int            @default(0) // cents
  paid            Boolean        @default(false)
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([payrollRunId])
  @@index([contractorPayId])
  @@map("payroll_items")
}

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical      Vertical?
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String
  status        InvoiceStatus @default(draft)
  amount        Int           @default(0) // cents
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId, projectId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Notifications (customizable rules engine)
// ---------------------------------------------------------------------------

model NotificationRule {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical          @default(roofing)
  name          String
  event         NotificationEvent
  // Event-specific match conditions, e.g. { "stageId": "..." } or { "status": "in_production" }.
  conditions    Json              @default("{}")
  // Who receives it: { roles: Role[], userIds: string[], dynamic: string[] }
  // dynamic targets: assigned_rep | project_manager | customer | lead_creator | all_admins | all_managers
  recipients    Json              @default("{}")
  // Channels: ["in_app","email","sms"]
  channels      Json              @default("[\"in_app\"]")
  titleTemplate String
  bodyTemplate  String
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  notifications Notification[]

  @@index([companyId, event, active])
  @@map("notification_rules")
}

/// One "when X happens, do Y" rule.
///
/// Sibling of NotificationRule, deliberately NOT a column on it: a rule that
/// emails somebody and a rule that moves a deal through the pipeline have
/// different blast radii and different failure semantics, and sharing a table
/// would mean sharing a settings page.
model AutomationRule {
  id         String            @id @default(uuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical   Vertical          @default(roofing)
  name       String
  trigger    AutomationTrigger
  /// Trigger-specific match conditions:
  ///   stage_entered              { stageId }
  ///   photo_checklist_completed  { kind: "site" | "install" }
  ///   document_completed         { templateId }
  ///   stage_age_exceeded         { stageId, days }
  /// An empty object matches every occurrence of the trigger.
  conditions Json              @default("{}")
  /// ORDERED list of what to do: [{ type, ...config }]. The order IS the
  /// contract — a run stops at the first action that fails, so "compile the
  /// photos then move the stage" must never silently become the reverse.
  actions    Json              @default("[]")
  /// Run at most once per deal. Off = every time the trigger matches.
  once       Boolean           @default(true)
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  runs AutomationRun[]

  @@index([companyId, vertical, trigger, active])
  @@map("automation_rules")
}

/// A saved Pipeline filter: a named list of filter-builder conditions, private to
/// the person who made it or shared with everyone on this workspace's pipeline.
/// `conditions` is `[{ field, op, values }]`, the shape src/lib/pipeline-filters.ts
/// reads, and it is re-sanitised on every read. It holds no deal data: applying a
/// view filters deals the viewer could already see.
model PipelineFilterView {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: a roofing view names roofing stages and fields.
  vertical    Vertical @default(roofing)
  createdById String
  createdBy   User     @relation("PipelineFilterViewCreator", fields: [createdById], references: [id], onDelete: Cascade)
  name        String
  /// In everyone's Views menu, not just the creator's. Sharing needs Pipeline:update.
  shared      Boolean  @default(false)
  conditions  Json     @default("[]")
  /// How the conditions combine: "all" (AND) or "any" (OR). Read through sanitizeMatch.
  match       String   @default("all")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, vertical, shared])
  @@index([createdById])
  @@map("pipeline_filter_views")
}

/// One firing of one rule against one deal.
///
/// Not merely a log. It is how `once` is enforced (has this rule already
/// succeeded here?) and it is the ONLY place a silent automation becomes
/// visible to a human, which is why the per-action outcome is kept rather than
/// just a pass/fail.
///
/// A CHILD of AutomationRule — no vertical column — exactly like LeadStageEvent
/// is a child of Lead. It is only ever reached through a rule the isolation
/// extension has already scoped. See server/vertical/models.ts.
model AutomationRun {
  id         String              @id @default(uuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleId     String
  rule       AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a deal must not erase the record that an
  /// automation ran on it. Same reasoning as LeadStageEvent.stageId.
  leadId     String?
  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status     AutomationRunStatus
  /// Per-action outcome, in order: [{ type, ok, detail }].
  steps      Json                @default("[]")
  error      String?
  startedAt  DateTime            @default(now())
  finishedAt DateTime?

  @@index([companyId, startedAt])
  @@index([ruleId, leadId, status])
  @@map("automation_runs")
}

model Notification {
  id        String              @id @default(uuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId    String?
  rule      NotificationRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  event     NotificationEvent
  title     String
  body      String
  link      String?
  channel   NotificationChannel @default(in_app)
  read      Boolean             @default(false)
  readAt    DateTime?
  // Originating workspace, so the bell can say where a notification came from
  // and can be filtered to the workspaces its recipient is actually granted.
  // NULL = company-level (payroll, announcements) and shows in every workspace.
  //
  // Deliberately NOT a SCOPED model: the rule here is PERMISSION, not active
  // workspace. Someone granted both Roofing and Solar must receive both while
  // standing in either one, which is the opposite of what the isolation
  // extension does. Filtering is therefore explicit, via notificationScope().
  vertical  Vertical?           @map("industry")
  createdAt DateTime            @default(now())

  @@index([companyId, userId, read, createdAt])
  @@index([companyId, userId, vertical], map: "notifications_companyId_userId_industry_idx")
  @@map("notifications")
}

// --- Internal team chat ---------------------------------------------------

enum ConversationType {
  dm
  channel
}

model Conversation {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          ConversationType
  name          String? // channel name; null for DMs
  dmKey         String? // sorted "userA:userB" for DM uniqueness; null for channels
  createdById   String?
  createdBy     User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())

  members     ConversationMember[]
  messages    Message[]
  attachments FileAsset[]

  @@unique([companyId, dmKey])
  @@index([companyId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConvMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime     @default(now())

  attachments FileAsset[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --- Door-to-door canvassing (SalesRabbit-style) --------------------------

enum KnockDisposition {
  not_knocked // auto-generated address pin, blank state (hollow)
  not_home
  not_interested
  callback
  appointment
  sold
  not_qualified
  dnk // do not knock
}

model Territory {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical @default(roofing)
  name          String
  color         String   @default("#F4631E")
  polygon       Json // array of [lat, lng] pairs
  assignedRepId String?
  assignedRep   User?    @relation("TerritoryRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?    @relation("TerritoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  knocks Knock[]
  reps   TerritoryRep[]

  @@index([companyId])
  @@index([companyId, assignedRepId])
  @@map("territories")
}

// Join: one or more reps assigned to a territory (multi-rep). assignedRepId on
// Territory remains the "primary" rep; this table holds the full assigned set.
model TerritoryRep {
  id          String    @id @default(uuid())
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  userId      String // scalar tenancy/user key (query by userId for scoping)
  createdAt   DateTime  @default(now())

  @@unique([territoryId, userId])
  @@index([userId])
  @@map("territory_reps")
}

model Knock {
  id                  String           @id @default(uuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical            Vertical         @default(roofing)
  repId               String?
  rep                 User?            @relation("KnockRep", fields: [repId], references: [id], onDelete: SetNull)
  territoryId         String?
  territory           Territory?       @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  lat                 Float
  lng                 Float
  address             String?
  city                String?
  state               String?
  zip                 String?
  disposition         KnockDisposition @default(not_home)
  notes               String?
  // Optional homeowner contact captured at the door (for lead conversion).
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  bestTime            String? // best time to reach
  // Cached estimated property value (cents) so we don't re-bill the AVM API per click.
  propertyValue       Int?
  propertyValueSource String?
  propertyValueAt     DateTime?
  propertyData        Json? // full estimate snapshot (range, last sale, assessed, structure)
  // Homeowner skip-trace result (BatchData etc.). Cached so we don't re-bill per click.
  ownerSource         String? // provider label, e.g. "BatchData"
  ownerLookedUpAt     DateTime?
  ownerData           Json? // full result: { names[], phones[], emails[] } for the rep to pick from
  // When the dot was snapped to its OSM rooftop centroid (recenter-house-dots cron).
  recenteredAt        DateTime?
  appointmentAt       DateTime? // set when converted to an appointment
  leadId              String?
  lead                Lead?            @relation("KnockLead", fields: [leadId], references: [id], onDelete: SetNull)
  knockedAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  events KnockEvent[]

  @@index([companyId, repId])
  @@index([companyId, territoryId])
  @@index([companyId, lat, lng])
  @@map("knocks")
}

// AVM property-value cache. Keyed by normalized address (or "lat,lng" fallback)
// so estimates are reused across clicks/companies and we don't re-bill the API.
// Not tenant-scoped: a home's value is the same regardless of who looks it up.
model PropertyValue {
  id         String   @id @default(uuid())
  addressKey String   @unique // normalized address or "lat,lng"
  address    String?
  value      Int? // estimated value in cents; null = provider returned nothing
  source     String // provider label, e.g. "RentCast", "Estated", "ATTOM"
  confidence String? // high | medium | low
  matched    Boolean  @default(false) // did we confidently match a real parcel?
  data       Json? // full estimate: range, last sale, assessed, beds/baths/sqft/year
  asOfDate   DateTime // the estimate's as-of date
  fetchedAt  DateTime @default(now())

  @@map("property_values")
}

// Per-house timeline: status changes + timestamped comments (visit history / audit).
enum KnockEventType {
  created
  status_change
  comment
  contact_update
  lead_created
}

model KnockEvent {
  id          String            @id @default(uuid())
  companyId   String // scalar tenancy key (no relation needed for the audit log)
  knockId     String
  knock       Knock             @relation(fields: [knockId], references: [id], onDelete: Cascade)
  type        KnockEventType
  body        String? // comment / note text
  disposition KnockDisposition? // status at the time of the event
  authorId    String?
  authorName  String? // denormalized so history survives user deletion
  createdAt   DateTime          @default(now())

  @@index([companyId, knockId, createdAt])
  @@map("knock_events")
}

// Aerial roof-measurement report traced on the lead detail page. One per lead
// (re-editable). `facets` stores the traced geometry so it can be reopened.
// ---------------------------------------------------------------------------
// Bookkeeping (lightweight ledger: transactions → categories → P&L)
// ---------------------------------------------------------------------------

model BookkeepingCategory {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  // "income" | "expense" | "asset" | "liability" | "equity"
  type               String   @default("expense")
  // When true, approved transactions in this category are NOT counted as a deal's
  // job cost (e.g. "Contractor Sales" — sales-rep payouts, paid via the profit split).
  excludeFromJobCost Boolean  @default(false)
  createdAt          DateTime @default(now())

  transactions Transaction[]

  @@index([companyId, type])
  @@map("bookkeeping_categories")
}

// Vendors / contractors (one concept) — the managed list a transaction is tagged to.
model BookkeepingVendor {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Optional link to a team member (a sales rep paid as a 1099 contractor).
  // One vendor per user; reassignable to a different vendor.
  userId        String?  @unique
  name          String // display name
  companyName   String? // legal / company name
  contactName   String?
  email         String?
  phone         String?
  einTaxId      String? // EIN / Tax ID (1099)
  is1099        Boolean  @default(false)
  address       String?
  city          String?
  state         String?
  zip           String?
  accountNumber String? // our account # with this vendor
  notes         String?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@map("bookkeeping_vendors")
}

model Transaction {
  id               String               @id @default(uuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical         Vertical?
  date             DateTime
  description      String
  // Signed cents: positive = money in (income/deposit), negative = money out (expense).
  amountCents      Int
  vendor           String?
  account          String? // bank / ledger account name (e.g. "Operating Checking")
  categoryId       String?
  category         BookkeepingCategory? @relation(fields: [categoryId], references: [id])
  // Tag a transaction to a deal or invoice (scalar links; resolved in queries).
  projectId        String?
  invoiceId        String?
  status           String               @default("uncategorized") // uncategorized | categorized | reconciled
  // Review workflow: a new/imported txn is auto-suggested a category+vendor, shown
  // highlighted in "To review", and only booked once the user clicks Approve.
  approved         Boolean              @default(false)
  autoSuggested    Boolean              @default(false)
  source           String               @default("manual") // manual | import | bank | quickbooks
  externalId       String? // dedup key for imported/synced rows
  notes            String?
  createdById      String?
  attachments      FileAsset[] // receipts / invoices attached to this transaction
  // Bank reconciliation: when cleared against a statement, status="reconciled"
  // and these point at the reconciliation it was settled in.
  reconciledAt     DateTime?
  reconciliationId String?
  reconciliation   Reconciliation?      @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([companyId, date])
  @@index([companyId, categoryId])
  @@map("transactions")
}

// A completed bank reconciliation: a statement (account + date + ending balance)
// matched against cleared transactions. Kept for the audit trail + report PDF.
model Reconciliation {
  id                    String        @id @default(uuid())
  companyId             String
  account               String
  statementDate         DateTime
  endingBalanceCents    Int
  beginningBalanceCents Int
  clearedCount          Int           @default(0)
  createdById           String?
  createdAt             DateTime      @default(now())
  transactions          Transaction[]

  @@index([companyId, account])
  @@map("reconciliations")
}

// ---------------------------------------------------------------------------
// User onboarding (W-9 / 1099 + direct deposit + ID docs). SSN + account number
// are AES-encrypted at rest; only last-4 is kept in clear for display.
// ---------------------------------------------------------------------------
model UserOnboarding {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Identity
  legalFirstName    String?
  legalMiddleName   String?
  legalLastName     String?
  dateOfBirth       DateTime?
  ssnEnc            String?
  ssnLast4          String?
  address           String?
  city              String?
  state             String?
  zip               String?
  // Direct deposit
  accountHolderName String? // name as it appears on the bank account
  bankName          String?
  routingNumber     String?
  accountEnc        String?
  accountLast4      String?
  accountType       String? // "checking" | "savings"
  accountAddress    String? // address on the bank account (may differ from home)
  // Tax / W-9 (for 1099)
  taxClassification String? // individual | sole_prop | llc | s_corp | c_corp | partnership
  businessName      String?
  einEnc            String?
  einLast4          String?
  signatureName     String?
  signedAt          DateTime?
  // Document uploads (FileAsset ids). ID + SS card are front & back.
  idPhotoFileId     String? // driver's license / government ID — FRONT
  idPhotoBackFileId String? // driver's license / government ID — BACK
  ssnCardFileId     String? // Social Security card — FRONT
  ssnCardBackFileId String? // Social Security card — BACK
  voidedCheckFileId String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("user_onboarding")
}

// ── Knowledge Base / Training ──────────────────────────────────────────────
// Role-gated training library. A category is visible to a non-management user
// only when their role is listed in `visibleRoles`; management roles see all.

enum KnowledgeItemType {
  file // uploaded PDF / doc / image (FileAsset)
  video // embedded video URL (YouTube / Vimeo / Loom)
  link // external resource URL
  article // rich text written in-portal
}

model KnowledgeCategory {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vertical     Vertical        @default(roofing) @map("industry")
  name         String
  description  String?
  position     Int             @default(0)
  // Which roles may see this category. Management roles (super_admin/admin/manager)
  // always see every category regardless of this list.
  visibleRoles Role[]
  items        KnowledgeItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([companyId, vertical], map: "knowledge_categories_companyId_industry_idx")
  @@map("knowledge_categories")
}

model KnowledgeItem {
  id          String            @id @default(uuid())
  companyId   String
  categoryId  String
  category    KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type        KnowledgeItemType
  title       String
  description String?
  position    Int               @default(0)
  fileId      String? // FileAsset id when type=file (plain column, like UserOnboarding)
  url         String? // when type=video | link
  body        String?           @db.Text // when type=article
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId, categoryId])
  @@map("knowledge_items")
}

// ── Scope of Work / Job Profitability Calculator ───────────────────────────
// On-the-spot job costing: per line, what insurance pays vs. our cost → profit.
// 1:1 with the lead/deal (scope is known at "Scope Received", before a Project).

model ScopeOfWork {
  id                   String                   @id @default(uuid())
  companyId            String
  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId               String                   @unique
  lead                 Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vertical             Vertical                 @default(roofing) @map("industry")
  pdfFileId            String? // uploaded carrier scope PDF (FileAsset id, plain column)
  notes                String?
  // Public-adjuster fee, as a % of the supplement amount recovered (default 10%).
  // Used to net out the PA's cut when modeling "profit if we supplement".
  paFeePct             Float                    @default(10)
  // Estimated insurance deductible (cents). Informational only: of the RCV, the
  // homeowner pays this and the carrier pays the rest — it does NOT change the
  // profit pool. Used on the scope worksheet to show the insurance/homeowner split.
  estDeductibleCents   Int                      @default(0)
  // Selected pricing templates: cost/supplement per unit come from these (by
  // catalog item). Null = none selected. SetNull so deleting a template is safe.
  costTemplateId       String?
  costTemplate         ScopeCostTemplate?       @relation(fields: [costTemplateId], references: [id], onDelete: SetNull)
  supplementTemplateId String?
  supplementTemplate   ScopeSupplementTemplate? @relation(fields: [supplementTemplateId], references: [id], onDelete: SetNull)
  lines                ScopeLine[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([companyId, leadId])
  @@map("scopes_of_work")
}

model ScopeLine {
  id                  String            @id @default(uuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopeId             String
  scope               ScopeOfWork       @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  position            Int               @default(0)
  // Catalog link: when set, cost & supplement per unit come from the scope's
  // selected templates (matched by this id). Null = legacy free-text line that
  // keeps its inline costUnitPrice.
  catalogItemId       String?
  catalogItem         ScopeCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  category            String            @default("General")
  description         String            @default("")
  quantity            Float             @default(0)
  unit                String? // sq, sq ft, lf, ea
  insuranceUnitPrice  Int               @default(0) // cents — what the carrier currently ALLOWS per unit
  costUnitPrice       Int               @default(0) // cents — our cost per unit (legacy inline; templates override)
  // cents — legacy inline supplemented price; superseded by supplement templates.
  supplementUnitPrice Int               @default(0)
  createdAt           DateTime          @default(now())

  @@index([scopeId])
  @@index([catalogItemId])
  @@map("scope_lines")
}

// ── Estimate ────────────────────────────────────────────────────────────────
// What we would CHARGE for the job, priced line by line. Deliberately its own
// table rather than a mode of ScopeOfWork: a scope line carries the carrier's
// allowed price and our cost, and exists only once a carrier scope has been
// received on an insurance claim. An estimate carries a SELL price, exists on
// cash deals too, and is available from the moment the deal is created — it is
// how a job gets priced before (or without) any carrier involvement.
model Estimate {
  id             String             @id @default(uuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical       Vertical           @default(roofing)
  leadId         String             @unique
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Optional cost price list, so management can read margin while the estimate
  // is being built. SetNull so deleting a template never deletes an estimate.
  costTemplateId String?
  costTemplate   ScopeCostTemplate? @relation(fields: [costTemplateId], references: [id], onDelete: SetNull)
  // Whole-estimate discount (cents), taken off the subtotal.
  discountCents  Int                @default(0)
  notes          String?
  lines          EstimateLine[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId, leadId])
  @@map("estimates")
}

model EstimateLine {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimateId     String
  estimate       Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  position       Int               @default(0)
  // Catalog link: when set, our cost per unit comes from the estimate's selected
  // cost template. Null = a one-off line typed by hand.
  catalogItemId  String?
  catalogItem    ScopeCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  category       String            @default("General")
  description    String            @default("")
  quantity       Float             @default(0)
  unit           String?
  // cents per unit — what we CHARGE. The one number that makes this table
  // different from a scope line.
  unitPriceCents Int               @default(0)
  createdAt      DateTime          @default(now())

  @@index([estimateId])
  @@index([catalogItemId])
  @@map("estimate_lines")
}

model ScopeTemplateItem {
  id                         String   @id @default(uuid())
  companyId                  String
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vertical                   Vertical @default(roofing) @map("industry")
  position                   Int      @default(0)
  category                   String   @default("General")
  description                String   @default("")
  unit                       String?
  defaultInsuranceUnitPrice  Int      @default(0) // cents
  defaultCostUnitPrice       Int      @default(0) // cents
  defaultSupplementUnitPrice Int      @default(0) // cents — supplemented price per unit
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([companyId, vertical], map: "scope_template_items_companyId_industry_idx")
  @@map("scope_template_items")
}

// Master scope catalog — the company-wide list of possible insurance-restoration
// line items. NO pricing (cost/supplement/insurance prices live in versioned
// templates + the project scope). Organized by category → subcategory, filterable
// by trade.
model ScopeCatalogItem {
  id                    String   @id @default(uuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical              Vertical @default(roofing)
  position              Int      @default(0)
  category              String   @default("General")
  subcategory           String   @default("")
  description           String   @default("")
  unit                  String   @default("EA") // SQ | SF | LF | EA | DAY | SYSTEM | PERCENT | HR
  trade                 String   @default("General")
  isCommonInsuranceItem Boolean  @default(false)
  isSupplementEligible  Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  costTemplateItems       ScopeCostTemplateItem[]
  supplementTemplateItems ScopeSupplementTemplateItem[]
  scopeLines              ScopeLine[]
  estimateLines           EstimateLine[]

  @@index([companyId, trade])
  @@index([companyId, category])
  @@map("scope_catalog_items")
}

// ── Versioned pricing templates over the master catalog ─────────────────────
// Cost Templates and Supplement Templates are independent, dated price lists
// that reference catalog items by id. Editing a template price never touches the
// master catalog. A Project's Scope of Work (sub-project 2) selects one of each
// to compute internal cost and supplement potential.

model ScopeCostTemplate {
  id            String                  @id @default(uuid())
  companyId     String
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical                @default(roofing)
  name          String
  description   String?
  effectiveDate DateTime                @default(now())
  isActive      Boolean                 @default(true)
  items         ScopeCostTemplateItem[]
  scopes        ScopeOfWork[]
  estimates     Estimate[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([companyId])
  @@map("scope_cost_templates")
}

model ScopeCostTemplateItem {
  id               String            @id @default(uuid())
  companyId        String
  templateId       String
  template         ScopeCostTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItemId    String
  catalogItem      ScopeCatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  costPerUnitCents Int               @default(0)
  createdAt        DateTime          @default(now())

  @@unique([templateId, catalogItemId])
  @@index([templateId])
  @@map("scope_cost_template_items")
}

model ScopeSupplementTemplate {
  id            String                        @id @default(uuid())
  companyId     String
  company       Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical                      @default(roofing)
  name          String
  description   String?
  effectiveDate DateTime                      @default(now())
  isActive      Boolean                       @default(true)
  items         ScopeSupplementTemplateItem[]
  scopes        ScopeOfWork[]
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([companyId])
  @@map("scope_supplement_templates")
}

model ScopeSupplementTemplateItem {
  id                     String                  @id @default(uuid())
  companyId              String
  templateId             String
  template               ScopeSupplementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItemId          String
  catalogItem            ScopeCatalogItem        @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  supplementPerUnitCents Int                     @default(0)
  reason                 String?
  requiredEvidence       String?
  notes                  String?
  createdAt              DateTime                @default(now())

  @@unique([templateId, catalogItemId])
  @@index([templateId])
  @@map("scope_supplement_template_items")
}

// Customer-facing roofing proposal / presentation (web-first, shareable link).
enum ProposalStatus {
  draft
  generated
  sent
  viewed
  signed
}

model Proposal {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical        Vertical       @default(roofing)
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId       String? // set if production has started
  status          ProposalStatus @default(draft)
  // Unguessable public token = the shareable customer link (/present/[token]).
  publicToken     String         @unique
  theme           String         @default("anexa")
  customerName    String // snapshot at create
  propertyAddress String // snapshot at create
  // Editable copy + selections live here: roofType, damageSummary,
  // recommendedNextStep, dateOfLoss, conditionFlags{}, photoCaptions{},
  // includedPhotoIds[], upgrades[], selectedSections[], faq[], whyAnexa[],
  // financialNote. See src/lib/proposal.ts ProposalContent.
  content         Json
  createdById     String
  createdBy       User           @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  viewedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId, leadId])
  @@map("proposals")
}

// Binary file storage when STORAGE_DRIVER=db: bytes live in Postgres so uploads
// work with no external object store. Keyed by the same storage key the S3/local
// drivers use, so switching drivers later needs no call-site changes.
model StoredFile {
  key         String    @id
  data        Bytes
  size        Int
  contentType String?
  createdAt   DateTime  @default(now())
  /// When these bytes were first observed with no FileAsset row pointing at
  /// them — the start of the 30-day retention window, not the age of the file.
  ///
  /// The distinction is the whole point. `createdAt` is when the bytes were
  /// written, which for a two-year-old document deleted yesterday is two years
  /// ago; purging on that would delete it immediately, which is the exact
  /// mistake a grace period exists to prevent. `scripts/storage-orphans.ts`
  /// stamps this on its first sweep and only deletes on a later one.
  ///
  /// Cleared if a row ever points at the key again, so a restored reference
  /// restarts the clock rather than inheriting a countdown.
  orphanedAt  DateTime?

  @@map("stored_files")
}

// ---------------------------------------------------------------------------
// Storm Intelligence — NOAA Storm Events + SPC reports for canvassing targeting.
// Tenancy via scalar companyId (no Company relation, like KnockEvent — these are
// imported/derived datasets). Geospatial via lat/lng + in-app Haversine (no PostGIS).
// ---------------------------------------------------------------------------

enum StormSource {
  noaa_storm_events
  spc_reports
}

enum StormType {
  hail
  wind
  tornado
}

model StormEvent {
  id           String      @id @default(uuid())
  companyId    String
  source       StormSource
  externalId   String? // NOAA EVENT_ID or SPC composite key — idempotent re-import
  type         StormType
  eventAt      DateTime
  lat          Float
  lng          Float
  hailSizeIn   Float? // hail diameter, inches
  windSpeedMph Int? // wind gust, mph
  tornadoScale String? // EF/F rating, e.g. "EF1"
  magnitude    Float? // raw source magnitude
  city         String?
  county       String?
  state        String?
  zip          String?
  narrative    String?
  raw          Json? // original imported row
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, source, externalId])
  @@index([companyId, type])
  @@index([companyId, eventAt])
  @@index([companyId, lat, lng])
  @@map("storm_events")
}

model StormCanvassingZone {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  centerLat       Float
  centerLng       Float
  radiusMiles     Float    @default(1)
  filtersSnapshot Json? // {types, from, to, minHailIn, minWindMph} used to build it
  eventCount      Int      @default(0)
  totalScore      Int      @default(0)
  assignedRepId   String?
  territoryId     String? // canvassing Territory spawned from this zone
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, assignedRepId])
  @@map("storm_canvassing_zones")
}

model PropertyStormMatch {
  id             String    @id @default(uuid())
  companyId      String
  leadId         String? // set for lead matches (knockId null)
  knockId        String? // set for knock matches (leadId null)
  lat            Float
  lng            Float
  nearestEventId String?
  distanceMiles  Float     @default(0)
  dateOfLoss     DateTime? // most recent significant event nearby
  score          Int       @default(0)
  eventCount     Int       @default(0)
  maxHailIn      Float?
  maxWindMph     Int?
  computedAt     DateTime  @default(now())

  @@unique([companyId, leadId])
  @@unique([companyId, knockId])
  @@index([companyId, score])
  @@map("property_storm_matches")
}

// Radar-derived hail swath polygons (NOAA MRMS MESH daily-max). Universal radar
// data — NOT tenant-scoped (same for everyone), like PropertyValue. One row per
// polygon feature; `rings` holds [lat,lng] coords ready for Leaflet. A bbox is
// stored for cheap region prefiltering.
model StormSwath {
  id         String   @id @default(uuid())
  source     String   @default("mrms_mesh")
  eventDate  DateTime // UTC day of the daily-max swath
  hailMinIn  Float // size-tier lower bound, inches
  rings      Json // [ [ [lat,lng], ... ] (outer), [hole], ... ]
  bboxMinLat Float
  bboxMinLng Float
  bboxMaxLat Float
  bboxMaxLng Float
  createdAt  DateTime @default(now())

  @@index([eventDate])
  @@index([bboxMinLat, bboxMaxLat])
  @@map("storm_swaths")
}

// ---------------------------------------------------------------------------
// Solar domain
//
// Everything below is solar-only. Roofing never creates these rows and never
// renders them; the roofing-only concepts (Claim, the insurance
// scope) are HIDDEN for solar deals rather than dropped, because those tables
// hold live roofing money.
// ---------------------------------------------------------------------------

/// The four financing products. They are NOT variations of one model — they
/// price differently, they carry different fields, and they pay commission on
/// different bases. Treating them as one is how a lease gets quoted with a
/// loan's dealer fee.
enum FinanceProduct {
  /// Customer pays cash. No dealer fee. Priced on system price / PPW.
  cash
  /// Financed purchase. A dealer fee is embedded in the GROSS price; net PPW is
  /// gross minus that fee. Commission on PPW or margin.
  loan
  /// Third party owns the system; customer pays a fixed monthly with an annual
  /// escalator. There is no system price in the cash/loan sense.
  lease
  /// Third party owns the system; customer pays per kWh produced, with an
  /// annual escalator.
  ppa
}

enum CreditStatus {
  not_submitted
  submitted
  approved
  /// Approved subject to stipulations that must be cleared before NTP.
  conditional
  declined
  expired
}

enum MountType {
  roof
  ground
}

/// Catalog item kinds. Adders are rank-ordered so a rep sees them in the order
/// the company wants them sold.
enum SolarEquipmentKind {
  module
  inverter
  battery
  adder
}

/// Per-company Solar assumptions. Deliberately DATA, not code.
///
/// The federal residential-solar credit changed in 2025 and is still moving, so
/// the percentage lives here for the company's CPA to set and change without a
/// deploy. Everything it produces is an ESTIMATE and is labelled as one.
model SolarSettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ── Production assumptions ──────────────────────────────────────────────
  /// System losses (soiling, wiring, inverter, mismatch). 0.84 = 16% loss.
  derateFactor         Float @default(0.84)
  /// Annual production loss from panel ageing, for the 25-year model.
  annualDegradationPct Float @default(0.5)
  /// Assumed annual utility rate rise, for the savings comparison.
  utilityEscalationPct Float @default(3.5)
  /// kWh produced per kW-DC per year in this market. Set from local irradiance.
  kwhPerKwYear         Int   @default(1450)
  /// The utility's fixed monthly charge in CENTS — meter, service, connection.
  ///
  /// Billed whatever the roof produces, so it is added to the post-solar bill
  /// and never allows it to reach $0. Not added to the pre-solar side: that is
  /// derived from the customer's own bill, which already contained the fee.
  utilityMeterFeeCents Int   @default(1000)
  /// RETIRED, and read by nothing. It used to size a target system from usage
  /// alone, which cannot be done: what a kW makes on a roof depends on how its
  /// planes face, their pitch and what shades them. Size now comes out of the
  /// array a rep draws. Column kept so no migration is needed to drop it.
  targetOffsetPct      Float @default(100)

  // ── Pricing defaults ────────────────────────────────────────────────────
  /// Default gross price per watt, in cents (e.g. 350 = $3.50/W).
  defaultGrossPpwCents Int   @default(350)
  /// Lender dealer fee as a % of gross. Applies to LOAN only — cash has none.
  /// The fallback when a deal quotes no lender product; a product's own fee wins.
  defaultDealerFeePct  Float @default(18)
  /// What the company must keep per watt after the lender's cut, cents.
  ///
  /// Set this and the sticker is DERIVED from the chosen product's dealer fee —
  /// `gross = net / (1 - fee)` — so moving a deal onto cheaper money raises the
  /// price instead of quietly costing margin. Null = derive nothing and leave
  /// gross exactly as typed, which is how every existing company behaves until
  /// somebody sets it.
  targetNetPpwCents    Int?

  // ── Incentives — RETIRED ────────────────────────────────────────────────
  /// No incentive is quoted anywhere: nothing sets these, nothing reads them,
  /// and saving solar settings force-nulls the first two. Kept as columns
  /// rather than dropped so historic rows stay readable; delete them only in a
  /// migration that also rewrites the proposals which referenced them.
  federalItcPct       Float?
  stateIncentiveNote  String?
  incentiveDisclaimer String  @default("Estimated only and not a guarantee. Tax credits depend on your individual tax situation and on rules that may change. Consult your tax advisor.")

  // ── Federal credits, for the contract-adjustment ladder ─────────────────
  /// The three percentages the "what you actually pay" page is worked out
  /// from. STATUTE, which is why they are the company's to state rather than
  /// constants: the base credit has already stepped down twice and the two
  /// bonuses were invented in 2022.
  ///
  /// They decide the credit ladder printed under the price on every purchase
  /// proposal, and nothing else in the product quotes an incentive.
  creditItcPct             Float  @default(30)
  creditEnergyCommunityPct Float  @default(10)
  creditDomesticContentPct Float  @default(10)
  /// What the leftover between the after-credit figure and the quoted price is
  /// CALLED. The figure itself is always derived and can never be typed.
  creditIncentiveLabel     String @default("Incentive for signing today")
  /// The caveat printed under the ladder. Defaulted rather than demanded: an
  /// unworded version of this is not a blank space, it is a page of credit
  /// figures with nothing qualifying them.
  creditDisclaimer         String @default("Tax credits are claimed on your own federal return and depend on your tax liability and on your eligibility for each credit shown. They are not a discount applied by us and they are not a guarantee. We are not tax advisers — please confirm with your tax professional.")

  // ── Impact assumptions ──────────────────────────────────────────────────
  /// Estimated increase in home value from an OWNED system, as a % of the
  /// property's value. Data, like every other number a homeowner reads: the
  /// published studies disagree (Berkeley Lab ~4.1%, Zillow ~4.1%, and both
  /// vary by market), so the figure a company is willing to stand behind is
  /// the company's to set. Zero means the claim is not made at all and the
  /// card is omitted rather than printed as "0%".
  homeValueUpliftPct Float @default(0)

  // ── Equipment defaults ──────────────────────────────────────────────────
  /// How many batteries land on a design the moment a rep picks one.
  ///
  /// A quantity nobody typed used to be read as ONE everywhere, which is the
  /// wrong answer for a company whose standard offer is two: the second unit
  /// was quoted for free and the battery programme paid for one. So the count
  /// is the company's to state, and picking a battery writes it.
  ///
  /// Only ever applied to a design with NO battery on it — swapping a chosen
  /// battery for another model keeps whatever quantity a rep deliberately set.
  ///
  /// STILL LOAD-BEARING with `autoBatteryQty` on: it is what a deal starts with
  /// in the window before the figures auto-sizing needs exist at all — storage
  /// set on a deal whose Energy step is still blank has neither production nor
  /// usage to size from. The count corrects itself on the first recompute that
  /// has something to work with.
  defaultBatteryQty Int @default(2)

  /// Size the battery count to the home's night load instead of quoting a flat
  /// `defaultBatteryQty` on every job.
  ///
  ///     night kWh/day = year-1 production ÷ 365 × batteryNightSharePct
  ///     batteries     = ceil(night kWh/day ÷ the battery's usable kWh)
  ///
  /// The count then FOLLOWS the array: a roof redrawn from 20,000 to 34,000
  /// kWh moves the storage with it, which a flat two never did. A rep who types
  /// their own count keeps it — see `SolarDesign.batteryQtySetByRep`.
  ///
  /// Off by default, because turning it on changes what every storage deal in
  /// the pipeline quotes and that is a decision somebody makes, not one that
  /// arrives with a deploy.
  autoBatteryQty       Boolean @default(false)
  /// What share of a day's kilowatt-hours the house draws after dark, %.
  ///
  /// The whole of auto-sizing rests on this one number and it is MODELLED, not
  /// metered — which is exactly why it is a company decision on a settings
  /// screen rather than a constant in the sizing code. Same discipline as
  /// `touPeakSharePct` below, and the same reason.
  batteryNightSharePct Float   @default(55)

  // ── Storage assumptions ─────────────────────────────────────────────────
  /// How much more than its yearly average a house is assumed to draw while the
  /// grid is down, as a multiplier.
  ///
  ///     average W = the deal's annual kWh × 1000 ÷ 8760
  ///     outage W  = average × this
  ///
  /// REPLACED the company's list of named backup load profiles, which sold
  /// "Essentials / Essentials + AC / Whole home" as coverage tiers. Every
  /// install here is whole-home backup, so the tiers described a product nobody
  /// offers — and one company-wide wattage quoted a condo and a four-bedroom
  /// house the same hours off the same stack. The home's own usage is already
  /// on the deal and is a better divisor than a number typed once in Settings.
  ///
  /// Above 1 because an outage is not an average moment: the power goes out in
  /// a heatwave with the AC running, and dividing by the bare average would
  /// overpromise. MODELLED, not metered, which is exactly why the company states
  /// it and every document carries the figure it was worked out from — the same
  /// discipline as `touPeakSharePct` below.
  backupOutageDrawFactor Float @default(1.3)

  /// What share of a day's kWh falls inside the peak window, %.
  ///
  /// MODELLED, not measured, and the softest number in a storage quote — which
  /// is why it is a company decision listed on the customer's document rather
  /// than a constant buried in code. The same discipline as every assumption
  /// above it.
  touPeakSharePct        Float @default(30)
  /// How many times a day the battery is cycled.
  touCyclesPerDay        Float @default(1)
  /// What survives a charge/discharge round trip, %.
  touRoundTripEfficiency Float @default(90)

  // ── Validation bounds ───────────────────────────────────────────────────
  // A rep must not be able to generate a physically impossible proposal.
  // These are the guard rails; see src/lib/solar-validation.ts.
  minOffsetPct Float @default(0)
  maxOffsetPct Float @default(150)

  // ── RETIRED 2026-09-02: the company-wide Min/Max $/W band ───────────────
  // Nothing reads or writes these any more. What a deal may price at is a
  // property of the LOAN PRODUCT, not of the app: one universal band was asked
  // about three different numbers as pricing grew caps, flat partners and
  // adders, and each time it silently blocked real deals — an Amos job over
  // about $4,700 of extra work could not be generated at all, with no box a
  // rep could change. The floor lives per partner now, on
  // SolarLender.minBasePpwCents, beside the ceiling it has to clear.
  //
  // The columns are kept rather than dropped: they hold every company's last
  // stated band, which is the only record of what was being enforced before,
  // and dropping two NOT NULL columns off a live table buys nothing back.
  // DO NOT re-wire them. Add a per-lender rule instead.
  minPpwCents Int @default(150)
  maxPpwCents Int @default(800)

  updatedAt DateTime @updatedAt

  @@map("solar_settings")
}

/// How reps are paid on one lender's deals.
///
/// DATA, not a name check. Amos Capital Funding is simply the first partner
/// switched to per_watt; the second one needs no deploy. Hardcoding
/// `name === "Amos"` would flip every rep back onto redline pay the day somebody
/// renames the lender to "Amos Capital" -- silently, and mid-quarter.
/// How the company adjusts a rep's solar commission on a COMPANY-PROVIDED lead.
/// Exactly one method per rep — never both. `none` is the default and means the
/// rep keeps everything whatever the lead's origin.
enum SolarLeadAdjustMode {
  none
  /// The company keeps a PERCENTAGE of the rep's commission.
  percentage
  /// The company deducts a FLAT dollar amount from the rep's commission.
  flat
}

/// How ONE REP is paid on a battery-only job. A property of the REP, not of the
/// lender: two reps selling the same battery through the same partner can be on
/// different plans, and the lender's own battery pricing exists for pricing, not
/// for deciding anybody's pay.
enum SolarBatteryPayPlan {
  /// Selling price minus the company's battery cost. The rep keeps the margin.
  margin
  /// A flat amount per installed battery, whatever it sells for.
  flat
}

enum SolarRepPayMode {
  /// The rep sells against their own redline and keeps every cent above it.
  redline
  /// The rep earns their fixed $/W rate whatever the deal prices at.
  per_watt
}

/// How reps are paid on a job that sells STORAGE ONLY.
///
/// A separate enum from SolarRepPayMode and not a third value on it, because a
/// lender holds both opinions at once and they are routinely different: Amos
/// pays a fixed $/W on an array while pricing storage as a flat $10,000 a
/// battery. Folding them together would force one answer to stand for both.
///
/// The reason this exists at all: every value of SolarRepPayMode is denominated
/// in WATTS, and a storage job has none. Before this column a battery-only deal
/// on a per-watt partner produced no commission line whatsoever -- the resolver
/// refused it, correctly, because nothing in the data could say what the rep
/// was owed. This is what says it.
enum SolarBatteryPayMode {
  /// The rep keeps everything the deal holds above their own net $/battery.
  redline
  /// The rep earns a flat amount per installed battery, whatever it prices at.
  flat
}

/// What a deal is SELLING.
///
/// `pv` and `pv_storage` take the IDENTICAL code path everywhere. The
/// distinction is the rep's vocabulary and the thing the storage-only filters
/// test against; only `storage` branches. Written down because a three-value
/// enum where two values are meant to behave alike is exactly the shape that
/// drifts apart later, one `if` at a time.
enum SolarSystemType {
  pv
  pv_storage
  storage
}

/// How a partner's SIGN TODAY CREDIT is arrived at.
///
/// The credit itself is not the lender's money — it comes off what the
/// household nets, never off the price, and the partner funds the same
/// contract either way. What differs partner by partner is what we are
/// permitted to hand back, and these are the three answers.
enum SolarSignTodayMode {
  /// NO RULE, and the default: the rep types whatever he is offering on the
  /// deal, which is exactly what every lender did before this column existed.
  none
  /// A FIGURE THIS PARTNER GIVES. Automatic on every deal written on it, not
  /// editable and not removable — it is the partner's own offer, not the
  /// rep's, and a rep who could switch it off could quietly keep it.
  fixed
  /// WHATEVER THE SYSTEM IS PRICED ABOVE A CAP. Derived, never typed: price a
  /// deal above the partner's figure and the excess is what the household is
  /// handed back for signing today. Priced at or under it, there is nothing to
  /// give and no row is shown.
  above_cap
}

/// How a partner's stated price per watt behaves.
enum SolarFinalPpwMode {
  /// A CEILING. Price the deal the ordinary way -- base grossed up by the fee
  /// -- and hold the contract down to this figure only if it comes out above.
  /// A cheaper deal quotes cheaper.
  cap
  /// A FIXED PRICE. This partner's paper is this figure per watt and nothing
  /// moves it: not the base a rep types, not the adders on the job, not the
  /// size of the array. Amos Capital Fund sells this way -- $5.50/W, and the
  /// only thing a rep chooses is which of their products to write it on.
  ///
  /// The base stops being an input here and becomes an OUTPUT: what is left of
  /// the company's share once the partner has taken its cut and the extra work
  /// has been paid for.
  flat
}

/// Which rung of the price ladder a partner's figure is a price FOR.
enum SolarPriceBasis {
  /// System + adders, dealer fee INCLUDED. The figure is what the homeowner
  /// signs. The only rule before this enum existed.
  final
  /// System + adders, dealer fee added ON TOP. Extra work comes out of the base.
  gross
  /// The system alone, dealer fee added ON TOP. Extra work rides above it too.
  base
}

/// WHICH FIGURE A PARTNER UNDERWRITES.
///
/// A priced solar deal carries several defensible "amounts" and they can differ
/// by six figures. Which one a lender's paper is written at is a fact about the
/// PARTNER, not about the deal, so it belongs on the lender row rather than in
/// code:
///
///   contract_value       the value the partner's own paper is written at.
///                        What every lender received before this column
///                        existed.
///   customer_obligation  what the household is actually liable for. The same
///                        figure as the contract value on every partner today,
///                        and a member kept for one that writes its paper
///                        otherwise.
///   after_credits        the contract value less the federal credits the
///                        proposal quotes. Only correct where a partner
///                        underwrites the post-incentive balance, which is
///                        unusual: the homeowner claims those on their own
///                        return, months later, and the loan is written for
///                        the whole amount in the meantime.
enum SolarSubmissionAmountBasis {
  contract_value
  customer_obligation
  after_credits
}

/// WHAT A PARTNER MEANS BY "ESTIMATED SAVING".
///
///   utility_avoided  the electricity bill that stops arriving. Always
///                    positive on a system that generates anything.
///   net_of_payment   that, less what the system costs the household this
///                    year. Frequently NEGATIVE on a thirty-year loan, which
///                    a partner whose schema has no minus sign cannot accept —
///                    so this setting can make most deals unsubmittable, and
///                    the screen says so.
enum SolarSubmissionSavingBasis {
  utility_avoided
  net_of_payment
}

/// WHICH YEAR'S SAVING, on a comparison that runs for decades.
///
///   year_one      the first twelve months. What every submission sent before
///                 this existed, and the SMALLEST reading — the utility side
///                 escalates, so every later year is larger.
///   term_average  the same subtraction averaged across the whole comparison
///                 horizon, which follows the loan term. The right answer for
///                 a partner whose form asks what the household saves "a year"
///                 over the life of the loan rather than in its first.
///
/// The default is deliberately the smaller figure. Overstating a saving on a
/// credit application is the direction that does harm, so an unrecognised
/// value falls back here rather than to the average — see `savingOnBasis`.
enum SolarSubmissionSavingHorizon {
  year_one
  term_average
}

/// WHOSE NAME GOES ON THE APPLICATION AS THE SELLER.
///
/// Every partner asks for one and they do not mean the same person by it.
///
///   deal_rep   the rep assigned to the deal, falling back to whoever caused
///              the submission. What was always sent.
///   submitter  the person who pressed the button, whatever the deal says.
///              For a partner that reconciles the name against its own portal
///              logins rather than against a roster.
///   fixed      one name typed on this partner, every time — the dealer
///              contact some partners register and will not accept a deviation
///              from. Falls back to `deal_rep` when nobody has typed one.
enum SolarSubmissionRepNameBasis {
  deal_rep
  submitter
  fixed
}

/// WHETHER THE RESPONSE CARRIES THE COMPLETION LINK.
///
/// BOTH VALUES EMAIL AND TEXT THE HOUSEHOLD — the partner's invitation always
/// goes out and there is no way to suppress it. The only difference is whether
/// the link ALSO comes back in the response, which is what lets a rep hand
/// their own device to the customer sitting in front of them.
///
///   in_person  the link comes back. What was always sent.
///   customer   it does not, for a partner whose rules say the household must
///              complete the application on its own device.
enum SolarSubmissionDelivery {
  in_person
  customer
}

/// Whether a partner's paper will fund an array with no battery on it.
///
/// A rule about the LENDER, because that is where it actually lives. Some
/// partners fund grid-tied PV all day; some will not write a loan without
/// storage on the job. Before this the app held one opinion for everybody --
/// a note on every batteryless design saying the proposal would tell the
/// homeowner their system shuts off in an outage -- which is true, and is also
/// not something an admin could switch off for the lenders it does not apply
/// to, or make binding for the ones it does.
enum SolarLenderBatteryRule {
  /// The partner does not care. Nothing is said and nothing is stopped.
  optional
  /// THE DEFAULT, and exactly what every lender did before this column existed:
  /// a batteryless design is flagged on the readiness report and generates
  /// anyway. Chosen as the default so this migration re-prices and re-gates
  /// nothing.
  warn
  /// This partner will not fund an array without storage. Generation is
  /// blocked, the same way a missing layout is -- a proposal quoting paper the
  /// lender will decline is a proposal that gets found out at submission.
  required
}

/// A finance partner whose approved-vendor list constrains what can be sold.
///
/// Managed data, not free text: the whole point is that a rep picks "Credit
/// Human" from a list and the equipment selectors narrow to what Credit Human
/// actually approves. Free text cannot do that — "Credit Human", "credit human"
/// and "CreditHuman" would be three different lenders.
///
/// Distinct from CreditApplication.lender, which records who we actually
/// submitted a credit file to. This one is the lender the SYSTEM is being
/// designed for, which is a decision made before any application exists.
model SolarLender {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)

  name           String
  /// Retired rather than deleted, for the same reason equipment is: designs
  /// point at it, and last year's deals have to keep explaining themselves.
  isActive       Boolean             @default(true)
  /// How reps are paid on this lender's deals -- see SolarRepPayMode.
  repPayMode     SolarRepPayMode     @default(redline)
  /// How reps are paid on this lender's BATTERY-ONLY deals -- see
  /// SolarBatteryPayMode. Deliberately its own column: the field above is
  /// measured in watts and a storage job has none, so it cannot reach one.
  ///
  /// `redline` is the default and is what the resolver already assumed of every
  /// lender it could answer for, so no existing lender changes behaviour.
  batteryPayMode SolarBatteryPayMode @default(redline)
  /// Display order, so the lenders you use most lead.
  rank           Int                 @default(0)
  notes          String?

  /// The most this partner's paper ever puts in front of a homeowner, per
  /// installed watt, in cents -- DEALER FEE AND ADDERS INCLUDED. 550 = $5.50/W.
  ///
  /// Every other lender prices one way: the company's base $/W is grossed up by
  /// the fee, and whatever comes out is what the customer signs. A partner like
  /// Amos runs the other way round -- their paper is a flat $5.50/W to the
  /// homeowner and the fee is simply how much of it they keep -- and priced the
  /// normal way a 65% fee stickers a $5.68/W base at $16.23/W, which is not a
  /// number that partner has ever funded.
  ///
  /// So this is a CEILING on the contract, not on the sticker: adders gross up
  /// by the fee exactly as they always did, and the system price absorbs
  /// whatever is left under the cap. Which is why adding work here lowers what
  /// the company keeps instead of raising what the customer pays.
  ///
  /// Null -- the default and every lender until somebody sets one -- means no
  /// cap, and nothing about that lender's pricing changes.
  maxFinalPpwCents Int?

  /// Whether the figure above is a ceiling or the price itself.
  ///
  /// `cap` is the default and what every lender did before this existed, so
  /// setting nothing changes nothing. `flat` is for a partner like Amos whose
  /// paper is one number per watt whatever is on the job -- see
  /// SolarFinalPpwMode. Ignored entirely when `maxFinalPpwCents` is null,
  /// because a mode with no figure to apply is not a pricing rule.
  finalPpwMode SolarFinalPpwMode @default(cap)

  /// The least this partner's deals may leave the company, per installed watt,
  /// in cents, BEFORE its cut. 175 = $1.75/W.
  ///
  /// The mirror of the ceiling above, and deliberately not its twin: that one
  /// caps what the CUSTOMER signs, this one floors what the COMPANY keeps. A
  /// margin guard, in other words -- the number a discount erodes.
  ///
  /// Tested against what is actually kept, not against what a rep typed. On a
  /// capped lender those differ: Amos funds $5.50/W at a 65% fee, so whatever
  /// base is typed, the cap solves the sticker down and $1.93/W is all that can
  /// ever survive it. A floor checked against the typed figure would pass a
  /// deal that netted a third of it.
  ///
  /// Null -- the default, and every lender until somebody sets one -- means no
  /// floor, and no deal that generates today stops generating.
  minBasePpwCents Int?

  /// The storage twins of the three fields above. Null means no rule — the
  /// default, and every lender until somebody sets one.
  minBasePricePerBatteryCents  Int?
  maxFinalPricePerBatteryCents Int?
  finalBatteryPriceMode        SolarFinalPpwMode @default(cap)

  /// Whether this partner funds an array with no battery -- see
  /// SolarLenderBatteryRule. `warn` is the default and is what every lender did
  /// before the column existed.
  batteryRule SolarLenderBatteryRule @default(warn)

  /// Whether this partner's dealer fee is taken on a BATTERY beside an array, as
  /// it is on the system and the ordinary adders. On -- the default -- the
  /// battery grosses up by the programme's fee like everything before it on the
  /// ladder, so the fee is a share of the whole final price. Off, it rides on
  /// top at its catalogue price, which is how every lender priced before
  /// 2026-09-14. A storage-only deal is unaffected: there the battery IS the
  /// system and was always inside the fee.
  batteryInsideFee Boolean @default(true)

  /// How the sign today credit is arrived at on this partner's deals -- see
  /// SolarSignTodayMode. `none` is the default, and leaves the per-deal box
  /// exactly as it was.
  signTodayMode        SolarSignTodayMode @default(none)
  /// `fixed` mode: what this partner gives, in cents. 150000 = $1,500.
  signTodayFixedCents  Int?
  /// `above_cap` mode: the cap, in cents per installed watt. 500 = $5.00/W.
  ///
  /// MEASURED ON THE SYSTEM PRICE — the array at sticker, fee included, adders
  /// and battery excluded — because those two are work and hardware the
  /// household is being charged for, not margin anybody can give away. A cap
  /// read against the whole contract would turn a $120,000 battery into a
  /// $120,000 discount.
  signTodayCapPpwCents Int?

  /// Where YOUR team runs credit for this partner — the dealer portal login.
  /// Rep-facing only: it never reaches a customer-facing document.
  portalUrl          String?
  /// The customer-facing application link. This, and only this, is what the
  /// proposal's Qualify button opens, which is why it is a separate column
  /// from `portalUrl` rather than one "link" field used for both. Confusing
  /// them would put your dealer portal in front of a homeowner.
  applyUrl           String?
  /// How to run credit with this partner, in your own words. Free text because
  /// every lender's process is different and none of them fit a schema.
  creditInstructions String?

  /// The partner's own logo, as bytes we hold rather than a link to their site.
  /// Hotlinking a bank's image would put a document a homeowner keeps at the
  /// mercy of someone else's URL, and this one has to still render a year from
  /// now. Normalised to PNG on the way in, so no mime column is needed.
  logoKey       String?
  /// When the logo last changed — the cache-buster in the serving URL. A column
  /// rather than `updatedAt` because renaming a lender must not invalidate
  /// every cached copy of an image that did not change.
  logoUpdatedAt DateTime?

  approvals  SolarEquipmentLender[]
  designs    SolarDesign[]
  /// What this lender actually finances, and on what terms.
  products   SolarLenderProduct[]
  /// Which extra work this partner funds ON TOP of its own $/W, rather than out
  /// of it. See SolarLenderAdderRule.
  adderRules SolarLenderAdderRule[]

  /// ── Direct API submission ────────────────────────────────────────────
  /// Set for a lender that accepts applications over an API instead of only
  /// a link. When all three are present the proposal's Qualify button submits
  /// the deal and opens the link the lender hands back, rather than opening
  /// `applyUrl` and asking the customer to retype everything.
  ///
  /// Absent on every lender by default: a partner without an integration keeps
  /// the link behaviour unchanged, which is why this is three nullable columns
  /// and not a mode flag.

  // ── WHAT THE PARTNER API IS TOLD ────────────────────────────────────────
  // Which of several true figures this partner underwrites, and what it means
  // by a saving. Both default to what every submission sent before they
  // existed, so turning this column on re-maps nothing.

  /// See `SolarSubmissionAmountBasis`. Decides `requestedAmount`.
  submissionAmountBasis SolarSubmissionAmountBasis @default(contract_value)

  /// See `SolarSubmissionSavingBasis`. Decides the two saving figures.
  submissionSavingBasis SolarSubmissionSavingBasis @default(utility_avoided)

  /// See `SolarSubmissionSavingHorizon`. Decides WHICH YEAR those two figures
  /// describe. Orthogonal to the basis above: both settings apply to the same
  /// subtraction, one choosing what is subtracted and one over how long.
  submissionSavingHorizon SolarSubmissionSavingHorizon @default(year_one)

  /// See `SolarSubmissionRepNameBasis`. Decides `salesRepName`.
  submissionRepNameBasis SolarSubmissionRepNameBasis @default(deal_rep)

  /// The one name a `fixed` partner is sent, typed as they registered it.
  /// Null on every other partner, and null on a `fixed` one nobody has filled
  /// in — which resolves as `deal_rep` rather than sending an empty name.
  submissionRepName String?

  /// See `SolarSubmissionDelivery`. Decides whether a rep can hand their own
  /// device over. Every existing partner keeps the in-person behaviour.
  submissionDelivery SolarSubmissionDelivery @default(in_person)

  /// Fields an admin has pointed somewhere other than their built-in source.
  /// Empty on every partner until somebody maps one. See SolarLenderFieldMap.
  fieldMap SolarLenderFieldMap[]

  /// Origin of the lender's partner API, e.g. "https://admin.amoscapitalfund.com".
  /// No trailing slash; the client appends "/api/v1/partner/...".
  apiBaseUrl      String?
  /// The API key, encrypted at rest with `server/lib/crypto.encryptField`.
  /// NEVER selected into anything that reaches the browser — the settings UI
  /// shows `maskTail()` of the last four characters and nothing more.
  apiKeyEncrypted String?
  /// Which of the lender's loan products this dealer submits against. Their
  /// value, not ours: Amos calls it a product slug, and it is discoverable from
  /// their catalog endpoint.
  apiProductSlug  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
  @@map("solar_lenders")
}

/// One thing a lender will actually finance, on stated terms.
///
/// A rate sheet is a list of these: 25 years at 4.99% costs an 18% dealer fee,
/// the same term at 3.99% costs 28%. Each combination is a row, because each is
/// separately sellable and separately priced.
///
/// The terms are COPIED onto a deal when a rep picks the product, never read
/// through the relation at render time. Next quarter's rate sheet must not
/// silently re-term a proposal a customer already signed — the same reasoning
/// that made retiring equipment the answer instead of deleting it.
///
/// One table with per-product columns rather than three tables, matching
/// SolarFinance, which holds the same four products the same way. Which columns
/// a row must carry is enforced where it is written, not by the column types.
/// ONE ATTEMPT TO FILE A DEAL WITH A PARTNER LENDER: what we sent, what came
/// back.
///
/// Written on every attempt, successful or not, because until this existed the
/// only record of a submission was a one-line error string on the activity log
/// and a `console.error` nobody in the product can read. Diagnosing a refusal
/// meant decrypting the lender's key and replaying the payload by hand.
///
/// `request` is the exact body that crossed the wire. The API key is not in it
/// and never can be — it travels as a header, and this column is populated from
/// the payload object, not from the fetch.
model SolarLenderSubmission {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Null only if the lender row is deleted afterwards; the name is kept below.
  lenderId   String?
  lenderName String
  /// The reference this attempt was filed under — see `lenderReference`.
  externalId String

  /// WHICH DOCUMENT THIS ATTEMPT SPOKE FOR.
  ///
  /// Every figure on the wire comes off one frozen proposal — see
  /// `submissionDocument` — and until this column existed the row did not say
  /// which. A deal re-priced four times could show "sent to the lender" with no
  /// way to answer the only question that follows: sent at WHICH price. It is
  /// what lets the version list say "sent to Amos" against v13 and nothing
  /// against v14.
  ///
  /// A PLAIN COLUMN, not a relation. `SolarProposal` is vertical-scoped and
  /// this model is not; a foreign key between them would put a scoped read
  /// inside every submission query for no gain here. Null on every attempt
  /// recorded before the column existed, which reads honestly as "this deal was
  /// submitted, but not attributably to a version".
  proposalId String?

  /// What we sent. Frozen: re-reading the deal later answers a different
  /// question from "what did the underwriter actually receive".
  request Json

  ok      Boolean
  /// Their HTTP status, or null when the request never reached them.
  status  Int?
  /// Their machine-readable code, or ours for a failure before the wire
  /// (`network_error`, `preflight`).
  code    String?
  /// The sentence a human reads. Their words where they gave any.
  message String?

  /// Present only on success.
  referenceNumber String?
  applicationId   String?

  /// Which figure produced `requestedAmount` on this attempt. Recorded rather
  /// than inferred: the setting can be changed afterwards, and "what did we
  /// actually ask them to fund, and on what basis" must stay answerable.
  amountBasis String?

  /// Which saving this attempt was told, as "basis/horizon" — the same reason
  /// `amountBasis` is recorded beside it. The body carries the FIGURE, but the
  /// settings that produced it can be changed afterwards, and a saving of
  /// $2,900 means two different things depending on which year it describes.
  savingBasis String?

  actorName String?
  createdAt DateTime @default(now())

  @@index([companyId, leadId, createdAt])
  @@index([companyId, proposalId])
  @@map("solar_lender_submissions")
}

model SolarLenderProduct {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)

  lenderId String
  lender   SolarLender @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  /// Which finance product this prices. Never `cash`: cash has no lender, and a
  /// cash deal quoted with a dealer fee is simply overpriced.
  product FinanceProduct

  /// Optional label. Empty falls back to a name derived from the terms, so a
  /// rate sheet can be entered without inventing names for forty rows.
  name String?

  // ── Loan ────────────────────────────────────────────────────────────────
  aprPct       Float?
  termMonths   Int?
  /// The lender's cut, as a % of gross. Drives the derived sticker price.
  dealerFeePct Float?

  /// Which price the LENDER's figure fixes on this programme — its $/W
  /// (`SolarLender.maxFinalPpwCents`) and its $/battery
  /// (`maxFinalPricePerBatteryCents`) respectively. See SolarPriceBasis.
  ///
  /// Per programme and not per lender because one partner's figure is not one
  /// rule: Amos's $5.50 is the gross on one product and the base on another.
  /// `final` is the default and what every programme did before the column
  /// existed, so nothing already quoted moves.
  ppwBasis          SolarPriceBasis @default(final)
  batteryPriceBasis SolarPriceBasis @default(final)

  // ── Payment factors ─────────────────────────────────────────────────────
  // Solar lenders publish a PAYMENT FACTOR rather than expecting the dealer to
  // amortise: monthly = amount financed × factor. The factor already carries
  // the promotional structure, so it does NOT generally equal the amortised
  // figure — and where one exists it is the lender's own published number,
  // which is why it outranks `loanPaymentCents` everywhere.
  //
  // Stored in MILLIONTHS as integers for the same reason money is stored in
  // cents: 0.005712 has no exact binary representation, and a factor that
  // drifts in the sixth decimal moves a real customer's payment.
  /// Factor assuming the borrower applies the paydown. 5712 = 0.005712.
  factorWithPaydownMicros    Int?
  /// Factor if the paydown is never applied — the higher of the two.
  factorWithoutPaydownMicros Int?
  /// % of the financed amount the borrower is expected to pay down, typically
  /// the federal credit. Null when the program has no paydown structure.
  paydownPct                 Float?
  /// Month the paydown is due, after which the payment re-sets. Usually 18.
  paydownMonths              Int?

  // ── Lease ───────────────────────────────────────────────────────────────
  /// Price per kW-DC per month, cents. Multiplied by system size to get the
  /// fixed monthly that priceThirdParty already consumes.
  leaseRateCentsPerKwMonth Int?

  /// Whether this paper funds a battery with no array on the roof. FALSE by
  /// default: an unreviewed product does not offer to fund something it may
  /// not, and a rep quoting a homeowner on paper the lender will reject finds
  /// that out at submission.
  financesStorageOnly Boolean @default(false)

  // ── PPA ─────────────────────────────────────────────────────────────────
  /// Price per kWh in mills (tenths of a cent), matching SolarFinance.
  rateMillsPerKwh Int?

  // ── Lease & PPA ─────────────────────────────────────────────────────────
  escalatorPct Float?
  termYears    Int?

  /// Retired rather than deleted while any deal quotes it.
  isActive Boolean @default(true)
  /// Display order, so the products you lead with lead.
  rank     Int     @default(0)

  quotedOn     SolarFinance[]
  /// Which providers' VPP programmes accept this product.
  vppProviders SolarProviderVppProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([lenderId, product, isActive])
  @@map("solar_lender_products")
}

/// Which lenders approve which equipment. Many-to-many, because a panel is
/// commonly on several AVLs and a lender's list runs to dozens of items.
///
/// Explicit join rather than an implicit relation so an approval can carry its
/// own facts later (approval date, AVL document reference) without a migration
/// that rewrites the relation.
/// ONE BOX ON A PARTNER'S APPLICATION, POINTED SOMEWHERE ELSE.
///
/// The Submission tab states what feeds every field on the wire. Five of those
/// rows are settings because more than one figure is true; the rest had exactly
/// one sensible source and were therefore decided in code — which is right
/// until a partner wants something else in a box, and then it is a deploy.
///
/// A row here overrides one field for one partner: either another Anexa value
/// (`sourceKey`, from the whitelist in `lender-field-map.ts`) or a constant the
/// admin typed (`literal`). NO ROW MEANS NO OVERRIDE, which is the state every
/// partner starts in and the reason this table changes nothing by existing.
///
/// The whitelist is the point. A mapping cannot name an arbitrary column, so
/// the promise under the table — no social security number, no date of birth,
/// no consent flag ever crosses the wire — survives making the mapping
/// editable.
model SolarLenderFieldMap {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lenderId String
  lender   SolarLender @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  /// The partner's own field path — "applicant.email". One row per field.
  /// Text rather than an enum: the set is owned by `WIRE_FIELDS`, and a field
  /// added there must not need a migration to become mappable.
  wireField String

  /// Which whitelisted Anexa value feeds it. Null when a constant is typed.
  /// A key this build no longer knows resolves to nothing, and the built-in
  /// source stands — never an empty box on a credit application.
  sourceKey String?

  /// The constant, as typed. Parsed per the field's kind at send time; one that
  /// cannot be read is refused on the rep's screen rather than sent.
  literal String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lenderId, wireField])
  @@index([companyId])
  @@map("solar_lender_field_map")
}

model SolarEquipmentLender {
  equipmentId String
  equipment   SolarEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  lenderId    String
  lender      SolarLender    @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  /// ── What this partner calls the same item ─────────────────────────────
  ///
  /// Our catalogue names a SKU; a lender's approved-vendor list names a
  /// product family. Both are right and they are rarely the same string:
  ///
  ///   ours   Qcells | Q.PEAK DUO BLK ML-G10.C+ 405
  ///   Amos   Qcells | Q.PEAK DUO BLK ML G10.C+
  ///
  /// Ours carries the wattage because the designer sizes an array from it, so
  /// renaming the catalogue to match a partner is not available to us — it
  /// would throw the wattage away, and the second partner would want a third
  /// spelling anyway. The partner's own words therefore live HERE, on the row
  /// that already says this partner approves this item.
  ///
  /// NULL means "no translation" and is the default on every existing row,
  /// which is why this migration changes no submission that works today: the
  /// payload falls back to our own manufacturer and model exactly as before.
  /// A partner submitting over an API needs it filled in -- `preflightAmos-
  /// Submission` refuses the deal, on the REP's screen, when it is not.
  lenderBrand String?
  lenderModel String?

  @@id([equipmentId, lenderId])
  @@index([lenderId])
  @@map("solar_equipment_lenders")
}

/// Whether ONE lender puts ONE adder on top of its own price, or inside it.
///
/// `SolarEquipment.financedOnTop` already answered this question -- once, for
/// everybody. That was right while exactly one partner priced this way: Amos
/// Capital Fund funds a flat $5.50/W and a roof above it at what the roof
/// costs, so the roof got the tick and every other adder came out of the
/// ceiling. It stops being right the moment a second capped partner disagrees
/// about the roof, because the tick is on the CATALOGUE and the catalogue is
/// one list shared by every lender you sell.
///
/// So this is the per-lender OVERRIDE. A row says what this partner does with
/// this adder; no row means fall back to the catalogue's own answer, which is
/// why a company that never opens the screen keeps quoting exactly what it
/// quotes today, and why an adder added to the catalogue next month behaves
/// sensibly on every lender before anybody revisits them.
///
/// Rows are written for BOTH answers, not just the ticked ones. "This lender
/// does NOT put the roof on top" is a real decision and has to be able to
/// override a catalogue that says it does -- a table of only-the-ticked-ones
/// can express the opposite override, which is the exact case a second capped
/// partner creates.
///
/// The join carries no companyId of its own, exactly like SolarEquipmentLender:
/// both ends are company-scoped already, and a third copy of the tenant id is a
/// third thing that can disagree with the other two.
model SolarLenderAdderRule {
  lenderId    String
  lender      SolarLender    @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  /// Always an adder. Nothing enforces the kind in the schema -- the write path
  /// does, the same way SolarDealAdder.equipmentId is checked.
  equipmentId String
  equipment   SolarEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  /// TRUE: this partner adds the work to the loan at its own price, above the
  /// $/W. FALSE: it comes out of the $/W, so the work is paid for out of what
  /// the company keeps and the homeowner's number does not move.
  financedOnTop Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([lenderId, equipmentId])
  @@index([equipmentId])
  @@map("solar_lender_adder_rules")
}

/// Equipment and adders a rep can pick from. Prices live here so a proposal is
/// built from the catalog rather than typed in free-hand.
model SolarEquipment {
  id                    String             @id @default(uuid())
  companyId             String
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical              Vertical           @default(solar)
  kind                  SolarEquipmentKind
  manufacturer          String?
  model                 String
  /// Modules: watts per panel. Inverters: rated output W. Batteries: usable Wh.
  ratingW               Int?
  /// Modules only: physical size in mm, so a panel can be drawn on a roof at
  /// true scale. Null falls back to a standard 60-cell residential module —
  /// see MODULE_FALLBACK_MM in src/lib/solar-layout.ts.
  widthMm               Int?
  heightMm              Int?
  /// Unit cost to us, cents.
  costCents             Int                @default(0)
  /// What the customer pays, cents. For adders this is the adder price.
  priceCents            Int                @default(0)
  /// Adders only, and only the ones quoted PER WATT: tenths of a cent per
  /// installed watt. 50 = $0.05/W. Non-null is what makes an adder per-watt —
  /// steep roof and small-system charges are quoted this way and have to follow
  /// the array, which a flat `priceCents` copied onto a deal never does.
  ///
  /// Mills rather than cents because $0.05/W is five cents, and a "5" sitting
  /// in a cents column reads as $5.00/W: a hundredfold error on a line nobody
  /// re-reads.
  priceMillsPerWatt     Int?
  /// Adders only: HOW the price is worked out. Null on equipment, and on
  /// adder rows that predate the column — those are read as `perWatt` when a
  /// per-watt rate is set and `flat` otherwise, which is exactly the rule the
  /// code used before this existed.
  ///
  /// Explicit rather than inferred because "$2,700" and "$2,700 each" and
  /// "$2,700 off" are three different prices that a single amount column
  /// cannot tell apart.
  adderBasis            SolarAdderBasis?
  /// Adders only: the sentence a rep and a homeowner both read. What the work
  /// actually is, in the company's own words — "Tear off and replace the
  /// section of roof under the array" rather than "Re-roof Adder".
  description           String?
  /// Adders only: pin it to the top of the picker as one the company sells on
  /// most jobs, so the six that matter are not thirty scrolls from the rest.
  isVeryCommon          Boolean            @default(false)
  /// Adders only: name it to the customer under "Additional services" on their
  /// proposal, with its description, rather than only as a line in the price
  /// breakdown. Off by default — plenty of adders are internal cost lines a
  /// homeowner has no reason to read a paragraph about.
  showOnProposal        Boolean            @default(false)
  /// Adders only: this work is added to the loan ON TOP of a partner's fixed
  /// or maximum final $/W, at its own price, instead of coming out of the
  /// system price.
  ///
  /// The re-roof is the case, and it is Amos Capital Fund's own rule: their
  /// paper is a flat $5.50/W however big the job, EXCEPT that a roof rides on
  /// the loan at what the roof costs. A 10 kW system is $55,000 and the same
  /// job with a $7,000 roof under it is $62,000, with the payment amortised
  /// over the larger number. Every other adder still comes out of the ceiling,
  /// which is what makes this a flag on the ADDER rather than on the lender.
  ///
  /// Off means the rule that has always applied: the adder grosses up by the
  /// dealer fee and, under a ceiling, eats into the system price.
  financedOnTop         Boolean            @default(false)
  /// Adders only: the system-size band, kW DC, in which this lands on a deal by
  /// itself. Both null means never automatic. A small-system charge that
  /// applies under 5 kW is `autoApplyMinKw = null, autoApplyMaxKw = 5`.
  ///
  /// The band is INCLUSIVE of the minimum and EXCLUSIVE of the maximum, so
  /// bands written back to back — under 5, then 5 to 8 — cannot both fire on a
  /// system that is exactly 5 kW.
  autoApplyMinKw        Float?
  autoApplyMaxKw        Float?
  /// Adders only: this adder CHANGES what the house will use — an EV charger,
  /// a pool pump, a heat pump. Ticking it lets a rep put kWh/yr on the deal
  /// line, and that figure is added to the customer's consumption before offset
  /// is worked out. Without it a rep sells somebody a charger and then quotes
  /// them an offset computed as if they had never bought one.
  consumptionAdjustable Boolean            @default(false)
  /// Adders only: display order, so the highest-margin ones lead.
  rank                  Int                @default(0)
  /// The manufacturer's own datasheet, as a link.
  ///
  /// A LINK rather than a stored PDF: this is the manufacturer's document, it
  /// is revised without telling us, and the version a homeowner should read is
  /// whichever one is current when they click — not whichever one we happened
  /// to download. Rendered on the customer's proposal beside the component, and
  /// omitted when null rather than shown as a dead "View details".
  specSheetUrl          String?
  /// A photograph of the component, as bytes we hold rather than a link.
  ///
  /// Same reasoning as a lender's logo: the customer's proposal is opened from
  /// an email with no session, and hotlinking a manufacturer's image would put
  /// a picture in a document a homeowner keeps under someone else's control —
  /// it goes 404, or it changes, long after the proposal was sent. Normalised
  /// to PNG on the way in, so no mime column is needed.
  photoKey              String?
  /// When the photo last changed — the cache-buster in the serving URL. A
  /// column rather than `updatedAt` because re-pricing a panel must not
  /// invalidate every cached copy of an image that did not change.
  photoUpdatedAt        DateTime?
  specs                 Json               @default("{}")
  isActive              Boolean            @default(true)
  /// The item a new design starts on for this kind. At most one ACTIVE default
  /// per (company, kind) — enforced by a partial unique index in the migration,
  /// not just in the action, because two defaults means the builder silently
  /// picks whichever the sort happens to return first.
  isDefault             Boolean            @default(false)
  /// Approved-vendor-list year, e.g. 2026. The AVL turns over annually and the
  /// catalogue has to say which year an item belongs to, so a 2025 product is
  /// still recognisable for what it was after the 2026 list lands. Null means
  /// the item is not year-scoped. Purely a label: what actually stops a rep
  /// picking last year's product is RETIRING it (isActive = false).
  avlYear               Int?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  designsAsModule   SolarDesign[]               @relation("DesignModule")
  designsAsInverter SolarDesign[]               @relation("DesignInverter")
  designsAsBattery  SolarDesign[]               @relation("DesignBattery")
  dealAdders        SolarDealAdder[]
  /// Which lenders' approved-vendor lists this item appears on.
  lenderApprovals   SolarEquipmentLender[]
  /// Which lenders fund this adder on top of their own price. Adders only.
  lenderAdderRules  SolarLenderAdderRule[]
  /// Which providers' VPP programmes will enrol this item.
  vppProviders      SolarProviderVppEquipment[]

  @@index([companyId, kind, isActive])
  // Catalogue identity is (kind, manufacturer, model, rating) within a company.
  // Declared here for intent; the ENFORCED index is functional (lower() +
  // COALESCE over the two nullable columns) and lives in the migration, because
  // Postgres treats NULLs as distinct and would otherwise let "Qcells / 400W"
  // be entered twice with a null manufacturer.
  @@map("solar_equipment")
}

/// The engineering truth for one solar deal: what the utility bill says, what
/// the roof looks like, and what we are going to build.
model SolarDesign {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// What this deal sells. Backfilled from `batteryId` on every design that
  /// existed before the question was asked: a deal sold with a battery says so.
  systemType SolarSystemType @default(pv_storage)

  // ── Utility & usage ─────────────────────────────────────────────────────
  utilityProvider     String?
  /// The retailer that BILLS the customer, where that differs from the utility
  /// that delivers the power — the TDU/REP split Texas runs on. Stored as text
  /// like utilityProvider, filled from the company's managed list.
  electricProvider    String?
  /// The rate the rep was TOLD, in mills per kWh. Null means derive it from
  /// bill ÷ usage, which is what every design before this one does.
  utilityRateMills    Int?
  /// THIS DEAL'S OWN time-of-use rates, mills per kWh, for the odd plan that
  /// does not match the provider's published one. NULL means read the electric
  /// provider's, which is where they normally come from. Both or neither: a
  /// half-filled pair silently omits the savings line with nothing on screen
  /// saying why, so the editor rejects one without the other.
  touPeakRateMills    Int?
  touOffPeakRateMills Int?
  /// Which method the Energy step was filled in with, so it reopens the way it
  /// was left: "usage" | "bill".
  usageBasis          String?
  ratePlan            String?
  utilityAccountNo    String?
  meterNo             String?
  /// Net metering / buyback programme name. HISTORICAL: nothing writes this any
  /// more — the design step stopped asking when the programme became a company
  /// setting, and that setting has since been removed too. Kept so designs that
  /// still carry a value keep showing it in System info.
  netMeteringProgram  String?

  // ── Permitting & AHJ ────────────────────────────────────────────────────
  // What the jurisdiction and the utility need from us AFTER the sale, so the
  // permit and interconnection paperwork can be generated from the deal instead
  // of retyped into every document. Deliberately on the design rather than the
  // lead: this is engineering truth about the job, and it is nobody's business
  // at intake.
  ahjName                    String?
  ahjContactName             String?
  /// One line, because a jurisdiction gives you whichever it feels like — a
  /// desk phone, an inbox, or both.
  ahjContactInfo             String?
  permitNumber               String?
  /// Who the AHJ and the utility call about THIS job. Blank means the company's
  /// own contact answers for it; see ctxForLead.
  installerContact           String?
  installerTitle             String?
  /// The "not required" boxes a permit packet has to tick explicitly. False is
  /// the honest default: silence means nobody has checked yet, not that the
  /// jurisdiction waived anything.
  permitNotRequired          Boolean @default(false)
  ptoNotRequired             Boolean @default(false)
  interconnectionNotRequired Boolean @default(false)
  otherUtilityStatus         Boolean @default(false)
  otherUtilityStatusDetail   String?
  /// 12 monthly kWh readings, Jan..Dec. The basis for offset — a design that
  /// does not track usage is the thing validation rejects.
  monthlyUsageKwh            Json    @default("[]")
  annualUsageKwh             Int?
  /// What the ADDERS on this deal add to that, kWh/yr. DERIVED — summed from
  /// the deal's adder lines and rewritten whenever they change, never typed.
  ///
  /// Kept apart from `annualUsageKwh` rather than folded into it because the
  /// two answer different questions: one is what the utility bill says the
  /// house uses today, the other is what the EV charger this contract is
  /// selling them will add. Offset is worked out against the sum; the Energy
  /// step still shows, and still edits, the bill figure alone.
  usageAdjustmentKwh         Int     @default(0)
  /// Catalogue adders the rep has taken OFF this deal by hand, as an array of
  /// equipment ids. The auto-apply rule reads it and leaves them alone.
  ///
  /// Without it, removing an adder the system size puts on the deal is a dead
  /// button: the next recompute simply puts it back, and the rep's only clue
  /// is that their click did nothing.
  autoAdderOptOut            Json    @default("[]")
  avgMonthlyBillCents        Int?

  // ── Site ────────────────────────────────────────────────────────────────
  mountType       MountType @default(roof)
  /// [{ name, azimuth, tilt, moduleCount, shadingPct }]
  roofPlanes      Json      @default("[]")
  /// Total Solar Resource Fraction, %. Below ~75 is a shading problem.
  tsrfPct         Float?
  setbackNotes    String?
  structuralNotes String?
  electricalNotes String?

  // ── System ──────────────────────────────────────────────────────────────
  /// The lender this system is being designed for. Drives which equipment the
  /// selectors offer: only items on that lender's approved-vendor list.
  /// Null = no lender chosen yet, so nothing is filtered.
  lenderId String?
  lender   SolarLender? @relation(fields: [lenderId], references: [id], onDelete: SetNull)

  /// How many times this deal has been given a FRESH reference at the lender.
  ///
  /// A partner API is idempotent on the reference we send, which is what stops
  /// a second tap opening a second credit file. The cost of that guarantee is
  /// that a reference the LENDER has broken is broken forever: on 2026-09-05
  /// Amos accepted a submission, crashed part-way through writing it, and then
  /// answered `500 internal_error` to every retry of the same reference — four
  /// materially different payloads, six attempts, one error. Nothing we could
  /// send would ever have got past it.
  ///
  /// So the reference is `design.id` at 0 and `design.id-N` after, and this
  /// counter is bumped only by a person, through
  /// `resetLenderSubmissionKeyAction`, only after a failure, and never once the
  /// deal has a `qualify_submitted` event — because bumping after a success is
  /// precisely how a household ends up with two applications in its name.
  ///
  /// Retries AFTER a bump are idempotent among themselves, exactly as before.
  lenderSubmissionAttempt Int             @default(0)
  moduleId                String?
  module                  SolarEquipment? @relation("DesignModule", fields: [moduleId], references: [id], onDelete: SetNull)
  moduleQty               Int             @default(0)
  inverterId              String?
  inverter                SolarEquipment? @relation("DesignInverter", fields: [inverterId], references: [id], onDelete: SetNull)
  batteryId               String?
  battery                 SolarEquipment? @relation("DesignBattery", fields: [batteryId], references: [id], onDelete: SetNull)
  batteryQty              Int             @default(0)
  /// A person chose this count, so auto-sizing must not take it back.
  ///
  /// Only meaningful when `SolarSettings.autoBatteryQty` is on. Without it the
  /// rep's own number is not an override at all: the next roof edit recomputes
  /// production, re-derives the count and silently overwrites it, and the rep's
  /// only clue is that a battery they added is gone by the time the customer
  /// opens the proposal.
  ///
  /// CLEARED when the battery PRODUCT changes, because the count was a decision
  /// about a different unit — "four Powerwalls" is not an instruction about
  /// four of somebody else's battery. Also cleared when the deal goes back to
  /// panels only, along with the battery itself.
  batteryQtySetByRep      Boolean         @default(false)
  systemSizeKwDc          Float           @default(0)
  systemSizeKwAc          Float           @default(0)
  year1ProductionKwh      Int             @default(0)
  offsetPct               Float           @default(0)
  /// WHICH MODEL produced `year1ProductionKwh`. "pvwatts" when NREL simulated
  /// this site's own planes against its weather record; null when the figure is
  /// the company's market-average yield scaled by the clear-sky ratio, which is
  /// what every design before this carried.
  ///
  /// Stored because the customer's proposal lists the assumptions its numbers
  /// came from, and "1,450 kWh per kW per year" is a false sentence on a
  /// document whose production did not come from that figure.
  yieldSource             String?
  /// The NSRDB station that answered, for the record on the document.
  yieldStation            String?
  /// How many arrays were simulated. Fewer than all of them means the rest kept
  /// the market average, and the proposal says so rather than implying more.
  yieldArrays             Int             @default(0)

  // ── Plan-set artifacts (FileAsset ids, plain columns) ───────────────────
  planSetFileId    String?
  singleLineFileId String?
  loadCalcFileId   String?

  // ── Panel layout (interim workflow) ─────────────────────────────────────
  // Anexa does not draw roofs yet. Until it does, the panel layout is produced
  // in an external design tool and attached here as an IMAGE, so a proposal can
  // show the customer where the panels actually go.
  //
  // Deliberately NOT the aerial property photo: a satellite view with no array
  // on it is a picture of a roof, and presenting it as a design is a lie the
  // customer only discovers at the site survey. `layoutImageFileId` is null
  // until someone uploads a real layout, and the proposal omits the section
  // rather than rendering a placeholder.
  /// The array as drawn in the designer: LayoutBlock[], positions in ground
  /// metres east/north of the lead's coordinate. NOT pixels — a pixel layout
  /// reopened at a different zoom is a layout in the wrong place.
  layoutBlocks            Json      @default("[]")
  /// The fire setbacks traced on the roof: LayoutSetback[], polylines in the
  /// same ground metres as the blocks. A drawing aid and a plan-set talking
  /// point — they do NOT clip panels, because a tool that silently deleted a
  /// rep's array when a line moved is worse than one that shows the conflict.
  layoutSetbacks          Json      @default("[]")
  layoutImageFileId       String?
  layoutImageUploadedById String?
  layoutImageUploadedAt   DateTime?
  /// False = the drawing is still preliminary and the proposal says so. Only an
  /// authorised user marks it final, and only then does the caveat come off —
  /// a layout is preliminary until somebody accountable says otherwise, not by
  /// default because nobody got round to it.
  layoutApproved          Boolean   @default(false)
  layoutApprovedById      String?
  layoutApprovedAt        DateTime?
  /// Who produced the layout ("Aurora", "Pipe Solar", …). Free text: this is a
  /// provenance note on the document, not an integration.
  designProvider          String?
  /// The provider's own design/project id, so the drawing can be found again.
  designExternalRef       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, vertical])
  @@map("solar_designs")
}

/// The money for one solar deal. Which columns matter depends entirely on
/// `product` — see FinanceProduct. Cash/loan use the PPW block; lease/PPA use
/// the rate block. They are never mixed.
model SolarFinance {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  product FinanceProduct @default(cash)

  /// The catalogue product this was quoted from, for provenance only. The terms
  /// below are COPIES taken when the rep picked it: re-reading them through this
  /// relation would let a rate-sheet edit re-term a signed proposal.
  /// Null on cash, and on any deal quoted before the catalogue existed.
  lenderProductId String?
  lenderProduct   SolarLenderProduct? @relation(fields: [lenderProductId], references: [id], onDelete: SetNull)

  // ── Cash / Loan ─────────────────────────────────────────────────────────
  /// Sticker price per watt, cents. Includes the dealer fee on a LOAN.
  grossPpwCents               Int   @default(0)
  /// What ONE battery stickers at — the partner's fee already inside it,
  /// exactly as `grossPpwCents` carries it above. Zero on every PV deal.
  stickerPricePerBatteryCents Int   @default(0)
  /// Lender fee as a % of gross. Zero for cash by definition.
  dealerFeePct                Float @default(0)
  /// Sum of the selected adders that sit INSIDE the partner's price, cents.
  /// See `onTopAdderTotalCents` — the two are disjoint and together they are
  /// the whole catalogue price of the extra work on this deal.
  adderTotalCents             Int   @default(0)
  /// Sum of the adders financed ON TOP of a partner's fixed or maximum $/W,
  /// cents. Zero on every deal carrying none, which is nearly all of them.
  ///
  /// SEPARATE COLUMN rather than a flag summed at read time, for the same
  /// reason `adderTotalCents` is cached at all: pricing, commissions and the
  /// customer's proposal all read it, and none of them should have to sum a
  /// table to find out what the customer signs. `SolarDealAdder.financedOnTop`
  /// is the truth both are recomputed from.
  onTopAdderTotalCents        Int   @default(0)
  /// Final contract price, cents.
  contractPriceCents          Int   @default(0)
  /// Estimated federal credit, cents. An ESTIMATE — see SolarSettings.
  itcEstimateCents            Int   @default(0)

  /// Which federal credits this address and this equipment actually earn.
  ///
  /// TRUE by default because the base credit is earned on nearly every owned
  /// system and because a deal nobody has looked at yet should quote the
  /// ordinary case — but the two bonuses are conditional (a census tract, a
  /// sourcing threshold) and a rep who knows this job does not qualify unticks
  /// them.
  claimItc             Boolean @default(true)
  claimEnergyCommunity Boolean @default(true)
  claimDomesticContent Boolean @default(true)

  /// The rep's own closing credit on this deal, cents. Zero on nearly all.
  ///
  /// TYPED, and the only rung of the credit ladder that is. It is not a tax
  /// credit and it is not derived from the contract: it is money taken off
  /// what the household nets for signing today, so it lives on the deal rather
  /// than in Settings, where a company-wide figure would make it the same
  /// offer to everybody and therefore no offer at all.
  ///
  /// DISPLAY ONLY, exactly like the credits above it. The contract price, the
  /// monthly payment, the deal's value and the rep's commission are all
  /// untouched by it — what moves is the net-cost-after-credits figure the
  /// proposal shows behind its tax-credit switch.
  signTodayCreditCents Int     @default(0)

  // ── Lease / PPA ─────────────────────────────────────────────────────────
  /// PPA only: price per kWh in tenths of a cent (e.g. 145 = $0.145/kWh).
  rateMillsPerKwh     Int?
  /// Lease only: fixed monthly payment, cents.
  monthlyPaymentCents Int?
  /// Annual payment/rate increase, %. Applies to lease and PPA.
  escalatorPct        Float?
  termYears           Int?

  // ── Loan terms (from the approved credit application) ────────────────────
  aprPct                  Float?
  loanTermMonths          Int?
  /// Cash the customer puts down, reducing the financed amount. Cents.
  downPaymentCents        Int?
  /// The lender's OWN monthly payment figure, cents. Deliberately STORED and
  /// never derived from amount + APR + term: promotional periods, fees and
  /// re-amortisation all mean a computed figure can contradict the real one,
  /// and the number a customer is quoted has to be the number the lender
  /// issued. Distinct from `monthlyPaymentCents` above, which is LEASE-only.
  loanMonthlyPaymentCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, vertical])
  // Declared here because the migration that added lenderProductId also created
  // this index. Without the declaration Prisma sees drift and generates a DROP
  // on every `migrate dev` — which is how an index quietly leaves production.
  @@index([lenderProductId])
  @@map("solar_finance")
}

/// One submission to one lender. A deal can have several (declined by one,
/// approved by another), so this is not 1:1.
model CreditApplication {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  lender       String
  status       CreditStatus @default(not_submitted)
  /// The lender's own application id — the key the webhook matches on.
  externalId   String?
  amountCents  Int          @default(0)
  termMonths   Int?
  aprPct       Float?
  dealerFeePct Float?
  /// Conditions that must be cleared before NTP, e.g. proof of income.
  stipulations Json         @default("[]")
  submittedAt  DateTime?
  decidedAt    DateTime?
  expiresAt    DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, lender, externalId])
  @@index([companyId, leadId])
  @@index([companyId, status])
  @@map("credit_applications")
}

/// A versioned, customer-facing solar proposal.
///
/// The snapshot is the point. Every figure the homeowner sees is FROZEN at
/// generation time — the assumptions, the design, the money, all of it. When
/// the CPA changes the ITC percentage next month, a proposal already sent must
/// still show what that customer was shown, or the document is worthless as a
/// record of what was offered.
///
/// Versions are never overwritten: regenerating supersedes and keeps the old
/// one, so the trail of what was offered and when survives intact.
model SolarProposal {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  version     Int
  status      ProposalStatus @default(draft)
  /**
   * The shareable customer link (/proposal/[token]).
   * NULL until the proposal is actually SENT. Generating one is an internal act
   * — a rep checking their own work — and it used to mint a live, unguessable
   * but fully working public URL as a side effect. Every draft anybody had ever
   * generated was already on the public internet, waiting to be guessed or
   * leaked through a screenshot; nobody had to click "share" for that to be
   * true. Minting on send instead means an unsent proposal has no public
   * surface at all.
   * Unique still holds: Postgres treats NULLs as distinct, so any number of
   * unsent proposals can sit at NULL while every real token stays one-to-one.
   * The public route ALSO checks status, so a token alone is not access.
   */
  publicToken String?        @unique

  /// The frozen document. See SolarProposalSnapshot in src/lib/solar-proposal.ts.
  snapshot Json

  /// Whether the customer's copy carries the 25-year utility-versus-solar
  /// comparison.
  ///
  /// A COLUMN, deliberately outside the snapshot. The snapshot is what this
  /// customer was quoted and must never move; this is a choice about what to
  /// show them, and a rep turning the table off should not have to reissue a
  /// version and renumber the document to do it. Some households read the
  /// twenty-five-year table as the proof and some read it as a wall of numbers,
  /// and that is a decision made at the table, after the thing is generated.
  showComparison Boolean @default(true)

  /// Whether the customer's copy lets them switch between the payment options
  /// frozen into the snapshot.
  ///
  /// A COLUMN for the same reason `showComparison` is: the options themselves
  /// are part of the frozen document and must not move, but whether to put a
  /// menu of them in front of THIS household is a call a rep makes at the
  /// table. Turning it off shows only the option the deal was quoted on, which
  /// is how every proposal generated before the switcher existed reads.
  showPaymentOptions Boolean @default(true)

  /**
   * Which version this deal actually sold — set on exactly one row per lead.
   * NOT the same question as "which is newest" or "which has not been
   * superseded", and that is the whole point. A deal accumulates ten versions
   * while a rep works a price at the table; the one that was agreed is
   * frequently not the last one generated, and until this column existed
   * nothing on the deal could say which it was.
   * INTERNAL. The customer's link and what it resolves to are untouched by
   * this — approving is a record of a decision already made, not a way to
   * publish one.
   * "Exactly one" is enforced by a PARTIAL UNIQUE INDEX on (leadId) WHERE
   * approvedAt IS NOT NULL, written by hand in the migration because Prisma's
   * schema language cannot express one. Two admins approving different
   * versions in the same second is then a lost race rather than a deal with
   * two final proposals.
   */
  approvedAt   DateTime?
  approvedById String?

  /**
   * The PDF filed into the deal's Proposal folder when this version was
   * approved.
   * Held so unapproving removes the copy it put there rather than guessing at
   * one by category, and so a render that failed is distinguishable from one
   * that never ran: approved with a null file id means "approve succeeded, the
   * PDF did not" and the UI offers a retry. Approval is deliberately allowed to
   * commit without it — see setProposalApprovalAction.
   */
  approvedFileId String?

  /**
   * THE SECOND FILED COPY — the same signed document read the other way.
   * A credit-earning proposal has two honest readings of one deal, and the
   * switch on the customer's page is what picks between them. Both are what was
   * sold: the household signs once, and the file has to carry the deal with the
   * credits applied AND the deal at par, because whether the credits are ever
   * claimed is a fact about somebody's tax return that the day of signing
   * cannot settle. `approvedFileId` is the credits-applied copy and this is the
   * one at par; a deal with no credits to claim has only the first, and this
   * stays null.
   * Its own column for the same reason the first has one: unapproving must
   * remove exactly the copies approval put in the folder, and finding them by
   * category would sweep up a PDF a rep dropped in by hand.
   */
  approvedParFileId String?

  /// Set when a newer version replaces this one.
  supersededAt      DateTime?
  /// The e-sign envelope, once sent for signature.
  documentPackageId String?

  /**
   * THE CUSTOMER'S SIGNATURE, and the evidence standing behind it.
   * `signedAt` on its own recorded that somebody typed a name into a box. That
   * is enough to move a deal and nothing like enough to hand a lender: Amos
   * asks for a signed proposal, and a document whose acceptance leaves no mark
   * on the paper is one nobody outside this application can verify.
   * So the signature is a MARK, held here as a PNG data URL — drawn with a
   * finger or set from the typed name — and rendered into the document's
   * execution block and onto the filed PDF. Everything beside it is the ESIGN /
   * UETA record: who signed, that they consented to sign electronically before
   * they did, when, and from where.
   * COLUMNS, NOT SNAPSHOT. The snapshot is what this customer was quoted and
   * must never move. A signature is something that happens TO that document
   * afterwards; writing it into the frozen JSON would rewrite the thing being
   * signed at the moment of signing.
   */
  /// The mark itself: a PNG data URL. NULL on every proposal signed before
  /// signatures were captured, which reads as "accepted, no mark on file".
  signatureData   String?        @db.Text
  /// How the mark was made — drawn with a finger, or set from the typed name.
  signatureType   SignatureType?
  /// The name the signer gave, as they typed it. Not the lead's name: the
  /// person at the table is who signed, and they are not always the record.
  signerName      String?
  /// The address the proposal was delivered to, copied at signing time so the
  /// certificate can say which mailbox the link went to.
  signerEmail     String?
  signedIp        String?
  signedUserAgent String?
  /// Explicit consent to sign electronically, captured BEFORE the signature.
  /// ESIGN wants the agreement to transact electronically to be its own
  /// affirmative act, not something implied by pressing the button.
  consentAt       DateTime?
  /// "remote" — the customer opened their own link — or "in_person", where a
  /// rep handed over their device at the table. Both are the customer's
  /// signature; the certificate names which, because they are different claims.
  signedVia       String?
  /// The rep whose device hosted an in-person signing. NULL for remote.
  signedHostId    String?

  createdById String?
  sentAt      DateTime?
  viewedAt    DateTime?
  signedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events SolarProposalEvent[]

  @@unique([leadId, version])
  @@index([companyId, leadId])
  @@index([leadId, approvedAt])
  @@map("solar_proposals")
}

/// Append-only audit trail for a proposal: who did what, when, from where.
model SolarProposalEvent {
  id         String        @id @default(uuid())
  proposalId String
  proposal   SolarProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// generated | sent | viewed | signed | superseded
  type       String
  actorId    String?
  actorName  String?
  ip         String?
  detail     String?
  createdAt  DateTime      @default(now())

  @@index([proposalId, createdAt])
  @@map("solar_proposal_events")
}

/// How one adder line works out its money.
///
/// SIX WAYS, because the extra work on a solar job really is priced six
/// different ways and collapsing them loses the unit. Trenching is quoted per
/// foot, a steep roof per watt, a main panel upgrade as one number, and a
/// promotional credit comes OFF. A line that cannot say which of those it is
/// is a line whose price nobody can check.
enum SolarAdderBasis {
  /// One amount, whatever the size. A main panel upgrade is $2,700. ("Fixed")
  flat
  /// Amount times a count the rep enters — attic runs, extra optimisers.
  perUnit
  /// Rate times a length in feet. Trenching, conduit. Rate held in `flatCents`.
  perFoot
  /// Scales with the array — steep roof, small system. Rate in mills per watt.
  perWatt
  /// A one-off the rep prices on the day. Still a line, still labelled.
  custom
  /// Comes OFF the price. Stored POSITIVE and negated when it is priced, so
  /// the figure somebody typed is the figure the column holds.
  discount
}

/// One piece of extra work on a solar deal, and what it costs.
///
/// NEW DATA. `SolarFinance.adderTotalCents` held a single number a rep typed
/// into a box called "Adders $", which cannot say what the money is FOR, cannot
/// be checked against the catalogue, and goes stale the moment the array
/// changes — a $0.05/W steep-roof charge is right for the 8 kW system it was
/// typed on and wrong for the 12 kW one the roof turned out to hold.
///
/// The total is still cached on SolarFinance, because pricing, commissions and
/// the customer's proposal all read it and none of them should have to sum a
/// table. These rows are the truth it is recomputed from.
model SolarDealAdder {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// The catalogue item this came off. Null for a one-off typed on the deal.
  /// SetNull rather than Cascade: retiring a catalogue item must not delete a
  /// line off a quote somebody has already been shown.
  equipmentId String?
  equipment   SolarEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  /// COPIED at pick time, never read back through the relation. Renaming a
  /// catalogue item would otherwise retitle a line on a signed proposal.
  label                 String
  /// COPIED like the label, and for the same reason: a homeowner reading
  /// "Trenching — 120 ft" has to keep reading it after somebody rewrites the
  /// catalogue blurb.
  description           String?
  basis                 SolarAdderBasis @default(flat)
  /// `flat`, `custom` and `discount`: the whole amount, cents. `perUnit`: the
  /// amount for ONE. `perFoot`: the amount for one FOOT. Null on `perWatt`.
  flatCents             Int?
  /// `perWatt`: tenths of a cent per installed watt. 50 = $0.05/W.
  millsPerWatt          Int?
  /// The multiplier: units on `perUnit`, feet on `perFoot`, otherwise 1.
  qty                   Int             @default(1)
  /// Named to the customer under "Additional services", with its description.
  showOnProposal        Boolean         @default(false)
  /// COPIED from the catalogue at pick time, like the price and the basis, and
  /// for the same reason: this decides what the customer's contract comes to,
  /// and re-reading it through the relation would let a settings change move
  /// the total on a quote somebody has already been shown.
  financedOnTop         Boolean         @default(false)
  /// What this adder does to the household's annual consumption, kWh. An EV
  /// charger is roughly +3,000. Added to the design's usage before offset is
  /// worked out, so a rep who sells a charger does not then quote an offset
  /// computed as if the charger were not there. Null on everything else.
  consumptionKwhPerYear Int?
  /// The system-size rule put this here, not a rep. Only these are taken back
  /// off when the array grows out of the band — a line somebody chose by hand
  /// is never removed by a recompute.
  autoApplied           Boolean         @default(false)
  /// Display order, so a breakdown reads the same way twice running.
  sortOrder             Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, leadId])
  @@index([equipmentId])
  @@map("solar_deal_adders")
}

/// What one plane of panels makes at one place, according to NREL PVWatts.
///
/// DELIBERATELY NOT PER-COMPANY, and the only table here that is not. This is
/// the weather record for a grid cell and the physics of a tilted plane — it is
/// not anybody's data, it does not vary by tenant, and a second company quoting
/// the same street should not pay for the same request again. Nothing derived
/// from a customer is stored: a key, an angle and a kWh figure.
///
/// The stored yield is for a 1 kW system, so one row serves an array of any
/// size. Shading is NOT in here — it varies array by array while the plane's
/// yield does not, so it is applied to this figure rather than baked into it.
model SolarYieldCache {
  id  String @id @default(uuid())
  /// `lat|lon|tilt|azimuth|losses|arrayType`, rounded — see yieldCacheKey.
  key String @unique

  /// The rounded inputs, kept alongside the key so a row is readable without
  /// parsing it and a stale rounding rule can be found and re-fetched.
  lat        Float
  lon        Float
  tiltDeg    Float
  azimuthDeg Float
  lossesPct  Float
  arrayType  String

  /// kWh per kW-DC per year on this plane. The number everything rests on.
  kwhPerKwYear Float
  /// Twelve monthly figures for a 1 kW system, Jan..Dec. The shape of the year.
  monthly      Json    @default("[]")
  /// Which NSRDB station answered, for the record.
  station      String?

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("solar_yield_cache")
}

/// One building's roof, as Google's Solar API models it.
///
/// NOT PER-COMPANY, for the same reason as SolarYieldCache above: this is the
/// shape of a building, derived from the same public aerial imagery the deal
/// card already shows, and two companies quoting the same street should not pay
/// for the same request twice. Nothing about a customer is stored — a
/// coordinate, some angles, and where Google would put panels.
///
/// Stored in LAT/LNG rather than the ground metres the designer draws in: those
/// are measured from one deal's coordinate, and a roof outlives any deal on it.
model SolarRoofCache {
  id  String @id @default(uuid())
  /// `lat|lng` rounded to six decimals — a house, not a neighbourhood.
  key String @unique

  lat Float
  lng Float

  /// Roof planes, each with a pitch, an azimuth and a centre. See RoofSegmentGeo.
  segments Json @default("[]")
  /// Google's own panel placements, `{lat, lng, segmentIndex}` — the labelled
  /// point cloud an array's facing is voted from.
  panels   Json @default("[]")

  /// False when Google has no model for this address. Cached DELIBERATELY: a
  /// rural roof it cannot see is not a transient failure, and re-asking on
  /// every page load would spend a request to be told the same thing.
  found Boolean @default(false)

  /// How good the imagery behind the model is, and when it was taken. Shown to
  /// the rep, because a facing read off a 2019 picture of a roof that has been
  /// re-shingled since is still worth a second look.
  imageryQuality String?
  imageryDate    String?

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("solar_roof_cache")
}

/// Who a milestone pays.
///
/// Only `rep` is ever written now. A solar rep is paid out in full, once, so
/// the deal records one figure; `financier` is kept because rows created under
/// the old four-slot schedule still carry it, and because when the LENDER funds
/// is the pipeline stage the payroll gate reads, not a row somebody types.
enum MilestonePayee {
  /// The rep's commission on this deal.
  rep
  /// Historic. Nothing creates one of these any more.
  financier
}

/// What the rep is owed on a solar deal.
///
/// NEW DATA — this was not captured before. The pricing breakdown on the deal
/// (base PPW, adders, dealer fee, final PPW) is all derived from figures we
/// already store, but what the rep MAKES on the job was not modelled anywhere.
///
/// ONE ROW: payee `rep`, sequence 1, written only by
/// `upsertSolarCommissionAction`, which decides both rather than taking them
/// from the caller. The four slots this used to hold — M1/M2 beside two
/// financier draws — described a payment schedule the business does not run.
model SolarMilestone {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  payee       MilestonePayee
  /// Always 1. Anything higher is a row from the old M1/M2 schedule.
  sequence    Int
  label       String
  amountCents Int            @default(0)
  /// What has to happen for this to pay (e.g. "Install complete").
  trigger     String?
  expectedAt  DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, payee, sequence])
  @@index([companyId, leadId])
  @@map("solar_milestones")
}

/// Which audience a feed post is for.
/// The compensation terms ONE solar deal is paid on, frozen when the customer
/// signs.
///
/// WHY THIS EXISTS SEPARATELY FROM THE COMMISSION ROW. The terms were already
/// snapshotted — onto `Commission` — but that row is not created until M1, which
/// is months after signing. Between those two moments a rep's redline can be
/// raised, their basis switched, or the deal handed to somebody else, and the
/// deal would have quietly repriced against terms nobody agreed to when it sold.
/// This row is written at SIGNING and is what the engine reads first.
///
/// ONE REP PER DEAL. There is no split and no second earner: `repId` is the one
/// person whose commission this deal generates. Managers earn through
/// CommissionOverride, which is a separate arrangement between a manager and a
/// rep and never comes out of the rep's number.
/// A SUPER ADMIN'S PERMISSION TO REWRITE ONE SIGNED CONTRACT, and the reason.
///
/// A signature freezes a solar deal's economics — see `server/modules/solar/
/// signed-lock.ts`. Designs do genuinely change between contract and install, so
/// the business needs a way through; what it must never be is a silent one.
///
/// A ROW RATHER THAN A FLAG ON THE DEAL. The reason has to be given BEFORE the
/// edit, not inferred from it afterwards, and a super admin who unlocks a
/// contract and changes three things has made one decision, not three. The row
/// is that decision: who, when, why, and for how long.
///
/// SHORT-LIVED ON PURPOSE. An unlock that lasted forever would be a lock that
/// was removed, so it expires — see `UNLOCK_WINDOW_MINUTES`. An expired row is
/// kept rather than deleted: it is the record of an exception being made, which
/// is the whole point of asking for a reason.
model SolarContractUnlock {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Why this contract is being reopened, in the person's own words. Required,
  /// and never defaulted — a reason the product wrote is not a reason.
  reason String

  unlockedById String
  unlockedAt   DateTime @default(now())
  /// When the permission lapses. Past this the contract is locked again.
  expiresAt    DateTime

  createdAt DateTime @default(now())

  @@index([companyId, leadId, expiresAt])
  @@map("solar_contract_unlocks")
}

model SolarDealComp {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// The one commission-earning rep. Snapshotted rather than read off the lead
  /// so reassigning the deal in the pipeline cannot silently move the money.
  repId String
  rep   User   @relation("SolarDealCompRep", fields: [repId], references: [id])

  /// The frozen terms — the same four rates `Commission` carries, resolved once
  /// at signing. "redline" | "per_watt" | "battery_redline" | "battery_flat".
  basis                  String
  redlineCentsPerWatt    Int?
  millsPerWatt           Int?
  redlinePerBatteryCents Int?
  perBatteryFlatCents    Int?

  /// When the customer signed — the moment these terms stopped being editable.
  signedAt DateTime

  /// ── Lead origin, finalised at M1 ────────────────────────────────────────
  /// NULL until M1 finalises it. Null is not "self-generated": it means nobody
  /// has decided yet, and the engine pays as self-generated in the meantime
  /// because taking money off a rep on an undecided classification is the wrong
  /// way round.
  companyProvidedLead  Boolean?
  /// WHICH adjustment applies, copied off the rep when the classification was
  /// finalised. Snapshotted rather than read live so moving a rep from a
  /// percentage to a flat deduction next quarter cannot reprice a funded deal.
  leadAdjustMode       SolarLeadAdjustMode @default(none)
  /// The COMPANY's take percentage. Read only when leadAdjustMode = percentage.
  companyLeadTakePct   Float?
  /// The COMPANY's flat deduction, cents. Read only when leadAdjustMode = flat.
  companyLeadFlatCents Int?
  leadClassFinalizedAt DateTime?
  leadClassFinalizedBy String?

  /// ── Compensation could not be resolved at signing ───────────────────────
  /// TRUE means this deal sold without usable pay terms — no assigned rep, or a
  /// rep with nothing configured for this kind of deal. The row exists anyway,
  /// carrying `basis = "unresolved"`, precisely so the deal can be FOUND and
  /// blocked rather than quietly falling back to whatever the rep's profile
  /// says on the day payroll runs. An authorised admin establishes the terms
  /// the deal was actually sold on; until then no commission generates.
  needsReview        Boolean   @default(false)
  reviewNote         String?
  reviewResolvedById String?
  reviewResolvedAt   DateTime?

  /// ── Super Admin reassignment, after signing ─────────────────────────────
  /// Reassignment is deliberate, rare, and always leaves a trail: who it was
  /// taken from, who moved it, when, and why. Absent on the overwhelming
  /// majority of rows.
  reassignedFromId String?
  reassignedFrom   User?     @relation("SolarDealCompReassignedFrom", fields: [reassignedFromId], references: [id])
  reassignedById   String?
  reassignedAt     DateTime?
  reassignReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, repId])
  @@map("solar_deal_comp")
}

/// Why a commission was clawed back.
///
/// A chargeback is NEVER automatic. Funding being reversed is not, on its own, a
/// rep's fault — an install that failed, a permit that was refused, a utility
/// that would not interconnect, a lender problem, a customer who stopped
/// answering: none of those are the rep's conduct, and none of them may take a
/// rep's pay. A chargeback is raised deliberately, for a documented rep-caused
/// loss, and approved by an admin before a cent moves.
enum ChargebackReason {
  fraud
  fabricated_deal
  misrepresentation
  rep_misconduct
  /// Another documented rep-caused loss. `notes` is required in practice.
  other_rep_caused
}

enum ChargebackStatus {
  /// Raised, not yet approved. Nothing is recoverable in this state.
  pending
  approved
  rejected
  /// Fully recovered — balance is zero.
  settled
  /// Approved, then withdrawn. Recoveries already taken are NOT undone by this;
  /// undoing one is a positive payroll adjustment, which leaves its own record.
  voided
}

/// A deliberate, admin-approved clawback of commission already paid or approved.
model Chargeback {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vertical  Vertical @default(solar)

  /// The commission being clawed back. Kept as a link rather than copied,
  /// because the original row must survive untouched — see the note on
  /// `Commission.status`. SetNull so a deleted commission cannot erase the
  /// financial record of the clawback.
  commissionId String?
  commission   Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  /// Denormalised so the record still reads correctly if the commission goes.
  projectId    String?
  leadId       String?
  /// Who owes it back. A rep, or a MANAGER whose override rode on the same deal.
  userId       String
  user         User        @relation("ChargebackUser", fields: [userId], references: [id])

  amountCents Int              @default(0)
  reason      ChargebackReason
  notes       String?
  status      ChargebackStatus @default(pending)

  requestedById String
  requestedAt   DateTime  @default(now())
  approvedById  String?
  approvedAt    DateTime?
  rejectedById  String?
  rejectedAt    DateTime?

  recoveries ChargebackRecovery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, userId, status])
  @@index([companyId, projectId])
  @@map("chargebacks")
}

/// One instalment of a chargeback, taken on one payroll run.
///
/// An approved chargeback creates a BALANCE, not a deduction. How much of it
/// comes off a given payroll is an admin's decision every time — full, partial
/// or nothing at all. Taking a rep's entire cheque because a balance exists is
/// how a chargeback becomes a second, unintended punishment.
model ChargebackRecovery {
  id           String     @id @default(uuid())
  chargebackId String
  chargeback   Chargeback @relation(fields: [chargebackId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  amountCents Int      @default(0)
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([chargebackId])
  @@index([payrollRunId])
  @@map("chargeback_recoveries")
}

enum PayrollAdjustmentKind {
  /// Money added — a bonus, a spiff, a correction in the rep's favour.
  bonus
  /// Money taken — trenching, materials, an agreed cost.
  deduction
  /// An instalment against an approved chargeback balance. Always carries a
  /// `chargebackId`, and is the only kind payroll creates on its own.
  chargeback_recovery
}

/// A manual line on ONE payroll run.
///
/// Adjustments change what somebody is PAID. They never touch the deal's
/// commission: an approved commission is a record of what was earned, and a
/// deduction for trenching does not mean the rep sold a smaller system. The
/// deal keeps saying $10,000 while the cheque says $9,500, and both are true.
model PayrollAdjustment {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  /// Who is paid (or docked).
  userId       String
  user         User       @relation("PayrollAdjustmentUser", fields: [userId], references: [id])

  kind        PayrollAdjustmentKind
  /// SIGNED cents: positive adds, negative deducts. The sign and `kind` are kept
  /// consistent by the action that writes it, so a report can sum this column
  /// directly without asking what kind each row is.
  amountCents Int                   @default(0)
  reason      String

  /// Optional deal association, for an adjustment that belongs to one job.
  leadId    String?
  projectId String?

  /// Set only on `chargeback_recovery`, linking the instalment to its balance.
  chargebackId String?

  createdById String
  createdAt   DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@index([companyId, payrollRunId])
  @@index([companyId, userId])
  @@map("payroll_adjustments")
}

enum FeedChannel {
  /// Visible to the customer in their portal.
  external
  /// Staff only — never shown to the homeowner.
  internal
  /// Written by, or addressed to, the homeowner.
  customer
}

/// A post on a deal's activity feed.
///
/// NEW DATA. ActivityLog already records SYSTEM events, but it has no audience
/// and no way to address a colleague — so a coordinator asking "did anyone
/// chase the utility?" had nowhere to put it. Posts carry a channel so internal
/// chatter can never leak to the homeowner, and @mentions notify by email.
model DealFeedPost {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(roofing)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  channel  FeedChannel @default(internal)
  body     String      @db.Text
  authorId String?
  author   User?       @relation("FeedAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// User ids extracted from @mentions, notified on create.
  mentions String[]

  createdAt DateTime @default(now())

  @@index([companyId, leadId, createdAt])
  @@map("deal_feed_posts")
}

// ---------------------------------------------------------------------------
// Nova — the voice assistant in the Solar portal
// ---------------------------------------------------------------------------

enum NovaToolKind {
  read
  write
  decline
}

enum NovaAuditPhase {
  /// A read ran, or a confirmed write ran and succeeded.
  executed
  /// The permission or row check said no. Nothing ran.
  refused
  /// It ran (or tried to) and errored, or its input was invalid.
  failed
  /// A write was put to the user for confirmation. Nothing ran yet.
  proposed
  cancelled
  expired
  /// The request named something Nova does not do at all (stage moves, pricing…).
  declined
}

/// Everything Nova did or was asked to do, one row per event.
///
/// APPEND-ONLY. Nothing in the app updates or deletes these rows — a guard test
/// fails the build on any `novaAuditEvent.update/delete` in the module — so the
/// record of what the assistant did as somebody cannot be edited afterwards.
///
/// Plain id columns, no relations, on purpose: the audit trail must outlive the
/// deal and the person it names, and a cascade from either would delete the
/// evidence along with the thing it is evidence about.
model NovaAuditEvent {
  id              String         @id @default(uuid())
  companyId       String
  vertical        Vertical?
  actorId         String
  conversationId  String
  tool            String
  kind            NovaToolKind
  phase           NovaAuditPhase
  args            Json           @default("{}")
  result          Json?
  error           String?
  leadId          String?
  entityType      String?
  entityId        String?
  pendingActionId String?
  createdAt       DateTime       @default(now())

  @@index([companyId, leadId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@map("nova_audit_events")
}

enum NovaPendingStatus {
  pending
  confirmed
  cancelled
  expired
}

/// A write Nova has proposed and is waiting on the user to confirm. Single use:
/// confirming claims the row atomically, so a double click or a replayed request
/// cannot run the write twice. What actually happened is in nova_audit_events.
model NovaPendingAction {
  id             String            @id @default(uuid())
  companyId      String
  vertical       Vertical
  actorId        String
  conversationId String
  tool           String
  args           Json              @default("{}")
  summary        String
  leadId         String?
  status         NovaPendingStatus @default(pending)
  expiresAt      DateTime
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([companyId, actorId, status])
  @@map("nova_pending_actions")
}
