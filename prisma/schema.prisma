// Anexa Homes — Roofing CRM (multi-tenant SaaS)
// Postgres + Prisma. All money stored as integer cents. Tenancy via companyId on every row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  super_admin
  admin
  manager
  sales_rep
  canvasser
  marketing
  installer
  accounting
  customer
}

enum UserStatus {
  active
  invited
  suspended
  disabled
}

enum LeadStatus {
  open
  won
  lost
  junk
}

enum Priority {
  low
  medium
  high
  urgent
}

enum ProjectStatus {
  not_started
  in_production
  on_hold
  qc
  completed
  closed
  cancelled
}

// NOTE: claim status was an enum here. It is now free-form text on Lead,
// backed by the company-editable list in Settings → Claim Statuses. The nine
// original values live on as the default keys in src/lib/claim-status.ts.

// How a deal is paid for. `insurance` = filed claim (RCV/ACV/depreciation/deductible,
// scope of work). `cash` = customer pays out of pocket / financing — no insurance.
enum DealType {
  insurance
  cash
}

enum CustomFieldEntity {
  lead
  project
}

enum CustomFieldType {
  text
  number
  date
  select
  checkbox
  textarea
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum FileKind {
  document
  photo
  signed_document
  other
}

enum ActivityType {
  note
  call
  email
  meeting
  stage_change
  status_change
  document
  payment
  assignment
  system
}

enum DocumentTemplateType {
  roofing_contract
  insurance_contingency
  certificate_of_completion
  change_order
  depreciation_request
  final_invoice
  warranty_certificate
  customer_closeout
  custom
}

enum DocumentFieldType {
  text
  date
  checkbox
  signature
  initials
}

enum DocumentSignerRole {
  customer
  co_customer
  company_rep
  witness
}

enum DocumentPackageStatus {
  draft
  sent
  viewed
  partially_signed
  completed
  declined
  voided
  expired
}

enum SignerStatus {
  pending
  sent
  viewed
  signed
  declined
}

enum SignatureType {
  typed
  drawn
}

enum DocumentEventType {
  created
  sent
  viewed
  field_filled
  signed
  completed
  declined
  voided
  reminder_sent
  downloaded
}

enum CommissionType {
  percentage
  flat
  job_cost
  /// Dollars per watt of system size. The standard solar rep comp basis for
  /// cash and loan deals.
  ppw
  /// Percentage of margin, net of dealer fee and adders — what the company
  /// actually keeps, not the sticker price.
  margin
}

enum CommissionStatus {
  pending
  approved
  paid
  void
}

enum PayrollStatus {
  draft
  approved
  paid
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum NotificationEvent {
  lead_created
  lead_assigned
  stage_changed
  project_status_changed
  document_sent
  document_viewed
  document_signed
  document_completed
  task_assigned
  task_reminder
  daily_report_submitted
  commission_approved
  payroll_approved
}

enum NotificationChannel {
  in_app
  email
  sms
}

enum ServiceType {
  roofing
  storm_restoration
  solar
  hvac
  water_filtration
  windows
  other
}

/// An isolated line of business inside one company: its own deals, pipeline,
/// config, templates, catalog and reports. Users are granted one or more and
/// switch between them.
///
/// PHYSICALLY this type is still `Industry` in Postgres and every column using
/// it is still named `industry` (see the @map on each field). The rename to
/// "vertical" is code-level only and emits NO DDL, so it never has to be
/// sequenced against a deploy of the live box.
///
/// `others` is retired from the pre-2026-07 three-workspace build. It is kept so
/// historical rows keep validating, but it is excluded from VERTICALS in
/// src/lib/vertical.ts and can never be selected, switched to, or written.
/// Adding a third vertical = add a value here + a seed. Nothing else.
/// How a pipeline stage ages.
///
/// The distinction is the difference between a backlog you can act on and a
/// wall of red that everyone learns to ignore. We control when an internally
/// owned stage completes, so it gets a hard deadline. We do NOT control an
/// AHJ's plan review or a utility's PTO queue, so those get a follow-up cadence
/// instead — the question is "when did WE last chase this?", never "why is our
/// team late?".
enum StageType {
  internally_owned
  externally_blocked
}

/// Who a deal is actually waiting on. Drives the follow-up cadence and the
/// aging report — this one field is what makes the backlog actionable.
enum BlockerParty {
  us
  ahj // authority having jurisdiction (building dept / plan review)
  utility
  customer
  lender
}

enum Vertical {
  roofing
  solar
  others

  @@map("Industry")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  zip         String?
  einTaxId    String? // payer EIN / Tax ID — used as the payer TIN on 1099-NEC filings
  // Company operations overhead (% of contract) removed before the profit split.
  overheadPct Float    @default(10)
  // Public-adjuster fee (% of the supplement) removed from the pool when a deal
  // is supplemented, before the rep/company split.
  paFeePct    Float    @default(10)
  timezone    String   @default("America/Chicago")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 User[]
  settings              CompanySettings?
  leadSources           LeadSource[]
  pipelines             Pipeline[]
  leads                 Lead[]
  projects              Project[]
  claims                Claim[]
  roofMeasurements      RoofMeasurement[]
  crews                 Crew[]
  tasks                 Task[]
  notes                 Note[]
  files                 FileAsset[]
  dailyReports          DailyReport[]
  customFieldDefs       CustomFieldDef[]
  documentTemplates     DocumentTemplate[]
  documentPackages      DocumentPackage[]
  commissionRules       CommissionRule[]
  commissionOverrides   CommissionOverride[]
  commissions           Commission[]
  payrollRuns           PayrollRun[]
  invoices              Invoice[]
  activityLogs          ActivityLog[]
  invitations           Invitation[]
  notificationRules     NotificationRule[]
  notifications         Notification[]
  conversations         Conversation[]
  messages              Message[]
  knocks                Knock[]
  territories           Territory[]
  photoTemplates        PhotoTemplate[]
  transactions          Transaction[]
  bookkeepingCategories BookkeepingCategory[]
  bookkeepingVendors    BookkeepingVendor[]
  knowledgeCategories   KnowledgeCategory[]
  scopeOfWorks          ScopeOfWork[]
  scopeLines            ScopeLine[]
  scopeTemplateItems    ScopeTemplateItem[]
  scopeCatalogItems     ScopeCatalogItem[]
  scopeCostTemplates    ScopeCostTemplate[]
  scopeSupplementTemplates ScopeSupplementTemplate[]
  proposals             Proposal[]
  reviews               Review[]
  solarSettings         SolarSettings?
  solarEquipment        SolarEquipment[]
  solarDesigns          SolarDesign[]
  solarFinance          SolarFinance[]
  creditApplications    CreditApplication[]
  solarProposals        SolarProposal[]
  solarMilestones       SolarMilestone[]
  dealFeedPosts         DealFeedPost[]

  @@map("companies")
}

model CompanySettings {
  id                      String   @id @default(uuid())
  companyId               String   @unique
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logoUrl                 String?
  primaryColor            String   @default("#0B0B0C")
  accentColor             String   @default("#BFA15F")
  faviconUrl              String?
  fontFamily              String?
  recordPrefix            String   @default("")
  supportPhone            String?
  supportEmail            String?
  currencyCode            String   @default("USD")
  locale                  String   @default("en-US")
  businessHours           Json     @default("{}")
  emailFromName           String?
  customDomain            String?  @unique
  removePoweredBy         Boolean  @default(false)
  requiredDocuments       Json     @default("[]")
  emailTemplates          Json     @default("{}")
  smsTemplates            Json     @default("{}")
  rolePermissions         Json     @default("{}") // per-role overrides on top of code matrix
  // Customizable appointment outcomes ("dispositions") — JSON array of labels.
  // Empty/unset falls back to DEFAULT_APPOINTMENT_DISPOSITIONS in code.
  appointmentDispositions Json     @default("[]")
  // Customizable inspection outcomes — JSON array of labels. Empty falls back to
  // DEFAULT_INSPECTION_OUTCOMES in code.
  inspectionOutcomes      Json     @default("[]")
  // Default production QC checklist applied to new jobs — JSON array of labels.
  // Empty falls back to DEFAULT_QC in code.
  qcChecklistTemplate     Json     @default("[]")
  // Customizable insurance claim statuses — JSON array of { key, label }. Empty
  // falls back to DEFAULT_CLAIM_STATUSES in code. The key is frozen on create so
  // renaming a status never breaks the code that keys off it (scope gating).
  claimStatuses           Json     @default("[]")
  // Bookkeeping integration (bank / QuickBooks). Key stored for the connector.
  bookkeepingProvider     String? // "quickbooks" | "plaid" | "manual"
  bookkeepingApiKey       String?
  // Weekly open-task reminder digest (cron). On by default; toggled in Settings.
  weeklyTaskRemindersEnabled Boolean @default(true)
  // Weekly "overdue jobs" digest to managers/admins (cron). On by default; toggled in Settings.
  overdueDigestEnabled       Boolean @default(true)
  // Email each signer a copy of the executed PDF when a document is fully signed.
  // On by default; toggled in Settings → Notification Rules.
  emailSignedCopyToSigners   Boolean @default(true)
  // Storm Intelligence search area. Null = default (Dallas @ 100mi in code). The
  // daily SPC import + storm map/checker all key off this center + radius.
  stormCenterLat          Float?
  stormCenterLng          Float?
  stormRadiusMiles        Int?
  // ── Isolation boundary levers (stubs; both default to shared) ─────────────
  // Anexa is one legal entity: one employee roster, one general ledger. Books
  // and team are therefore SHARED but SEGMENTED — every transaction, commission
  // and job carries its vertical so the P&L breaks out by department and still
  // reconciles to the company total.
  //
  // These two switches are the documented extension point for splitting them
  // fully later (separate ledgers / separate rosters per vertical). Turning
  // either on means promoting the TAGGED models in src/server/vertical/models.ts
  // to SCOPED; nothing reads them yet, by design.
  isolateBooks            Boolean  @default(false)
  isolateTeam             Boolean  @default(false)
  // Per-vertical overrides for the SCALAR settings above, keyed by vertical:
  //   { "solar": { "logoUrl": "...", "primaryColor": "#...", "recordPrefix": "PS-" } }
  //
  // The columns above stay the company/Roofing values. A vertical with no entry
  // here inherits them, which is what lets Solar branding start empty and fall
  // back rather than render blank — and is why Roofing is untouched: with no
  // "roofing" key, every read returns the same column it always did.
  //
  // JSON settings (emailTemplates, requiredDocuments, …) are NOT here; they
  // carry their own per-vertical keys via lib/vertical-config.
  verticalOverrides       Json     @default("{}")
  updatedAt               DateTime @updatedAt

  @@map("company_settings")
}

model User {
  id                    String     @id @default(uuid())
  companyId             String
  company               Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email                 String
  passwordHash          String?
  firstName             String
  lastName              String
  phone                 String?
  role                  Role       @default(sales_rep)
  status                UserStatus @default(active)
  avatarUrl             String?
  title                 String?
  // Sequential employee number per company (join order). Formatted on display as
  // <recordPrefix><5-digit>, e.g. AH-00001. Lower = earlier hire = higher rank.
  employeeNo            Int?
  // Rep's share (%) of the profit pool on a SELF-GENERATED lead (standard split).
  commissionSplitPct    Float?
  // Company-provided-lead comp is EITHER a percentage of the pool OR a flat lead
  // fee deducted from the rep's self-gen commission. providedLeadType picks which.
  providedLeadType      String     @default("percentage") // "percentage" | "flat"
  // Rep's share (%) when the COMPANY provided the lead (percentage mode).
  providedLeadSplitPct  Float?
  // Flat lead/marketing fee (cents) subtracted from the rep's self-gen commission (flat mode).
  providedLeadFlatCents Int?
  // Rep's share (%) of the customer-paid deductible on their deals (separate from
  // the profit-pool split). null/0 = this rep doesn't get the deductible.
  deductiblePct         Float?
  // Verticals this user may open and switch between. New users start in Roofing
  // only; the super admin grants Solar explicitly. Retired values on existing
  // rows are filtered out by allowedVerticals() and can never surface.
  verticals             Vertical[] @default([roofing]) @map("industries")
  // For canvassers: the sales rep they're assigned to. Their knocks, leads, and
  // appointments auto-assign to (and are visible by) this rep.
  salesRepId            String?
  salesRep              User?      @relation("RepCanvassers", fields: [salesRepId], references: [id], onDelete: SetNull)
  canvassers            User[]     @relation("RepCanvassers")
  // For sales reps: the sales manager they report to. The manager sees this rep's
  // deals, canvassing, tasks, and commissions — and nothing outside their team.
  managerId             String?
  manager               User?      @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports               User[]     @relation("ManagerReports")
  permissions           Json       @default("{}") // per-user permission overrides
  sessionVersion        Int        @default(1)
  lastLoginAt           DateTime?
  // Soft delete: set (with status=disabled) to remove from the roster while
  // keeping the row so historical deals keep showing the rep's name.
  deletedAt             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  leadsAssigned   Lead[]               @relation("LeadAssignedRep")
  leadsCreated    Lead[]               @relation("LeadCreatedBy")
  customerLeads   Lead[]               @relation("LeadCustomerUser")
  projectsManaged Project[]            @relation("ProjectManager")
  tasksAssigned   Task[]               @relation("TaskAssignee")
  tasksCreated    Task[]               @relation("TaskCreatedBy")
  notes           Note[]
  filesUploaded   FileAsset[]
  dailyReports    DailyReport[]
  commissions     Commission[]         @relation("CommissionUser")
  overridesEarned CommissionOverride[] @relation("OverrideBeneficiary")
  overridesOnMe   CommissionOverride[] @relation("OverrideSource")
  payrollItems    PayrollItem[]
  activityLogs    ActivityLog[]
  crewMemberships CrewMember[]
  invitationsSent Invitation[]         @relation("InviteInviter")
  passwordResets  PasswordResetToken[]
  notifications   Notification[]

  conversationsCreated Conversation[]       @relation("ConversationCreator")
  conversationMembers  ConversationMember[] @relation("ConvMemberUser")
  messagesSent         Message[]            @relation("MessageSender")
  knocks               Knock[]              @relation("KnockRep")
  territoriesAssigned  Territory[]          @relation("TerritoryRep")
  territoriesCreated   Territory[]          @relation("TerritoryCreator")
  onboarding           UserOnboarding?
  proposalsCreated     Proposal[]           @relation("ProposalCreatedBy")
  reviewsApproved      Review[]             @relation("ReviewApprover")
  feedPosts            DealFeedPost[]       @relation("FeedAuthor")

  @@unique([companyId, email])
  @@unique([companyId, employeeNo])
  @@index([companyId, role, status])
  @@index([companyId, salesRepId])
  @@index([companyId, managerId])
  @@map("users")
}

model Invitation {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String?
  invitedBy   User?     @relation("InviteInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// CRM: leads, pipeline, projects
// ---------------------------------------------------------------------------

model LeadSource {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(roofing)
  name      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  leads Lead[]

  // Roofing and Solar each keep their own sources ("Door Knock", "Referral"…).
  @@unique([companyId, vertical, name])
  @@map("lead_sources")
}

model Pipeline {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  vertical  Vertical @default(roofing) @map("industry") // each vertical has its own pipeline + stages
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  stages PipelineStage[]
  leads  Lead[]

  // Roofing and Solar may each have a pipeline of the same name.
  @@unique([companyId, vertical, name])
  @@index([companyId, vertical], map: "pipelines_companyId_industry_idx")
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  key        String
  position   Int      @default(0)
  color      String   @default("#A1A1AA")
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  /// Whether we control completion (hard SLA) or are waiting on someone else
  /// (follow-up cadence). See StageType.
  stageType             StageType @default(internally_owned)
  /// The DEPARTMENT ROLE that owns this stage's work — a key from
  /// STAGE_OWNERS in src/lib/solar-pipeline.ts, never a named person, so work
  /// keeps routing correctly as staff change.
  ownerRole             String?
  /// externally_blocked only: chase every N days. 0 = no cadence.
  followUpDays          Int     @default(0)
  /// True for "action required" sub-states (redlines, corrections) — the ball is
  /// in someone's court and the deal cannot advance until it is cleared.
  isActionRequired      Boolean @default(false)
  /// Who a deal landing here is waiting on by default. Copied onto the deal on
  /// entry; a coordinator can override per deal.
  defaultBlocker        BlockerParty?
  // SLA / stage-duration tracking. targetDays 0 = no tracking on this stage.
  // internally_owned only — an externally_blocked stage must never carry a
  // completion deadline.
  targetDays            Int     @default(0)
  escalationDays        Int     @default(0)
  notificationRecipient String  @default("none") // none | assigned_user | team_manager | project_owner | department_manager | everyone
  sendInApp             Boolean @default(true)
  sendEmail             Boolean @default(false)
  markOverdue           Boolean @default(false)
  createdAt  DateTime @default(now())

  leads Lead[]

  @@unique([pipelineId, key])
  @@map("pipeline_stages")
}

model Lead {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Contact
  firstName String
  lastName  String
  // Optional co-owner / co-signer on the deal (e.g. spouse). Maps to the
  // "Co-owner" autofill token + co-homeowner slots on document templates.
  coOwnerName String?
  /// Preferred spoken language for calls, visits and door-knocks. Free text,
  /// deliberately not an enum: which languages a company serves is business
  /// config, and an enum would need a migration every time someone adds
  /// Vietnamese. Applies to any vertical — a roofing customer has a preferred
  /// language too.
  preferredLanguage String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  // Geocoded coordinates for the canvassing map (filled from the address by the
  // geocode-leads cron). geocodedAt marks the attempt so it isn't retried forever.
  lat        Float?
  lng        Float?
  geocodedAt DateTime?

  // Pipeline
  pipelineId String?
  pipeline   Pipeline?      @relation(fields: [pipelineId], references: [id])
  stageId    String?
  stage      PipelineStage? @relation(fields: [stageId], references: [id])
  position   Int            @default(0) // order within stage column

  // Which isolated vertical workspace this deal belongs to (Roofing / Solar).
  vertical    Vertical    @default(roofing) @map("industry")
  status      LeadStatus  @default(open)
  serviceType ServiceType @default(roofing)
  // Cash (out-of-pocket / financing) vs insurance (filed claim). Drives whether the
  // claim section, scope of work, and the insurance proposal financials apply.
  dealType    DealType    @default(insurance)
  priority    Priority    @default(medium)
  value       Int         @default(0) // estimated job value (rep's estimate), cents
  // The CONTRACT price from the insurance scope, set after the Scope Received
  // inspection. When set, this (not `value`) is the deal's contract value and
  // drives the profit pool / commissions. Cents.
  claimPrice  Int?

  // Estimated property (home) value, carried from a canvassing knock. Cents.
  propertyValue       Int?
  propertyValueSource String?
  // Full estimate snapshot: range, confidence, last sale, assessed, beds/baths/sqft/year.
  propertyData        Json?

  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  assignedRepId String?
  assignedRep   User?   @relation("LeadAssignedRep", fields: [assignedRepId], references: [id])
  createdById   String?
  createdBy     User?   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  // Linked customer portal user (role=customer)
  customerUserId String?
  customerUser   User?   @relation("LeadCustomerUser", fields: [customerUserId], references: [id])

  appointmentAt          DateTime?
  // Outcome of running the appointment (e.g. sold, follow-up, no-show) + a note.
  appointmentDisposition String?
  appointmentNote        String?
  // Inspection result recorded after the appointment / when opening the claim + a note.
  inspectionOutcome      String?
  inspectionNote         String?
  /// A key from the company's customizable claim-status list (Settings → Claim
  /// Statuses). The nine built-in keys are the old enum values, so `isScopeReady`
  /// and every historical row keep working.
  claimStatus            String      @default("not_filed")
  notes                  String?
  customFields           Json        @default("{}")

  // When the deal last entered its current pipeline stage — drives the
  // "days in this status" age badge on pipeline cards. Null = use createdAt.
  stageChangedAt DateTime?
  // SLA tracking: which alerts have fired this stage (0 none, 1 target, 2 escalation),
  // reset to 0 on every stage move. stageOverdue is set by the alert job when a stage
  // with markOverdue is exceeded. Both apply to internally_owned stages only.
  stageAlertLevel Int     @default(0)
  stageOverdue    Boolean @default(false)

  // ── Externally-blocked tracking ─────────────────────────────────────────
  /// Who this deal is waiting on right now. Seeded from the stage's
  /// defaultBlocker on entry; a coordinator can correct it per deal.
  blockedBy       BlockerParty?
  /// What exactly we are waiting for ("plan review round 2", "meter spot").
  blockerNote     String?
  /// When WE last chased the blocker. This — not time-in-stage — is what the
  /// follow-up cadence measures, so a utility's queue never reads as our delay.
  lastTouchAt     DateTime?
  /// When the chase reminder last fired, so the cadence repeats instead of
  /// firing once and going quiet.
  lastChaseAlertAt DateTime?

  // ── Solar → Roofing crossover ───────────────────────────────────────────
  /// Flagged at site survey / design: the roof must be replaced before install.
  /// The highest-margin cross-sell we have — surfaced as its own card on the
  /// deal, never buried in a note.
  needsReroof     Boolean @default(false)
  /// Flagged at site survey / design: main panel upgrade or derate required.
  needsMpu        Boolean @default(false)
  /// The deal in the OTHER vertical for the same property/contact (a solar deal
  /// pointing at its re-roof job, or vice versa). One relationship, two jobs.
  linkedDealId    String?
  linkedDeal      Lead?   @relation("DealCrossover", fields: [linkedDealId], references: [id], onDelete: SetNull)
  linkedFromDeals Lead[]  @relation("DealCrossover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project          Project?
  claims           Claim[]
  roofMeasurements RoofMeasurement[]
  tasks            Task[]
  noteEntries      Note[]
  files            FileAsset[]
  documentPackages DocumentPackage[]
  activityLogs     ActivityLog[]
  knocks           Knock[]           @relation("KnockLead")
  scope            ScopeOfWork?
  proposals        Proposal[]
  solarDesign      SolarDesign?
  solarFinance     SolarFinance?
  creditApplications CreditApplication[]
  solarProposals   SolarProposal[]
  solarMilestones  SolarMilestone[]
  feedPosts        DealFeedPost[]

  @@index([companyId, stageId])
  @@index([companyId, assignedRepId])
  @@index([companyId, status])
  @@index([companyId, vertical], map: "leads_companyId_industry_idx")
  @@map("leads")
}

model Project {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical            Vertical @default(roofing)
  leadId    String  @unique
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  projectNumber String
  status        ProjectStatus @default(not_started)
  serviceType   ServiceType   @default(roofing)
  priority      Priority      @default(medium)

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  // Property / scope
  address             String?
  city                String?
  state               String?
  zip                 String?
  roofingType         String?
  materialSelection   String?
  squares             Float?
  pitch               String?
  tearOffLayers       Int?
  contractValue       Int     @default(0) // cents (base scope)
  // Approved supplement + customer-paid deductible. Both add to the effective
  // contract value used for the profit-pool / rep-commission math.
  supplementCents     Int     @default(0)
  deductibleCents     Int     @default(0)
  depreciationCents   Int     @default(0)
  // Per-deal: is the supplement / depreciation included in the rep+manager split
  // pool? Off when the rep is paid upfront and the company waits on that money.
  // The deductible is never in the split pool — the rep is paid its own % of it.
  repGetsSupplement   Boolean @default(true)
  repGetsDepreciation Boolean @default(true)
  // True when the COMPANY provided the lead/appointment (vs. rep self-gen). Picks
  // which rep split applies: providedLeadSplitPct vs the standard commissionSplitPct.
  companyProvidedLead Boolean @default(false)

  // Scheduling / production
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  // Insurance adjuster meeting date (set once the deal reaches adjuster-scheduled).
  adjusterMeetingAt DateTime?
  // Scheduled installation date.
  installDate       DateTime?
  // Scheduled inspection (solar: AHJ / utility inspection after install).
  // Nullable and unused by roofing, whose calendar keeps its existing set.
  inspectionAt      DateTime?
  completedAt       DateTime?
  notes             String?
  customFields      Json      @default("{}")

  // Closeout
  qcChecklist   Json @default("[]") // [{ label, done }]
  closeoutSheet Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims           Claim[]
  roofMeasurements RoofMeasurement[]
  crewAssignments  ProjectCrew[]
  tasks            Task[]
  noteEntries      Note[]
  files            FileAsset[]
  dailyReports     DailyReport[]
  documentPackages DocumentPackage[]
  invoices         Invoice[]
  commissions      Commission[]
  activityLogs     ActivityLog[]
  costs            ProjectCost[]

  @@unique([companyId, projectNumber])
  @@index([companyId, status])
  @@index([companyId, managerId])
  @@index([companyId, vertical])
  @@map("projects")
}

enum ProjectCostType {
  labor
  material
  other
}

// A per-deal cost line (labor/material invoice). Sum of these is the job cost
// subtracted (with company overhead) before the rep/company profit split.
model ProjectCost {
  id          String          @id @default(uuid())
  companyId   String // scalar tenancy key
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical    Vertical?
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        ProjectCostType @default(material)
  label       String // invoice name / description
  vendor      String? // who it's from (installer / supplier)
  amount      Int             @default(0) // cents
  fileAssetId String? // optional attached invoice
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([companyId, projectId])
  @@map("project_costs")
}

// ---------------------------------------------------------------------------
// Insurance claims (roofing / storm)
// ---------------------------------------------------------------------------

model Claim {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical                Vertical @default(roofing)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  carrier                 String?
  claimNumber             String?
  policyNumber            String?
  adjusterName            String?
  adjusterPhone           String?
  adjusterEmail           String?
  lossDate                DateTime?
  adjusterMeetingAt       DateTime?
  /// Same customizable key space as `Lead.claimStatus` — see claim-status.ts.
  status                  String      @default("filed")
  rcv                     Int         @default(0) // replacement cost value, cents
  acv                     Int         @default(0) // actual cash value, cents
  deductible              Int         @default(0)
