// ---------------------------------------------------------------------------
// Document signer (DocuSign-style)
// ---------------------------------------------------------------------------

model DocumentTemplate {
  id           String               @id @default(uuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  type         DocumentTemplateType @default(custom)
  // Vertical workspace this contract template belongs to (each has its own set).
  vertical     Vertical             @default(roofing) @map("industry")
  description  String?
  // Page model: array of { width, height } in PDF points. Default = US Letter pages.
  pages        Json                 @default("[]")
  // Body content blocks rendered to PDF: [{ page, type:'heading'|'text', text, x, y }]
  body         Json                 @default("[]")
  // Storage key of an uploaded source PDF. When set, fields are stamped onto it.
  sourcePdfKey String?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  fields   DocumentTemplateField[]
  packages DocumentPackage[]

  @@index([companyId, type])
  @@index([companyId, vertical], map: "document_templates_companyId_industry_idx")
  @@map("document_templates")
}

model DocumentTemplateField {
  id           String             @id @default(uuid())
  templateId   String
  template     DocumentTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  page         Int                @default(1)
  x            Float
  y            Float
  width        Float              @default(160)
  height       Float              @default(40)
  type         DocumentFieldType
  signerRole   DocumentSignerRole @default(customer)
  label        String?
  required     Boolean            @default(true)
  // Auto-fill token, e.g. {{customer.fullName}}, {{project.address}}
  valueToken   String?
  // Fallback value used when the bound CRM field is empty for a given record.
  defaultValue String?
  createdAt    DateTime           @default(now())

  @@index([templateId])
  @@map("document_template_fields")
}

model DocumentPackage {
  id           String                @id @default(uuid())
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical     Vertical @default(roofing)
  templateId   String?
  template     DocumentTemplate?     @relation(fields: [templateId], references: [id])
  leadId       String?
  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  status       DocumentPackageStatus @default(draft)
  // Snapshot of template body + fields at send time so edits don't mutate sent docs
  snapshot     Json                  @default("{}")
  signedFileId String?
  signedFile   FileAsset?            @relation("PackageSignedFile", fields: [signedFileId], references: [id])
  sentAt       DateTime?
  completedAt  DateTime?
  voidedAt     DateTime?
  expiresAt    DateTime?
  createdById  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  signers DocumentSigner[]
  values  DocumentFieldValue[]
  events  DocumentEvent[]

  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, vertical])
  @@map("document_packages")
}

model DocumentSigner {
  id            String             @id @default(uuid())
  companyId     String
  packageId     String
  package       DocumentPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  role          DocumentSignerRole
  order         Int                @default(1)
  name          String
  email         String?
  status        SignerStatus       @default(pending)
  tokenHash     String             @unique
  signatureType SignatureType?
  signatureData String? // data URL of drawn/typed signature image
  consentAt     DateTime?
  viewedAt      DateTime?
  signedAt      DateTime?
  ip            String?
  userAgent     String?
  // Geolocation captured at signing (only if the signer grants browser permission).
  latitude      Float?
  longitude     Float?
  geoAccuracy   Float? // meters
  createdAt     DateTime           @default(now())

  values DocumentFieldValue[]

  @@index([companyId, packageId, order])
  @@map("document_signers")
}

// Filled value for a field (per package), captured at signing time.
model DocumentFieldValue {
  id        String            @id @default(uuid())
  packageId String
  package   DocumentPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  signerId  String?
  signer    DocumentSigner?   @relation(fields: [signerId], references: [id], onDelete: Cascade)
  fieldKey  String // template field id reference within snapshot
  type      DocumentFieldType
  page      Int               @default(1)
  x         Float             @default(0)
  y         Float             @default(0)
  width     Float             @default(160)
  height    Float             @default(40)
  value     String? // text/date/checkbox value or signature data URL
  filledAt  DateTime?

  @@index([packageId])
  @@map("document_field_values")
}

model DocumentEvent {
  id        String            @id @default(uuid())
  companyId String
  packageId String
  package   DocumentPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  signerId  String?
  type      DocumentEventType
  actor     String? // name/email/system
  ip        String?
  userAgent String?
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now())

  @@index([companyId, packageId, createdAt])
  @@map("document_events")
}

// ---------------------------------------------------------------------------
// Payroll & commissions
// ---------------------------------------------------------------------------

model CommissionRule {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical    Vertical @default(roofing)
  name        String
  // Commission category this rule pays out to. Not a user Role — it includes
  // "project_manager" (the project's assigned manager via Project.managerId).
  // One of: "sales_rep" | "manager" | "project_manager" | "installer".
  role        String
  type        CommissionType @default(percentage)
  // For percentage: percent (e.g. 10 = 10% of base). For flat: amount cents. For job_cost: percent of margin.
  percent     Float          @default(0)
  flatAmount  Int            @default(0)
  projectType String? // optional filter, matches Project.roofingType
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  commissions Commission[]

  @@index([companyId, role])
  @@map("commission_rules")
}

model Commission {
  id             String              @id @default(uuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical       Vertical?
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation("CommissionUser", fields: [userId], references: [id])
  ruleId         String?
  rule           CommissionRule?     @relation(fields: [ruleId], references: [id])
  // Set when this line is an override (X earns off Y's deal); distinguishes it
  // from the recipient's own split line so both can coexist + recompute cleanly.
  overrideId     String?
  override       CommissionOverride? @relation(fields: [overrideId], references: [id], onDelete: SetNull)
  label          String?
  baseAmount     Int                 @default(0) // cents the commission was computed from
  amount         Int                 @default(0) // computed commission, cents
  // Snapshot of the split terms at generation time. Locked once created so editing
  // a rep's split never changes existing deals; re-generating only refreshes the
  // amount from current costs using THESE terms. amount = max(0, pool*splitPct% − splitFlatCents).
  splitPct       Float?
  splitFlatCents Int                 @default(0)
  status         CommissionStatus    @default(pending)
  notes          String?
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  payrollItems PayrollItem[]

  // One commission per (project, recipient, rule) — guards against duplicate generation.
  @@unique([projectId, userId, ruleId])
  @@index([companyId, userId, status])
  @@index([companyId, projectId])
  @@map("commissions")
}

// Person-to-person override: `beneficiary` earns a % of contract (or a flat
// amount) on every deal whose assigned rep is `source`. E.g. a manager earning
// 3% on a rep's deals, or a senior rep earning $500/deal off a junior rep.
//
// Deliberately NOT registered in src/server/vertical/models.ts. Roofing and
// Solar pay differently, so the rate is per vertical (see `vertical` below) —
// but the Team page is a shared roster screen that must show a person's whole
// override sheet, both sides at once. Scoping the model would hide half of it
// from whichever workspace the admin happened to be standing in. The vertical
// is carried as data and matched against the deal's own vertical at payout.
model CommissionOverride {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  beneficiaryId String // who earns the override
  beneficiary   User           @relation("OverrideBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Cascade)
  sourceId      String // whose deals trigger it (the assigned rep)
  source        User           @relation("OverrideSource", fields: [sourceId], references: [id], onDelete: Cascade)
  /// Which side of the business this rate applies to. A rep working both
  /// verticals gets one row per vertical, each with its own type and amount —
  /// an override never pays across the workspace it was written for.
  vertical      Vertical       @default(roofing)
  type          CommissionType @default(percentage) // percentage (of contract) | flat
  percent       Float          @default(0)
  flatAmount    Int            @default(0) // cents per deal
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  commissions Commission[]

  @@unique([companyId, beneficiaryId, sourceId, vertical])
  @@index([companyId, sourceId, vertical])
  @@map("commission_overrides")
}

model PayrollRun {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label       String
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(draft)
  notes       String?
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items PayrollItem[]

  @@index([companyId, status])
  @@map("payroll_runs")
}

model PayrollItem {
  id           String      @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  commissionId String?
  // Cascade: deleting a commission removes its payroll line so run totals can never
  // count a commission that no longer exists (no stale snapshot, no dangling ref).
  commission   Commission? @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  label        String
  amount       Int         @default(0) // cents
  paid         Boolean     @default(false)
  notes        String?
  createdAt    DateTime    @default(now())

  @@index([payrollRunId])
  @@map("payroll_items")
}

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical      Vertical?
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String
  status        InvoiceStatus @default(draft)
  amount        Int           @default(0) // cents
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId, projectId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Notifications (customizable rules engine)
// ---------------------------------------------------------------------------

model NotificationRule {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical @default(roofing)
  name          String
  event         NotificationEvent
  // Event-specific match conditions, e.g. { "stageId": "..." } or { "status": "in_production" }.
  conditions    Json              @default("{}")
  // Who receives it: { roles: Role[], userIds: string[], dynamic: string[] }
  // dynamic targets: assigned_rep | project_manager | customer | lead_creator | all_admins | all_managers
  recipients    Json              @default("{}")
  // Channels: ["in_app","email","sms"]
  channels      Json              @default("[\"in_app\"]")
  titleTemplate String
  bodyTemplate  String
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  notifications Notification[]

  @@index([companyId, event, active])
  @@map("notification_rules")
}

model Notification {
  id        String              @id @default(uuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId    String?
  rule      NotificationRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  event     NotificationEvent
  title     String
  body      String
  link      String?
  channel   NotificationChannel @default(in_app)
  read      Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([companyId, userId, read, createdAt])
  @@map("notifications")
}

// --- Internal team chat ---------------------------------------------------

enum ConversationType {
  dm
  channel
}

model Conversation {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          ConversationType
  name          String? // channel name; null for DMs
  dmKey         String? // sorted "userA:userB" for DM uniqueness; null for channels
  createdById   String?
  createdBy     User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())

  members     ConversationMember[]
  messages    Message[]
  attachments FileAsset[]

  @@unique([companyId, dmKey])
  @@index([companyId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConvMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime     @default(now())

  attachments FileAsset[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --- Door-to-door canvassing (SalesRabbit-style) --------------------------

enum KnockDisposition {
  not_knocked // auto-generated address pin, blank state (hollow)
  not_home
  not_interested
  callback
  appointment
  sold
  not_qualified
  dnk // do not knock
}

model Territory {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical @default(roofing)
  name          String
  color         String   @default("#F4631E")
  polygon       Json // array of [lat, lng] pairs
  assignedRepId String?
  assignedRep   User?    @relation("TerritoryRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?    @relation("TerritoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  knocks Knock[]
  reps   TerritoryRep[]

  @@index([companyId])
  @@index([companyId, assignedRepId])
  @@map("territories")
}

// Join: one or more reps assigned to a territory (multi-rep). assignedRepId on
// Territory remains the "primary" rep; this table holds the full assigned set.
model TerritoryRep {
  id          String    @id @default(uuid())
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  userId      String // scalar tenancy/user key (query by userId for scoping)
  createdAt   DateTime  @default(now())

  @@unique([territoryId, userId])
  @@index([userId])
  @@map("territory_reps")
}

model Knock {
  id                  String           @id @default(uuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical            Vertical @default(roofing)
  repId               String?
  rep                 User?            @relation("KnockRep", fields: [repId], references: [id], onDelete: SetNull)
  territoryId         String?
  territory           Territory?       @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  lat                 Float
  lng                 Float
  address             String?
  city                String?
  state               String?
  zip                 String?
  disposition         KnockDisposition @default(not_home)
  notes               String?
  // Optional homeowner contact captured at the door (for lead conversion).
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  bestTime            String? // best time to reach
  // Cached estimated property value (cents) so we don't re-bill the AVM API per click.
  propertyValue       Int?
  propertyValueSource String?
  propertyValueAt     DateTime?
  propertyData        Json? // full estimate snapshot (range, last sale, assessed, structure)
  // Homeowner skip-trace result (BatchData etc.). Cached so we don't re-bill per click.
  ownerSource         String? // provider label, e.g. "BatchData"
  ownerLookedUpAt     DateTime?
  ownerData           Json? // full result: { names[], phones[], emails[] } for the rep to pick from
  // When the dot was snapped to its OSM rooftop centroid (recenter-house-dots cron).
  recenteredAt        DateTime?
  appointmentAt       DateTime? // set when converted to an appointment
  leadId              String?
  lead                Lead?            @relation("KnockLead", fields: [leadId], references: [id], onDelete: SetNull)
  knockedAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  events KnockEvent[]

  @@index([companyId, repId])
  @@index([companyId, territoryId])
  @@index([companyId, lat, lng])
  @@map("knocks")
}

// AVM property-value cache. Keyed by normalized address (or "lat,lng" fallback)
// so estimates are reused across clicks/companies and we don't re-bill the API.
// Not tenant-scoped: a home's value is the same regardless of who looks it up.
model PropertyValue {
  id         String   @id @default(uuid())
  addressKey String   @unique // normalized address or "lat,lng"
  address    String?
  value      Int? // estimated value in cents; null = provider returned nothing
  source     String // provider label, e.g. "RentCast", "Estated", "ATTOM"
  confidence String? // high | medium | low
  matched    Boolean  @default(false) // did we confidently match a real parcel?
  data       Json? // full estimate: range, last sale, assessed, beds/baths/sqft/year
  asOfDate   DateTime // the estimate's as-of date
  fetchedAt  DateTime @default(now())

  @@map("property_values")
}

// Per-house timeline: status changes + timestamped comments (visit history / audit).
enum KnockEventType {
  created
  status_change
  comment
  contact_update
  lead_created
}

model KnockEvent {
  id          String            @id @default(uuid())
  companyId   String // scalar tenancy key (no relation needed for the audit log)
  knockId     String
  knock       Knock             @relation(fields: [knockId], references: [id], onDelete: Cascade)
  type        KnockEventType
  body        String? // comment / note text
  disposition KnockDisposition? // status at the time of the event
  authorId    String?
  authorName  String? // denormalized so history survives user deletion
  createdAt   DateTime          @default(now())

  @@index([companyId, knockId, createdAt])
  @@map("knock_events")
}

// Aerial roof-measurement report traced on the lead detail page. One per lead
// (re-editable). `facets` stores the traced geometry so it can be reopened.
// ---------------------------------------------------------------------------
// Bookkeeping (lightweight ledger: transactions → categories → P&L)
// ---------------------------------------------------------------------------

model BookkeepingCategory {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  // "income" | "expense" | "asset" | "liability" | "equity"
  type      String   @default("expense")
  // When true, approved transactions in this category are NOT counted as a deal's
  // job cost (e.g. "Contractor Sales" — sales-rep payouts, paid via the profit split).
  excludeFromJobCost Boolean @default(false)
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([companyId, type])
  @@map("bookkeeping_categories")
}

// Vendors / contractors (one concept) — the managed list a transaction is tagged to.
model BookkeepingVendor {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Optional link to a team member (a sales rep paid as a 1099 contractor).
  // One vendor per user; reassignable to a different vendor.
  userId        String?  @unique
  name          String // display name
  companyName   String? // legal / company name
  contactName   String?
  email         String?
  phone         String?
  einTaxId      String? // EIN / Tax ID (1099)
  is1099        Boolean  @default(false)
  address       String?
  city          String?
  state         String?
  zip           String?
  accountNumber String? // our account # with this vendor
  notes         String?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@map("bookkeeping_vendors")
}

model Transaction {
  id            String               @id @default(uuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Shared-but-segmented: reads are never filtered by vertical so the books
  /// stay consolidated, but every row is tagged so the P&L, commissions and
  /// reports break out by department. Null = genuinely company-level.
  vertical      Vertical?
  date          DateTime
  description   String
  // Signed cents: positive = money in (income/deposit), negative = money out (expense).
  amountCents   Int
  vendor        String?
  account       String? // bank / ledger account name (e.g. "Operating Checking")
  categoryId    String?
  category      BookkeepingCategory? @relation(fields: [categoryId], references: [id])
  // Tag a transaction to a deal or invoice (scalar links; resolved in queries).
  projectId     String?
  invoiceId     String?
  status        String               @default("uncategorized") // uncategorized | categorized | reconciled
  // Review workflow: a new/imported txn is auto-suggested a category+vendor, shown
  // highlighted in "To review", and only booked once the user clicks Approve.
  approved      Boolean              @default(false)
  autoSuggested Boolean              @default(false)
  source        String               @default("manual") // manual | import | bank | quickbooks
  externalId    String? // dedup key for imported/synced rows
  notes         String?
  createdById   String?
  attachments   FileAsset[] // receipts / invoices attached to this transaction
  // Bank reconciliation: when cleared against a statement, status="reconciled"
  // and these point at the reconciliation it was settled in.
  reconciledAt     DateTime?
  reconciliationId String?
  reconciliation   Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([companyId, date])
  @@index([companyId, categoryId])
  @@map("transactions")
}

// A completed bank reconciliation: a statement (account + date + ending balance)
// matched against cleared transactions. Kept for the audit trail + report PDF.
model Reconciliation {
  id                    String        @id @default(uuid())
  companyId             String
  account               String
  statementDate         DateTime
  endingBalanceCents    Int
  beginningBalanceCents Int
  clearedCount          Int           @default(0)
  createdById           String?
  createdAt             DateTime      @default(now())
  transactions          Transaction[]

  @@index([companyId, account])
  @@map("reconciliations")
}

// ---------------------------------------------------------------------------
// User onboarding (W-9 / 1099 + direct deposit + ID docs). SSN + account number
// are AES-encrypted at rest; only last-4 is kept in clear for display.
// ---------------------------------------------------------------------------
model UserOnboarding {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Identity
  legalFirstName    String?
  legalMiddleName   String?
  legalLastName     String?
  dateOfBirth       DateTime?
  ssnEnc            String?
  ssnLast4          String?
  address           String?
  city              String?
  state             String?
  zip               String?
  // Direct deposit
  accountHolderName String? // name as it appears on the bank account
  bankName          String?
  routingNumber     String?
  accountEnc        String?
  accountLast4      String?
  accountType       String? // "checking" | "savings"
  accountAddress    String? // address on the bank account (may differ from home)
  // Tax / W-9 (for 1099)
  taxClassification String? // individual | sole_prop | llc | s_corp | c_corp | partnership
  businessName      String?
  einEnc            String?
  einLast4          String?
  signatureName     String?
  signedAt          DateTime?
  // Document uploads (FileAsset ids). ID + SS card are front & back.
  idPhotoFileId     String? // driver's license / government ID — FRONT
  idPhotoBackFileId String? // driver's license / government ID — BACK
  ssnCardFileId     String? // Social Security card — FRONT
  ssnCardBackFileId String? // Social Security card — BACK
  voidedCheckFileId String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("user_onboarding")
}

// ── Knowledge Base / Training ──────────────────────────────────────────────
// Role-gated training library. A category is visible to a non-management user
// only when their role is listed in `visibleRoles`; management roles see all.

enum KnowledgeItemType {
  file // uploaded PDF / doc / image (FileAsset)
  video // embedded video URL (YouTube / Vimeo / Loom)
  link // external resource URL
  article // rich text written in-portal
}

model KnowledgeCategory {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vertical     Vertical        @default(roofing) @map("industry")
  name         String
  description  String?
  position     Int             @default(0)
  // Which roles may see this category. Management roles (super_admin/admin/manager)
  // always see every category regardless of this list.
  visibleRoles Role[]
  items        KnowledgeItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([companyId, vertical], map: "knowledge_categories_companyId_industry_idx")
  @@map("knowledge_categories")
}

model KnowledgeItem {
  id          String            @id @default(uuid())
  companyId   String
  categoryId  String
  category    KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type        KnowledgeItemType
  title       String
  description String?
  position    Int               @default(0)
  fileId      String? // FileAsset id when type=file (plain column, like UserOnboarding)
  url         String? // when type=video | link
  body        String?           @db.Text // when type=article
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId, categoryId])
  @@map("knowledge_items")
}

// ── Scope of Work / Job Profitability Calculator ───────────────────────────
// On-the-spot job costing: per line, what insurance pays vs. our cost → profit.
// 1:1 with the lead/deal (scope is known at "Scope Received", before a Project).

model ScopeOfWork {
  id        String      @id @default(uuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId    String      @unique
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vertical  Vertical    @default(roofing) @map("industry")
  pdfFileId String? // uploaded carrier scope PDF (FileAsset id, plain column)
  notes     String?
  // Public-adjuster fee, as a % of the supplement amount recovered (default 10%).
  // Used to net out the PA's cut when modeling "profit if we supplement".
  paFeePct  Float       @default(10)
  // Estimated insurance deductible (cents). Informational only: of the RCV, the
  // homeowner pays this and the carrier pays the rest — it does NOT change the
  // profit pool. Used on the scope worksheet to show the insurance/homeowner split.
  estDeductibleCents Int @default(0)
  // Selected pricing templates: cost/supplement per unit come from these (by
  // catalog item). Null = none selected. SetNull so deleting a template is safe.
  costTemplateId       String?
  costTemplate         ScopeCostTemplate? @relation(fields: [costTemplateId], references: [id], onDelete: SetNull)
  supplementTemplateId String?
  supplementTemplate   ScopeSupplementTemplate? @relation(fields: [supplementTemplateId], references: [id], onDelete: SetNull)
  lines     ScopeLine[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([companyId, leadId])
  @@map("scopes_of_work")
}

model ScopeLine {
  id                 String      @id @default(uuid())
  companyId          String
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopeId            String
  scope              ScopeOfWork @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  position           Int         @default(0)
  // Catalog link: when set, cost & supplement per unit come from the scope's
  // selected templates (matched by this id). Null = legacy free-text line that
  // keeps its inline costUnitPrice.
  catalogItemId      String?
  catalogItem        ScopeCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  category           String      @default("General")
  description        String      @default("")
  quantity           Float       @default(0)
  unit               String? // sq, sq ft, lf, ea
  insuranceUnitPrice Int         @default(0) // cents — what the carrier currently ALLOWS per unit
  costUnitPrice      Int         @default(0) // cents — our cost per unit (legacy inline; templates override)
  // cents — legacy inline supplemented price; superseded by supplement templates.
  supplementUnitPrice Int        @default(0)
  createdAt          DateTime    @default(now())

  @@index([scopeId])
  @@index([catalogItemId])
  @@map("scope_lines")
}

model ScopeTemplateItem {
  id                        String   @id @default(uuid())
  companyId                 String
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vertical                  Vertical @default(roofing) @map("industry")
  position                  Int      @default(0)
  category                  String   @default("General")
  description               String   @default("")
  unit                      String?
  defaultInsuranceUnitPrice Int      @default(0) // cents
  defaultCostUnitPrice      Int      @default(0) // cents
  defaultSupplementUnitPrice Int     @default(0) // cents — supplemented price per unit
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([companyId, vertical], map: "scope_template_items_companyId_industry_idx")
  @@map("scope_template_items")
}

// Master scope catalog — the company-wide list of possible insurance-restoration
// line items. NO pricing (cost/supplement/insurance prices live in versioned
// templates + the project scope). Organized by category → subcategory, filterable
// by trade.
model ScopeCatalogItem {
  id                    String   @id @default(uuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical              Vertical @default(roofing)
  position              Int      @default(0)
  category              String   @default("General")
  subcategory           String   @default("")
  description           String   @default("")
  unit                  String   @default("EA") // SQ | SF | LF | EA | DAY | SYSTEM | PERCENT | HR
  trade                 String   @default("General")
  isCommonInsuranceItem Boolean  @default(false)
  isSupplementEligible  Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  costTemplateItems       ScopeCostTemplateItem[]
  supplementTemplateItems ScopeSupplementTemplateItem[]
  scopeLines              ScopeLine[]

  @@index([companyId, trade])
  @@index([companyId, category])
  @@map("scope_catalog_items")
}

// ── Versioned pricing templates over the master catalog ─────────────────────
// Cost Templates and Supplement Templates are independent, dated price lists
// that reference catalog items by id. Editing a template price never touches the
// master catalog. A Project's Scope of Work (sub-project 2) selects one of each
// to compute internal cost and supplement potential.

model ScopeCostTemplate {
  id            String                  @id @default(uuid())
  companyId     String
  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical @default(roofing)
  name          String
  description   String?
  effectiveDate DateTime                @default(now())
  isActive      Boolean                 @default(true)
  items         ScopeCostTemplateItem[]
  scopes        ScopeOfWork[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([companyId])
  @@map("scope_cost_templates")
}

model ScopeCostTemplateItem {
  id               String            @id @default(uuid())
  companyId        String
  templateId       String
  template         ScopeCostTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItemId    String
  catalogItem      ScopeCatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  costPerUnitCents Int               @default(0)
  createdAt        DateTime          @default(now())

  @@unique([templateId, catalogItemId])
  @@index([templateId])
  @@map("scope_cost_template_items")
}

model ScopeSupplementTemplate {
  id            String                        @id @default(uuid())
  companyId     String
  company       Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical      Vertical @default(roofing)
  name          String
  description   String?
  effectiveDate DateTime                      @default(now())
  isActive      Boolean                       @default(true)
  items         ScopeSupplementTemplateItem[]
  scopes        ScopeOfWork[]
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([companyId])
  @@map("scope_supplement_templates")
}

model ScopeSupplementTemplateItem {
  id                     String                  @id @default(uuid())
  companyId              String
  templateId             String
  template               ScopeSupplementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItemId          String
  catalogItem            ScopeCatalogItem        @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  supplementPerUnitCents Int                     @default(0)
  reason                 String?
  requiredEvidence       String?
  notes                  String?
  createdAt              DateTime                @default(now())

  @@unique([templateId, catalogItemId])
  @@index([templateId])
  @@map("scope_supplement_template_items")
}

// Customer-facing roofing proposal / presentation (web-first, shareable link).
enum ProposalStatus {
  draft
  generated
  sent
  viewed
  signed
}

model Proposal {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical        Vertical @default(roofing)
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId       String? // set if production has started
  status          ProposalStatus @default(draft)
  // Unguessable public token = the shareable customer link (/present/[token]).
  publicToken     String         @unique
  theme           String         @default("anexa")
  customerName    String // snapshot at create
  propertyAddress String // snapshot at create
  // Editable copy + selections live here: roofType, damageSummary,
  // recommendedNextStep, dateOfLoss, conditionFlags{}, photoCaptions{},
  // includedPhotoIds[], upgrades[], selectedSections[], faq[], whyAnexa[],
  // financialNote. See src/lib/proposal.ts ProposalContent.
  content         Json
  createdById     String
  createdBy       User           @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  viewedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId, leadId])
  @@map("proposals")
}

// Binary file storage when STORAGE_DRIVER=db: bytes live in Postgres so uploads
// work with no external object store. Keyed by the same storage key the S3/local
// drivers use, so switching drivers later needs no call-site changes.
model StoredFile {
  key         String   @id
  data        Bytes
  size        Int
  contentType String?
  createdAt   DateTime @default(now())

  @@map("stored_files")
}

// ---------------------------------------------------------------------------
// Customer Reviews — first-party reviews submitted from the public website.
// New submissions are `pending` and never shown publicly until a staff member
// approves them. The public site reads only: status=approved, deletedAt=null,
// consentToPublish=true, hidden=false. Deletes are soft (deletedAt) so a
// removed review can be audited/restored. Optional photo lives in storage
// (photoKey) and is served via /api/reviews/photo.
// ---------------------------------------------------------------------------

enum ReviewStatus {
  pending
  approved
  rejected
}

model Review {
  id               String       @id @default(uuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerName     String
  city             String?
  // Free-text service label captured from the public form (e.g. "Roofing").
  serviceType      String?
  rating           Int          @default(5)
  reviewText       String
  // Storage key + mime for an optional customer-uploaded photo (legacy single).
  photoKey         String?
  photoMime        String?
  // Storage keys for review photos (of the work/project) — supports multiple.
  photoKeys        String[]     @default([])
  consentToPublish Boolean      @default(false)
  status           ReviewStatus @default(pending)
  featured         Boolean      @default(false)
  // Hidden = approved but temporarily pulled from the public site.
  hidden           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?        @relation("ReviewApprover", fields: [approvedById], references: [id])
  deletedAt        DateTime?

  @@index([companyId, status])
  @@index([companyId, featured])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Storm Intelligence — NOAA Storm Events + SPC reports for canvassing targeting.
// Tenancy via scalar companyId (no Company relation, like KnockEvent — these are
// imported/derived datasets). Geospatial via lat/lng + in-app Haversine (no PostGIS).
// ---------------------------------------------------------------------------

enum StormSource {
  noaa_storm_events
  spc_reports
}

enum StormType {
  hail
  wind
  tornado
}

model StormEvent {
  id           String      @id @default(uuid())
  companyId    String
  source       StormSource
  externalId   String? // NOAA EVENT_ID or SPC composite key — idempotent re-import
  type         StormType
  eventAt      DateTime
  lat          Float
  lng          Float
  hailSizeIn   Float? // hail diameter, inches
  windSpeedMph Int? // wind gust, mph
  tornadoScale String? // EF/F rating, e.g. "EF1"
  magnitude    Float? // raw source magnitude
  city         String?
  county       String?
  state        String?
  zip          String?
  narrative    String?
  raw          Json? // original imported row
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, source, externalId])
  @@index([companyId, type])
  @@index([companyId, eventAt])
  @@index([companyId, lat, lng])
  @@map("storm_events")
}

model StormCanvassingZone {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  centerLat       Float
  centerLng       Float
  radiusMiles     Float    @default(1)
  filtersSnapshot Json? // {types, from, to, minHailIn, minWindMph} used to build it
  eventCount      Int      @default(0)
  totalScore      Int      @default(0)
  assignedRepId   String?
  territoryId     String? // canvassing Territory spawned from this zone
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, assignedRepId])
  @@map("storm_canvassing_zones")
}

model PropertyStormMatch {
  id             String    @id @default(uuid())
  companyId      String
  leadId         String? // set for lead matches (knockId null)
  knockId        String? // set for knock matches (leadId null)
  lat            Float
  lng            Float
  nearestEventId String?
  distanceMiles  Float     @default(0)
  dateOfLoss     DateTime? // most recent significant event nearby
  score          Int       @default(0)
  eventCount     Int       @default(0)
  maxHailIn      Float?
  maxWindMph     Int?
  computedAt     DateTime  @default(now())

  @@unique([companyId, leadId])
  @@unique([companyId, knockId])
  @@index([companyId, score])
  @@map("property_storm_matches")
}

// Radar-derived hail swath polygons (NOAA MRMS MESH daily-max). Universal radar
// data — NOT tenant-scoped (same for everyone), like PropertyValue. One row per
// polygon feature; `rings` holds [lat,lng] coords ready for Leaflet. A bbox is
// stored for cheap region prefiltering.
model StormSwath {
  id         String   @id @default(uuid())
  source     String   @default("mrms_mesh")
  eventDate  DateTime // UTC day of the daily-max swath
  hailMinIn  Float // size-tier lower bound, inches
  rings      Json // [ [ [lat,lng], ... ] (outer), [hole], ... ]
  bboxMinLat Float
  bboxMinLng Float
  bboxMaxLat Float
  bboxMaxLng Float
  createdAt  DateTime @default(now())

  @@index([eventDate])
  @@index([bboxMinLat, bboxMaxLat])
  @@map("storm_swaths")
}

// ---------------------------------------------------------------------------
// Solar domain
//
// Everything below is solar-only. Roofing never creates these rows and never
// renders them; the roofing-only concepts (Claim, the insurance
// scope) are HIDDEN for solar deals rather than dropped, because those tables
// hold live roofing money.
// ---------------------------------------------------------------------------

/// The four financing products. They are NOT variations of one model — they
/// price differently, they carry different fields, and they pay commission on
/// different bases. Treating them as one is how a lease gets quoted with a
/// loan's dealer fee.
enum FinanceProduct {
  /// Customer pays cash. No dealer fee. Priced on system price / PPW.
  cash
  /// Financed purchase. A dealer fee is embedded in the GROSS price; net PPW is
  /// gross minus that fee. Commission on PPW or margin.
  loan
  /// Third party owns the system; customer pays a fixed monthly with an annual
  /// escalator. There is no system price in the cash/loan sense.
  lease
  /// Third party owns the system; customer pays per kWh produced, with an
  /// annual escalator.
  ppa
}

enum CreditStatus {
  not_submitted
  submitted
  approved
  /// Approved subject to stipulations that must be cleared before NTP.
  conditional
  declined
  expired
}

enum MountType {
  roof
  ground
}

/// Catalog item kinds. Adders are rank-ordered so a rep sees them in the order
/// the company wants them sold.
enum SolarEquipmentKind {
  module
  inverter
  battery
  adder
}

/// Per-company Solar assumptions. Deliberately DATA, not code.
///
/// The federal residential-solar credit changed in 2025 and is still moving, so
/// the percentage lives here for the company's CPA to set and change without a
/// deploy. Everything it produces is an ESTIMATE and is labelled as one.
model SolarSettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ── Production assumptions ──────────────────────────────────────────────
  /// System losses (soiling, wiring, inverter, mismatch). 0.84 = 16% loss.
  derateFactor          Float @default(0.84)
  /// Annual production loss from panel ageing, for the 25-year model.
  annualDegradationPct  Float @default(0.5)
  /// Assumed annual utility rate rise, for the savings comparison.
  utilityEscalationPct  Float @default(3.5)
  /// kWh produced per kW-DC per year in this market. Set from local irradiance.
  kwhPerKwYear          Int   @default(1450)

  // ── Pricing defaults ────────────────────────────────────────────────────
  /// Default gross price per watt, in cents (e.g. 350 = $3.50/W).
  defaultGrossPpwCents  Int   @default(350)
  /// Lender dealer fee as a % of gross. Applies to LOAN only — cash has none.
  defaultDealerFeePct   Float @default(18)

  // ── Incentives ──────────────────────────────────────────────────────────
  /// Federal credit %, as an ESTIMATE. NOT hardcoded anywhere in code: the
  /// rules changed in 2025 and are still in flux, so this is set by the
  /// company's CPA. Null = do not show a federal credit at all.
  federalItcPct         Float?
  /// Free-text state/local incentive summary shown on the proposal.
  stateIncentiveNote    String?
  /// The disclaimer rendered anywhere an incentive figure appears. Seeded with
  /// the standard not-a-guarantee wording; editable per company.
  incentiveDisclaimer   String @default("Estimated only and not a guarantee. Tax credits depend on your individual tax situation and on rules that may change. Consult your tax advisor.")

  // ── Validation bounds ───────────────────────────────────────────────────
  // A rep must not be able to generate a physically impossible proposal.
  // These are the guard rails; see src/lib/solar-validation.ts.
  minOffsetPct          Float @default(0)
  maxOffsetPct          Float @default(150)
  minPpwCents           Int   @default(150)
  maxPpwCents           Int   @default(800)

  updatedAt DateTime @updatedAt

  @@map("solar_settings")
}

/// Equipment and adders a rep can pick from. Prices live here so a proposal is
/// built from the catalog rather than typed in free-hand.
model SolarEquipment {
  id        String             @id @default(uuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical           @default(solar)
  kind      SolarEquipmentKind
  manufacturer String?
  model     String
  /// Modules: watts per panel. Inverters: rated output W. Batteries: usable Wh.
  ratingW   Int?
  /// Unit cost to us, cents.
  costCents Int                @default(0)
  /// What the customer pays, cents. For adders this is the adder price.
  priceCents Int               @default(0)
  /// Adders only: display order, so the highest-margin ones lead.
  rank      Int                @default(0)
  /// Adders only: ties an adder to the Phase-3 crossover so picking "Re-roof"
  /// or "MPU" on a design raises the flag on the deal rather than quietly
  /// becoming a line item. One of: "reroof" | "mpu" | null.
  crossoverKind String?
  specs     Json               @default("{}")
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  designsAsModule   SolarDesign[] @relation("DesignModule")
  designsAsInverter SolarDesign[] @relation("DesignInverter")
  designsAsBattery  SolarDesign[] @relation("DesignBattery")

  @@index([companyId, kind, isActive])
  @@map("solar_equipment")
}

/// The engineering truth for one solar deal: what the utility bill says, what
/// the roof looks like, and what we are going to build.
model SolarDesign {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String  @unique
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // ── Utility & usage ─────────────────────────────────────────────────────
  utilityProvider    String?
  ratePlan           String?
  utilityAccountNo   String?
  meterNo            String?
  /// Net metering / buyback programme name.
  netMeteringProgram String?
  /// 12 monthly kWh readings, Jan..Dec. The basis for offset — a design that
  /// does not track usage is the thing validation rejects.
  monthlyUsageKwh    Json    @default("[]")
  annualUsageKwh     Int?
  avgMonthlyBillCents Int?

  // ── Site ────────────────────────────────────────────────────────────────
  mountType        MountType @default(roof)
  /// [{ name, azimuth, tilt, moduleCount, shadingPct }]
  roofPlanes       Json      @default("[]")
  /// Total Solar Resource Fraction, %. Below ~75 is a shading problem.
  tsrfPct          Float?
  setbackNotes     String?
  structuralNotes  String?
  electricalNotes  String?

  // ── System ──────────────────────────────────────────────────────────────
  moduleId       String?
  module         SolarEquipment? @relation("DesignModule", fields: [moduleId], references: [id], onDelete: SetNull)
  moduleQty      Int             @default(0)
  inverterId     String?
  inverter       SolarEquipment? @relation("DesignInverter", fields: [inverterId], references: [id], onDelete: SetNull)
  batteryId      String?
  battery        SolarEquipment? @relation("DesignBattery", fields: [batteryId], references: [id], onDelete: SetNull)
  batteryQty     Int             @default(0)
  systemSizeKwDc Float           @default(0)
  systemSizeKwAc Float           @default(0)
  year1ProductionKwh Int         @default(0)
  offsetPct      Float           @default(0)

  // ── Plan-set artifacts (FileAsset ids, plain columns) ───────────────────
  planSetFileId    String?
  singleLineFileId String?
  loadCalcFileId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, vertical])
  @@map("solar_designs")
}

/// The money for one solar deal. Which columns matter depends entirely on
/// `product` — see FinanceProduct. Cash/loan use the PPW block; lease/PPA use
/// the rate block. They are never mixed.
model SolarFinance {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String  @unique
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  product FinanceProduct @default(cash)

  // ── Cash / Loan ─────────────────────────────────────────────────────────
  /// Sticker price per watt, cents. Includes the dealer fee on a LOAN.
  grossPpwCents  Int   @default(0)
  /// Lender fee as a % of gross. Zero for cash by definition.
  dealerFeePct   Float @default(0)
  /// Sum of selected adders, cents.
  adderTotalCents Int  @default(0)
  /// Final contract price, cents.
  contractPriceCents Int @default(0)
  /// Estimated federal credit, cents. An ESTIMATE — see SolarSettings.
  itcEstimateCents Int @default(0)

  // ── Lease / PPA ─────────────────────────────────────────────────────────
  /// PPA only: price per kWh in tenths of a cent (e.g. 145 = $0.145/kWh).
  rateMillsPerKwh Int?
  /// Lease only: fixed monthly payment, cents.
  monthlyPaymentCents Int?
  /// Annual payment/rate increase, %. Applies to lease and PPA.
  escalatorPct   Float?
  termYears      Int?

  // ── Loan terms (from the approved credit application) ────────────────────
  aprPct         Float?
  loanTermMonths Int?
  /// Cash the customer puts down, reducing the financed amount. Cents.
  downPaymentCents Int?
  /// The lender's OWN monthly payment figure, cents. Deliberately STORED and
  /// never derived from amount + APR + term: promotional periods, fees and
  /// re-amortisation all mean a computed figure can contradict the real one,
  /// and the number a customer is quoted has to be the number the lender
  /// issued. Distinct from `monthlyPaymentCents` above, which is LEASE-only.
  loanMonthlyPaymentCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, vertical])
  @@map("solar_finance")
}

/// One submission to one lender. A deal can have several (declined by one,
/// approved by another), so this is not 1:1.
model CreditApplication {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  lender        String
  status        CreditStatus @default(not_submitted)
  /// The lender's own application id — the key the webhook matches on.
  externalId    String?
  amountCents   Int          @default(0)
  termMonths    Int?
  aprPct        Float?
  dealerFeePct  Float?
  /// Conditions that must be cleared before NTP, e.g. proof of income.
  stipulations  Json         @default("[]")
  submittedAt   DateTime?
  decidedAt     DateTime?
  expiresAt     DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, lender, externalId])
  @@index([companyId, leadId])
  @@index([companyId, status])
  @@map("credit_applications")
}

/// A versioned, customer-facing solar proposal.
///
/// The snapshot is the point. Every figure the homeowner sees is FROZEN at
/// generation time — the assumptions, the design, the money, all of it. When
/// the CPA changes the ITC percentage next month, a proposal already sent must
/// still show what that customer was shown, or the document is worthless as a
/// record of what was offered.
///
/// Versions are never overwritten: regenerating supersedes and keeps the old
/// one, so the trail of what was offered and when survives intact.
model SolarProposal {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  version   Int
  status    ProposalStatus @default(draft)
  /// Unguessable public token = the shareable customer link (/proposal/[token]).
  publicToken String @unique

  /// The frozen document. See SolarProposalSnapshot in src/lib/solar-proposal.ts.
  snapshot  Json

  /// Set when a newer version replaces this one.
  supersededAt DateTime?
  /// The e-sign envelope, once sent for signature.
  documentPackageId String?

  createdById String?
  sentAt      DateTime?
  viewedAt    DateTime?
  signedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events SolarProposalEvent[]

  @@unique([leadId, version])
  @@index([companyId, leadId])
  @@map("solar_proposals")
}

/// Append-only audit trail for a proposal: who did what, when, from where.
model SolarProposalEvent {
  id         String        @id @default(uuid())
  proposalId String
  proposal   SolarProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// generated | sent | viewed | signed | superseded
  type       String
  actorId    String?
  actorName  String?
  ip         String?
  detail     String?
  createdAt  DateTime      @default(now())

  @@index([proposalId, createdAt])
  @@map("solar_proposal_events")
}

/// Who a milestone pays.
enum MilestonePayee {
  /// M1 / M2 / M3 — the rep's commission tranches.
  rep
  /// 1st / 2nd / 3rd — the financier's payments to us.
  financier
}

/// A scheduled payment on a solar deal.
///
/// NEW DATA — this was not captured before. The pricing breakdown on the deal
/// (base PPW, adders, dealer fee, final PPW) is all derived from figures we
/// already store, but *when the money actually arrives* was not modelled
/// anywhere: commission tranches and financier draws both pay out against
/// milestones (contract, install, PTO), and that schedule is what a rep and a
/// controller actually want to see on the deal.
model SolarMilestone {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(solar)
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  payee     MilestonePayee
  /// 1, 2, 3 — M1/M2/M3 for the rep, 1st/2nd/3rd for the financier.
  sequence  Int
  label     String
  amountCents Int      @default(0)
  /// What has to happen for this to pay (e.g. "Install complete").
  trigger   String?
  expectedAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, payee, sequence])
  @@index([companyId, leadId])
  @@map("solar_milestones")
}

/// Which audience a feed post is for.
enum FeedChannel {
  /// Visible to the customer in their portal.
  external
  /// Staff only — never shown to the homeowner.
  internal
  /// Written by, or addressed to, the homeowner.
  customer
}

/// A post on a deal's activity feed.
///
/// NEW DATA. ActivityLog already records SYSTEM events, but it has no audience
/// and no way to address a colleague — so a coordinator asking "did anyone
/// chase the utility?" had nowhere to put it. Posts carry a channel so internal
/// chatter can never leak to the homeowner, and @mentions notify by email.
model DealFeedPost {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Isolated per vertical: this row belongs to exactly one workspace.
  vertical  Vertical @default(roofing)
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  channel   FeedChannel @default(internal)
  body      String      @db.Text
  authorId  String?
  author    User?       @relation("FeedAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// User ids extracted from @mentions, notified on create.
  mentions  String[]

  createdAt DateTime @default(now())

  @@index([companyId, leadId, createdAt])
  @@map("deal_feed_posts")
}
