model FileAsset {
  id                  String             @id @default(uuid())
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind                FileKind           @default(document)
  name                String
  storageKey          String
  mimeType            String?
  size                Int                @default(0)
  category            String? // e.g. "before", "after", "contract", or a photo slot label
  leadId              String?
  lead                Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // CompanyCam-style: links a photo to a checklist slot.
  photoTemplateItemId String?
  photoTemplateItem   PhotoTemplateItem? @relation(fields: [photoTemplateItemId], references: [id], onDelete: SetNull)
  // Team-chat attachments: a file shared in a conversation (linked to its message).
  conversationId      String?
  conversation        Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId           String?
  message             Message?           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Bookkeeping: a receipt / invoice attached to a transaction.
  transactionId       String?
  transaction         Transaction?       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploadedById        String?
  uploadedBy          User?              @relation(fields: [uploadedById], references: [id])
  createdAt           DateTime           @default(now())

  signedPackages DocumentPackage[] @relation("PackageSignedFile")

  @@index([companyId, projectId])
  @@index([companyId, leadId])
  @@index([photoTemplateItemId])
  @@index([conversationId])
  @@index([messageId])
  @@index([transactionId])
  @@map("files")
